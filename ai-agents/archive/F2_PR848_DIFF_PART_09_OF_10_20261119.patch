+        SHOP,CAMP,EXPERIMENT,"Bearer signed-test")[0]==404
+    assert not any("feature2_private_" in url for _,url,_ in wire.calls)
+
+def test_private_audit_rejects_bad_signing_keys_and_arbitrary_table():
