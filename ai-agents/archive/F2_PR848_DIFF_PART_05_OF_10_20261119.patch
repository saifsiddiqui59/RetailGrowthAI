+                "private":True,"can_publish":False,"paid_calls":0}
+        except (ValueError,PermissionError,KeyError,TypeError):
+            return 404, {"error":"NOT_FOUND"}
+        except StorageUnavailable:
+            return 503, {"error":"PRIVATE_UPLOAD_UNAVAILABLE"}
