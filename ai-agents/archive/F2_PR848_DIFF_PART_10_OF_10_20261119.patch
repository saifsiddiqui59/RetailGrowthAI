+   can_dispatch_paid_motion:false,
+   requires_fresh_media_rights:true,requires_new_copy_fact_review:true}
+ const cases=[
+   {proposal:{...draftProposal,source_revision:'7'},
+     receipt:{...receipt,source_revision:'7',revision:'71'}},
