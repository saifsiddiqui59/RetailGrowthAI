diff --git a/tests/media/test_feature4_edit_execution.py b/tests/media/test_feature4_edit_execution.py
--- a/tests/media/test_feature4_edit_execution.py
+++ b/tests/media/test_feature4_edit_execution.py
@@ -0,0 +1,193 @@
+"""F4-15 trusted AI edit execution: CPU-only, synthetic approval fixtures.
+
+These tests do NOT run AI, certify a real commercial video or authenticate a
+hosted Azure request. Feature #7 must supply independently verified decisions.
+"""
+import copy
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+
+from creative_contract import CreativeContractError, render_inputs
+from feature4_edit_execution import (
+    draft_fingerprint, edit_decision_fingerprint, execute_approved_edit,
+)
+from test_feature4_intent_compiler import pair, OTHER
+
+
+def reviewed_pair():
+    draft, trusted = pair()
+    trusted["edit_plan"] = {
+        "source_feature": "feature7", "approved": True,
+        "approval_id": "approved-feature7-timeline-001",
+        "timeline_version": "creative_reel_v1",
+    }
+    edits = {
+        **trusted["edit_plan"],
+        "shop_id": trusted["shop_id"],
+        "campaign_id": trusted["campaign_id"],
+        "draft_sha256": draft_fingerprint(draft),
+        "scenes": [
+            {"source_scene_index": 1, "duration": 9,
+             "trim_start": 1.5, "mute_source": False,
+             "transition": "cut", "animation_preset": "fade"},
+            {"source_scene_index": 0, "duration": 11,
+             "animation_preset": "slide", "transition": "fade"},
+            {"source_scene_index": 2, "duration": 10,
+             "animation_preset": "pop", "transition": "cut"},
+        ],
+    }
+    trusted["edit_decision_sha256"] = edit_decision_fingerprint(edits)
+    return draft, trusted, edits
+
+
+class TrustedEditExecutionTests(unittest.TestCase):
+    def test_real_renderer_plan_receives_approved_cut_order_and_timing(self):
+        draft, trusted, edits = reviewed_pair()
+        original = copy.deepcopy(draft)
+        result = execute_approved_edit(draft, trusted, edits)
+        request = result["request"]
+        self.assertEqual([s["asset_id"] for s in request["scenes"]],
+                         ["motionwalk", "photokurti", "photokurti"])
+        self.assertEqual([s["start_time"] for s in request["scenes"]], [0, 9, 20])
+        self.assertEqual([s["duration"] for s in request["scenes"]], [9, 11, 10])
+        self.assertEqual(request["scenes"][0]["trim_start"], 1.5)
+        self.assertEqual(request["scenes"][0]["transition"], "cut")
+        self.assertFalse(request["scenes"][0]["mute_source"])
+        self.assertEqual(request["scenes"][1]["animation_preset"], "slide")
+        self.assertEqual(request["scenes"][2]["text_overlay"], "20% OFF")
+        self.assertEqual(request["script"]["cta"], "Visit Our Store")
+        self.assertEqual(request["edit_plan"], trusted["edit_plan"])
+        self.assertNotIn("edit_decision_sha256", request)
+        self.assertEqual(
+            trusted["edit_decision_sha256"], edit_decision_fingerprint(edits))
+        self.assertEqual(result["lineage"]["source_edit_approval"],
+                         "approved-feature7-timeline-001")
+        lowered = render_inputs(request, result["manifest"])
+        self.assertEqual(lowered.audit, result["lineage"])
+        self.assertEqual([s["start"] for s in lowered.plan["scenes"]], [0, 9, 20])
+        self.assertEqual([s["duration"] for s in lowered.plan["scenes"]], [9, 11, 10])
+        self.assertEqual([s["asset_id"] for s in lowered.plan["scenes"]],
+                         ["motionwalk", "photokurti", "photokurti"])
+        self.assertEqual(lowered.plan["scenes"][0]["transition"], "cut")
+        self.assertEqual(lowered.plan["scenes"][0]["trim_start"], 1.5)
+        self.assertEqual(draft, original, "original reviewed draft must remain immutable")
+        self.assertEqual(set(result["manifest"]["assets"]),
+                         {"photokurti", "motionwalk", "saleposter",
+                          "musicowned", "storelogo"})
+
+    def test_unapproved_or_foreign_editor_receipt_fails_closed(self):
+        cases = [
+            ("wrong feature", lambda d,s,e: e.update(source_feature="feature5")),
+            ("unsigned decision", lambda d,s,e: e.update(approved=False)),
+            ("wrong contract", lambda d,s,e: e.update(timeline_version="html")),
+            ("foreign shop", lambda d,s,e: e.update(shop_id=OTHER)),
+            ("foreign campaign", lambda d,s,e: e.update(campaign_id=OTHER)),
+            ("foreign draft", lambda d,s,e: d.update(shop_id=OTHER)),
+            ("forged reviewer", lambda d,s,e: e.update(approval_id="new-reviewer")),
+            ("revoked reviewer", lambda d,s,e: s["edit_plan"].update(approved=False)),
+            ("missing review", lambda d,s,e: s.pop("edit_plan")),
+            ("invalid sha", lambda d,s,e: e.update(draft_sha256="abc")),
+            ("stale sha", lambda d,s,e: e.update(draft_sha256="f" * 64)),
+            ("missing persisted decision", lambda d,s,e: s.pop("edit_decision_sha256")),
+            ("forged persisted decision", lambda d,s,e: s.update(edit_decision_sha256="f" * 64)),
+            ("reordered without reapproval", lambda d,s,e: e["scenes"].reverse()),
+            ("altered trim without reapproval", lambda d,s,e: e["scenes"][0].update(trim_start=2.5)),
+            ("altered duration without reapproval", lambda d,s,e: e["scenes"][0].update(duration=8)),
+            ("unknown instruction", lambda d,s,e: e.update(shell="rm -rf /")),
+            ("source changed", lambda d,s,e: d["scenes"][1].update(asset_id="another")),
+        ]
+        for name, change in cases:
+            draft, trusted, edits = reviewed_pair()
+            change(draft, trusted, edits)
+            with self.subTest(name=name), self.assertRaises(CreativeContractError):
+                execute_approved_edit(draft, trusted, edits)
+
+    def test_approved_review_digest_covers_every_edit_and_is_not_renderer_metadata(self):
+        draft, trusted, edits = reviewed_pair()
+        original_snapshot = copy.deepcopy(trusted)
+        first = execute_approved_edit(draft, trusted, edits)
+        self.assertEqual(trusted, original_snapshot)
+        self.assertNotIn("edit_decision_sha256", first["request"]["edit_plan"])
+
+        # An independently reviewed *new* trim is allowed when the persisted
+        # server receipt is replaced; merely replaying the old ID is not.
+        edits["scenes"][0]["trim_start"] = 2.5
+        with self.assertRaisesRegex(CreativeContractError, "persisted review"):
+            execute_approved_edit(draft, trusted, edits)
+        trusted["edit_decision_sha256"] = edit_decision_fingerprint(edits)
+        revised = execute_approved_edit(draft, trusted, edits)
+        self.assertEqual(revised["request"]["scenes"][0]["trim_start"], 2.5)
+
+    def test_review_digest_is_key_order_stable_but_rejects_nested_replay(self):
+        draft, trusted, edits = reviewed_pair()
+        reordered = dict(reversed(list(edits.items())))
+        self.assertEqual(edit_decision_fingerprint(edits),
+                         edit_decision_fingerprint(reordered))
+        self.assertEqual(execute_approved_edit(draft, trusted, reordered)["request"]["scenes"][0]["duration"], 9)
+
+        # An unchanged outer approval ID must not authorize a modified nested
+        # transition, even if the remaining decision fields are identical.
+        replay = copy.deepcopy(edits)
+        replay["scenes"][0]["transition"] = "fade"
+        with self.assertRaisesRegex(CreativeContractError, "persisted review"):
+            execute_approved_edit(draft, trusted, replay)
+
+    def test_invalid_or_dangerous_edit_commands_fail_closed(self):
+        cases = [
+            ("duplicate index", lambda e: e["scenes"][1].update(source_scene_index=1)),
+            ("index string", lambda e: e["scenes"][1].update(source_scene_index="0")),
+            ("missing scene", lambda e: e["scenes"].pop()),
+            ("extra scene", lambda e: e["scenes"].append(copy.deepcopy(e["scenes"][0]))),
+            ("negative", lambda e: e["scenes"][0].update(duration=-1)),
+            ("nan", lambda e: e["scenes"][0].update(duration=float("nan"))),
+            ("boolean duration", lambda e: e["scenes"][0].update(duration=True)),
+            ("short timeline", lambda e: e["scenes"][0].update(duration=8)),
+            ("invalid animation", lambda e: e["scenes"][0].update(animation_preset="eval")),
+            ("invalid transition", lambda e: e["scenes"][0].update(transition="<script>")),
+            ("unknown field", lambda e: e["scenes"][0].update(asset_id="fake")),
+            ("negative trim", lambda e: e["scenes"][0].update(trim_start=-1)),
+            ("infinite trim", lambda e: e["scenes"][0].update(trim_start=float("inf"))),
+            ("audio string", lambda e: e["scenes"][0].update(mute_source="false")),
+        ]
+        for name, change in cases:
+            draft, trusted, edits = reviewed_pair()
+            change(edits)
+            # Independently persisted approval can be validly bound to a
+            # malformed decision; still test downstream schema rejection.
+            with self.subTest(name=name), self.assertRaises(CreativeContractError):
+                trusted["edit_decision_sha256"] = edit_decision_fingerprint(edits)
+                execute_approved_edit(draft, trusted, edits)
+
+    def test_existing_compiler_rejects_retimed_image_trim_or_forged_offer(self):
+        draft, trusted, edits = reviewed_pair()
+        edits["scenes"][1]["trim_start"] = 2
+        trusted["edit_decision_sha256"] = edit_decision_fingerprint(edits)
+        with self.assertRaisesRegex(CreativeContractError, "Trimming requires"):
+            execute_approved_edit(draft, trusted, edits)
+
+        draft, trusted, edits = reviewed_pair()
+        draft["scenes"][2]["offer"] = "95% OFF"
+        edits["draft_sha256"] = draft_fingerprint(draft)
+        trusted["edit_decision_sha256"] = edit_decision_fingerprint(edits)
+        with self.assertRaisesRegex(CreativeContractError, "Unreviewed promotional offer"):
+            execute_approved_edit(draft, trusted, edits)
+
+    def test_existing_compiler_rechecks_private_media_tenant_and_rights(self):
+        for name, change in [
+            ("foreign motion", lambda s: s["assets"]["motionwalk"].update(shop_id=OTHER)),
+            ("revoked clip", lambda s: s["assets"]["motionwalk"].update(approved=False)),
+            ("unlicensed music", lambda s: s["assets"]["musicowned"].update(license_name="unknown")),
+            ("public storage", lambda s: s["assets"]["photokurti"].update(storage_bucket="public")),
+        ]:
+            draft, trusted, edits = reviewed_pair()
+            change(trusted)
+            with self.subTest(name=name), self.assertRaises(CreativeContractError):
+                execute_approved_edit(draft, trusted, edits)
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_edited_export_qa.py b/tests/media/test_feature4_edited_export_qa.py
--- a/tests/media/test_feature4_edited_export_qa.py
+++ b/tests/media/test_feature4_edited_export_qa.py
@@ -0,0 +1,186 @@
+"""Bounded 30s encoded mock editor parity and untrusted-source negatives."""
+import hashlib
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_edited_export_qa import EditorExportProofError, verify_mock_editor_output
+import feature4_edited_export_qa as qa
+
+
+class EncodedEditorParityTests(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory(prefix="f4-edit-parity-")
+        self.addCleanup(temp.cleanup)
+        self.root = Path(temp.name)
+        self.file = self.root / "mock-only.mp4"
+        self.file.write_bytes(b"encoded-mock-packets" * 200)
+        self.profile = {"width": 540, "height": 960, "seconds": 30.0}
+        self.valid = (bytes([20])*9216, bytes([70])*9216,
+                      bytes([24])*9216, bytes([120])*9216)
+        # Source fixture-only split editor motion and near-cut probes.
+        self.split_probes = (bytes([21])*9216, bytes([25])*9216,
+                             bytes([70])*9216, bytes([70])*9216,
+                             bytes([24])*9216, bytes([120])*9216)
+
+    def prove(self, frames=None, *, motion=None, boundary=None):
+        decoded = list(self.valid if frames is None else frames)
+        decoded += list(self.split_probes[:2] if motion is None else motion)
+        decoded += list(self.split_probes[2:] if boundary is None else boundary)
+        with patch.object(qa, "inspect_mp4", return_value=self.profile), \
+             patch.object(qa, "_frame", side_effect=decoded):
+            return verify_mock_editor_output(
+                self.file,
+                expected_sha256=hashlib.sha256(self.file.read_bytes()).hexdigest())
+
+    def test_valid_decoded_pattern_is_source_sha_bound_not_product_approval(self):
+        proof = self.prove()
+        self.assertEqual(proof["timeline_starts_seconds"], [0, 4, 14, 20])
+        self.assertEqual(proof["source_sha256"],
+                         hashlib.sha256(self.file.read_bytes()).hexdigest())
+        self.assertFalse(proof["exact_inpoint_frame_verified"])
+        self.assertEqual(proof["first_video_encoded_motion_delta"], 1)
+        self.assertEqual(proof["trimmed_video_encoded_motion_delta"], 1)
+        self.assertTrue(proof["boundary_scene_family_verified"])
+        self.assertFalse(proof["exact_transition_frame_verified"])
+        self.assertFalse(proof["human_visual_approval"])
+        self.assertFalse(proof["commercial_release_eligible"])
+
+    def test_replayed_video_or_wrong_scene_order_denied(self):
+        v1, p1, v2, p2 = self.valid
+        for frames in ((v1,p1,v1,p2), (p1,v1,v2,p2),
+                       (v1,p1,p2,p2), (v1,v1,v2,p2), (v1,p1,v2,p1)):
+            with self.subTest(variant=frames[:1]), \
+                 self.assertRaises(EditorExportProofError):
+                self.prove(frames)
+
+    def test_malformed_decoded_frames_cannot_pass_pixel_parity(self):
+        # Original F4-04 #723 negative cases, retained alongside duplicate QA.
+        v1, p1, v2, p2 = self.valid
+        for name, frames in (
+            ("truncated-first-video", (v1[:-1], p1, v2, p2)),
+            ("oversized-product-frame", (v1, p1 + b"\x00", v2, p2)),
+            ("wrong-decoder-type", (v1, p1, bytearray(v2), p2)),
+            ("empty-frame", (v1, p1, b"", p2)),
+        ):
+            with self.subTest(case=name), self.assertRaisesRegex(
+                    EditorExportProofError, "Malformed encoded editor grayscale frame"):
+                self.prove(frames)
+
+    def test_frozen_source_video_segments_are_denied(self):
+        first, photo, trimmed, offer = self.valid
+        moving_first, moving_trimmed = self.split_probes[:2]
+        for motion in ((first, moving_trimmed), (moving_first, trimmed), (first, trimmed)):
+            with self.subTest(motion=motion[0][0]), self.assertRaisesRegex(
+                    EditorExportProofError, "order/inpoint"):
+                self.prove(motion=motion)
+
+    def test_delayed_or_replaced_cut_boundary_frames_denied(self):
+        video, product, trimmed, offer = self.valid
+        for name, probes in (
+            ("first photo starts late", (video, product, trimmed, offer)),
+            ("first photo ends early", (product, offer, trimmed, offer)),
+            ("second video starts late", (product, product, product, offer)),
+            ("offer starts late", (product, product, trimmed, product)),
+        ):
+            with self.subTest(name=name), self.assertRaisesRegex(
+                    EditorExportProofError, "order/inpoint"):
+                self.prove(boundary=probes)
+
+    def test_mutated_input_and_wrong_duration_denied(self):
+        frames = list(self.valid) + list(self.split_probes)
+        def decode(src, at):
+            if at == 2.0:
+                with self.file.open("ab") as handle:
+                    handle.write(b"tamper")
+            return frames.pop(0)
+        with patch.object(qa, "inspect_mp4", return_value=self.profile), \
+             patch.object(qa, "_frame", side_effect=decode):
+            with self.assertRaisesRegex(EditorExportProofError, "changed"):
+                verify_mock_editor_output(
+                    self.file, expected_sha256=hashlib.sha256(self.file.read_bytes()).hexdigest())
+        self.profile["seconds"] = 29.0
+        with self.assertRaisesRegex(EditorExportProofError, "30s"):
+            self.prove()
+
+    def test_same_byte_atomic_inode_swap_during_probe_is_denied(self):
+        original = self.file.read_bytes()
+
+        def swap_during_probe(*_args, **_kwargs):
+            replacement = self.root / "new-identity.mp4"
+            replacement.write_bytes(original)
+            replacement.replace(self.file)
+            return self.profile
+
+        with patch.object(qa, "inspect_mp4", side_effect=swap_during_probe), \
+             patch.object(qa, "_frame", side_effect=list(self.valid)):
+            with self.assertRaisesRegex(EditorExportProofError, "changed"):
+                verify_mock_editor_output(
+                    self.file, expected_sha256=hashlib.sha256(self.file.read_bytes()).hexdigest())
+
+    def test_same_byte_atomic_inode_swap_during_decoding_is_denied(self):
+        frames = list(self.valid) + list(self.split_probes)
+        original = self.file.read_bytes()
+
+        def decode(_source, at):
+            if at == 16.0:
+                replacement = self.root / "new-identity.mp4"
+                replacement.write_bytes(original)
+                replacement.replace(self.file)
+            return frames.pop(0)
+
+        with patch.object(qa, "inspect_mp4", return_value=self.profile), \
+             patch.object(qa, "_frame", side_effect=decode):
+            with self.assertRaisesRegex(EditorExportProofError, "changed"):
+                verify_mock_editor_output(
+                    self.file, expected_sha256=hashlib.sha256(self.file.read_bytes()).hexdigest())
+
+    def test_oversized_mp4_is_denied_before_media_probe(self):
+        with self.file.open("wb") as source:
+            source.truncate(80 * 1024 * 1024 + 1)
+        with patch.object(qa, "inspect_mp4") as probe:
+            with self.assertRaisesRegex(EditorExportProofError, "size/type"):
+                verify_mock_editor_output(
+                    self.file, expected_sha256=hashlib.sha256(self.file.read_bytes()).hexdigest())
+        probe.assert_not_called()
+
+    def test_render_sha_is_required_before_any_decoder(self):
+        digest = hashlib.sha256(self.file.read_bytes()).hexdigest()
+        for wrong in (None, "", digest.upper(), "g" * 64, "0" * 64, True):
+            with self.subTest(expected=wrong):
+                with patch.object(qa, "inspect_mp4") as probe, \
+                     patch.object(qa, "_frame") as frame:
+                    with self.assertRaisesRegex(
+                        EditorExportProofError, "SHA256|rendered source SHA"
+                    ):
+                        verify_mock_editor_output(self.file, expected_sha256=wrong)
+                    probe.assert_not_called()
+                    frame.assert_not_called()
+
+    def test_replaced_mp4_before_qa_fails_when_same_profile(self):
+        first_sha = hashlib.sha256(self.file.read_bytes()).hexdigest()
+        self.file.write_bytes(b"different-encoded-output" * 200)
+        with patch.object(qa, "inspect_mp4") as probe, \
+             patch.object(qa, "_frame") as frame:
+            with self.assertRaisesRegex(EditorExportProofError, "rendered source SHA"):
+                verify_mock_editor_output(self.file, expected_sha256=first_sha)
+            probe.assert_not_called()
+            frame.assert_not_called()
+
+    def test_nonvideo_and_symlink_source_denied(self):
+        expected = hashlib.sha256(self.file.read_bytes()).hexdigest()
+        with self.assertRaises(EditorExportProofError):
+            verify_mock_editor_output(self.file, expected_sha256=expected)
+        backing = self.root / "real-mock.mp4"
+        self.file.rename(backing)
+        self.file.symlink_to(backing)
+        with self.assertRaises(EditorExportProofError):
+            verify_mock_editor_output(self.file, expected_sha256=expected)
+
+
+if __name__ == "__main__":
+    unittest.main()

