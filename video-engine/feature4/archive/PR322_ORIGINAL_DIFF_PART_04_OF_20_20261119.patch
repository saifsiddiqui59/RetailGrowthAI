diff --git a/tests/media/test_feature4_caption_readability.py b/tests/media/test_feature4_caption_readability.py
--- a/tests/media/test_feature4_caption_readability.py
+++ b/tests/media/test_feature4_caption_readability.py
@@ -0,0 +1,59 @@
+"""F4-12: caption density warnings are NOT actual visual/voice approval."""
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "video-engine"))
+from feature4_subtitles import (  # noqa: E402
+    SubtitleExportError, caption_readability_flags, export_private_subtitle_pair,
+)
+
+
+class CaptionReadabilityTests(unittest.TestCase):
+    def test_concise_reviewed_cue_has_no_heuristic_warning(self):
+        cues = [{"start": 1.0, "duration": 3.0, "text": "New arrivals"}]
+        self.assertEqual(caption_readability_flags(cues, duration_seconds=15), [])
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            report = export_private_subtitle_pair(
+                cues, duration_seconds=15,
+                srt_path=root / "captions.srt", vtt_path=root / "captions.vtt")
+            self.assertFalse(report["caption_layout_review_required"])
+            self.assertEqual(report["caption_layout_risks"], [])
+            self.assertFalse(report["encoded_text_legibility_verified_here"])
+            self.assertFalse(report["human_visual_approval"])
+
+    def test_fast_three_line_cue_requires_real_visual_review_without_rewriting(self):
+        text = "A carefully selected collection of seasonal pieces for every special celebration"
+        cues = [{"start": 2.0, "duration": 1.0, "text": text}]
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            report = export_private_subtitle_pair(
+                cues, duration_seconds=15,
+                srt_path=root / "review.srt", vtt_path=root / "review.vtt")
+            self.assertTrue(report["caption_layout_review_required"])
+            codes = report["caption_layout_risks"][0]["codes"]
+            self.assertIn("FAST_CAPTION_OVER_20_CHARS_PER_SECOND", codes)
+            self.assertIn("OVER_TWO_MOBILE_LINES", codes)
+            self.assertIn(text, (root / "review.srt").read_text())
+            self.assertFalse(report["human_visual_approval"])
+
+    def test_unbroken_word_warning_does_not_claim_visual_failure(self):
+        cue = [{"start": 0, "duration": 3.0, "text": "a" * 40}]
+        self.assertEqual(caption_readability_flags(cue, duration_seconds=15), [
+            {"cue_index": 1, "codes": ["UNBROKEN_TOKEN_OVER_36"]}])
+
+    def test_unapproved_or_invalid_cues_are_rejected_before_output(self):
+        for cue in ([{"start": 0, "duration": 3, "text": "<unapproved>"}],
+                    [{"start": 14.8, "duration": 2, "text": "Beyond Reel"}]):
+            with tempfile.TemporaryDirectory() as directory:
+                root = Path(directory)
+                with self.assertRaises(SubtitleExportError):
+                    export_private_subtitle_pair(cue, duration_seconds=15,
+                        srt_path=root / "review.srt", vtt_path=root / "review.vtt")
+                self.assertEqual(list(root.iterdir()), [])
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_captioned_minute_receipt.py b/tests/media/test_feature4_captioned_minute_receipt.py
--- a/tests/media/test_feature4_captioned_minute_receipt.py
+++ b/tests/media/test_feature4_captioned_minute_receipt.py
@@ -0,0 +1,149 @@
+"""Fail-closed SHA-linked 60s editorial caption handoff (no auth/publishing claims)."""
+import hashlib
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT=Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(ROOT/"video-engine"))
+from feature4_minute_quality_receipt import (
+    MinuteProofError, validate_captioned_review, validate_minute_evidence
+)
+from feature4_subtitles import compose_approved_subtitles
+
+
+def sha(contents):
+    return hashlib.sha256(contents).hexdigest()
+
+
+class CaptionedMinuteReceiptTests(unittest.TestCase):
+    def setUp(self):
+        ctx=tempfile.TemporaryDirectory()
+        self.addCleanup(ctx.cleanup)
+        self.root=Path(ctx.name)
+        self.preview=self.root/"approved-preview.mp4"
+        self.captioned=self.root/"captioned.mp4"
+        self.caption_srt=self.root/"titles.srt"
+        self.caption_vtt=self.root/"titles.vtt"
+        self.provenance=self.root/"provenance.json"
+        self.caption_proof=self.root/"proof.json"
+        self.preview.write_bytes(b"original-private-reviewed-video"*100)
+        self.captioned.write_bytes(b"distinct-captioned-review-mp4"*100)
+        self.cues=[{"start":float(i*5),"duration":3.0,
+                    "text":f"Original editorial scene {i+1}"}
+                   for i in range(12)]
+        srt,vtt=compose_approved_subtitles(self.cues,duration_seconds=60)
+        self.caption_srt.write_text(srt,encoding="utf-8")
+        self.caption_vtt.write_text(vtt,encoding="utf-8")
+        self.prov={
+            "editorial_subtitle_kind":"EDITORIAL_TEST_TITLES_NOT_SPOKEN_AUDIO",
+            "actual_spoken_voiceover":False,
+            "editorial_subtitle_cues":self.cues,
+            "synced_scene_starts":[c["start"] for c in self.cues],
+        }
+        self.proof={
+            "status":"PRIVATE_ENCODED_SUBTITLES_NOT_PUBLISHED",
+            "source_sha256":sha(self.preview.read_bytes()),
+            "reviewed_srt_sha256":sha(self.caption_srt.read_bytes()),
+            "captioned_mp4_sha256":sha(self.captioned.read_bytes()),
+            "cue_count":12,"duration_seconds":60,
+            "width":540,"height":960,
+            "video_codec":"h264","audio_codec":"aac",
+            "actual_encoded_subtitle_filter_executed":True,
+            "spoken_word_alignment_verified":False,
+            "human_visual_approval":False,
+            "commercial_release_eligible":False,
+            "signed_download_ready":False,
+            "tenant_rights_checked_here":False,
+        }
+        self.persist()
+
+    def persist(self):
+        self.provenance.write_text(json.dumps(self.prov),encoding="utf-8")
+        self.caption_proof.write_text(json.dumps(self.proof),encoding="utf-8")
+
+    def validate(self):
+        with patch("feature4_minute_quality_receipt.inspect_mp4",return_value={
+            "seconds":60.025,"width":540,"height":960,
+            "bytes":len(self.captioned.read_bytes())}):
+            return validate_captioned_review(
+                preview=self.preview,provenance=self.provenance,
+                captioned=self.captioned,caption_srt=self.caption_srt,
+                caption_vtt=self.caption_vtt,caption_proof=self.caption_proof)
+
+    def test_sha_linked_captioned_derivative_and_zero_approval(self):
+        result=self.validate()
+        self.assertEqual(result["status"],"CAPTIONED_60S_TECHNICAL_PROOF_ONLY")
+        self.assertEqual(result["cue_count"],12)
+        self.assertEqual(result["editorial_srt_sha256"],sha(self.caption_srt.read_bytes()))
+        self.assertFalse(result["commercial_release_eligible"])
+        self.assertFalse(result["tenant_rights_checked_here"])
+
+    def test_altered_srt_vtt_and_stale_render_hash_denied(self):
+        for file in (self.caption_srt,self.caption_vtt,self.captioned,self.preview):
+            with self.subTest(file=file):
+                old=file.read_bytes()
+                file.write_bytes(old+b"tampered")
+                with self.assertRaises(MinuteProofError):
+                    self.validate()
+                file.write_bytes(old)
+
+    def test_reordered_cues_spoken_claim_and_false_rights_approval_denied(self):
+        self.prov["synced_scene_starts"][1]=8.0
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.validate()
+        self.prov["synced_scene_starts"][1]=5.0
+        self.prov["actual_spoken_voiceover"]=True
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.validate()
+        self.prov["actual_spoken_voiceover"]=False
+        for flag in ("signed_download_ready","human_visual_approval",
+                     "tenant_rights_checked_here","spoken_word_alignment_verified"):
+            self.proof[flag]=True
+            self.persist()
+            with self.subTest(flag=flag),self.assertRaises(MinuteProofError):
+                self.validate()
+            self.proof[flag]=False
+
+    def test_missing_and_unreviewed_cues_denied(self):
+        self.prov["editorial_subtitle_cues"]=self.cues[:11]
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.validate()
+        self.prov["editorial_subtitle_cues"]=self.cues
+        self.prov["editorial_subtitle_kind"]="APPROVED_HUMAN_WORDS"
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.validate()
+
+    def test_symlinked_sidecars_denied(self):
+        actual=self.root/"real.srt"
+        self.caption_srt.rename(actual)
+        self.caption_srt.symlink_to(actual)
+        with self.assertRaises(MinuteProofError):
+            self.validate()
+
+    def test_partial_captioned_chain_never_silently_skipped(self):
+        # Invalid main media would fail anyway, but a partial optional receipt
+        # must be rejected explicitly, not treated as "no captions" success.
+        module=__import__("feature4_minute_quality_receipt")
+        with patch.object(module,"_sha",return_value="f"*64),\
+             patch.object(module,"_record",return_value={}),\
+             patch.object(module,"inspect_mp4",return_value={
+                 "seconds":60,"width":1080,"height":1920}):
+            with self.assertRaises(MinuteProofError):
+                validate_minute_evidence(
+                    original=self.preview,master=self.preview,preview=self.preview,
+                    provenance=self.provenance,motion=self.caption_proof,
+                    master_proof=self.caption_proof,preview_proof=self.caption_proof,
+                    contact_image=self.caption_srt,contact_proof=self.caption_proof,
+                    captioned=self.captioned)
+
+
+if __name__=="__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_cpu_matrix.py b/tests/media/test_feature4_cpu_matrix.py
--- a/tests/media/test_feature4_cpu_matrix.py
+++ b/tests/media/test_feature4_cpu_matrix.py
@@ -0,0 +1,135 @@
+"""F4-14 proof-only matrix checks; every media probe is mocked (not a real encode)."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_cpu_matrix import aggregate_cpu_matrix, CpuMatrixError
+
+
+HEAD = "b" * 40
+
+
+class CpuMatrixTests(unittest.TestCase):
+    def setUp(self):
+        ctx = tempfile.TemporaryDirectory(prefix="f4-cpu-envelope-")
+        self.addCleanup(ctx.cleanup)
+        self.root = Path(ctx.name)
+        self.manifest = {
+            "schema": "feature4_cpu_matrix_inputs_v1",
+            "source_commit": HEAD, "renders": []
+        }
+        for duration in (15, 30, 60):
+            media = bytes([duration]) * 5000
+            sha = hashlib.sha256(media).hexdigest()
+            (self.root / f"clip-{duration}.mp4").write_bytes(media)
+            row = {"seconds": duration, "path": f"clip-{duration}.mp4",
+                   "sha256": sha, "benchmark": f"clip-{duration}.json"}
+            self.manifest["renders"].append(row)
+            data = {
+                "kind": "OFFLINE_SYNTHETIC_HYPERFRAMES_CPU_BENCHMARK_NOT_AZURE",
+                "source_commit_claim": HEAD,
+                "output_sha256": sha,
+                "output_bytes": len(media),
+                "output_hash_type": "SHA256_STABLE_LOCAL_REGULAR_FILE_ONLY",
+                "duration_seconds": duration, "width": 1080, "height": 1920,
+                "fps": 24, "cloud_or_gpu_inference": False,
+                "measured_on_azure_functions": False,
+                "commercial_visual_quality_accepted": False,
+                "azure_runtime_memory_verified": False, "azure_cost_inr": None,
+                "wall_seconds": duration * 2.0,
+                "max_sampled_process_tree_rss_bytes": duration * 1000000,
+                "max_sampled_cpu_seconds_lower_bound": duration * .8,
+                "sampling_interval_seconds": .2,
+                "samples": 40, "max_observed_process_count": 2,
+            }
+            (self.root / row["benchmark"]).write_text(json.dumps(data), encoding="utf-8")
+
+    def _check(self):
+        def probe(path, *, duration, width, height, fps):
+            self.assertEqual((width, height, fps), (1080, 1920, 24))
+            self.assertEqual(path.name, f"clip-{duration}.mp4")
+            return {"bytes": path.stat().st_size, "duration_seconds": duration}
+        with patch("feature4_export_matrix.verify_mp4", side_effect=probe):
+            return aggregate_cpu_matrix(self.manifest, self.root, expected_head=HEAD)
+
+    def _edit_receipt(self, seconds, key, value):
+        p = self.root / f"clip-{seconds}.json"
+        record = json.loads(p.read_text())
+        record[key] = value
+        p.write_text(json.dumps(record))
+
+    def test_three_lengths_sha_tied_without_false_cloud_acceptance(self):
+        result = self._check()
+        self.assertEqual([r["seconds"] for r in result["renders"]], [15, 30, 60])
+        self.assertEqual(result["max_measured_wall_seconds"], 120)
+        self.assertEqual(result["max_sampled_rss_bytes_lower_bound"], 60000000)
+        self.assertFalse(result["cloud_budget_accepted"])
+        self.assertFalse(result["code_commit_attested_by_ci"])
+        self.assertFalse(result["commercial_release_eligible"])
+
+    def test_missing_duplicate_head_and_path_escape_fail_closed(self):
+        self.manifest["source_commit"] = "a" * 40
+        with self.assertRaises(CpuMatrixError):
+            self._check()
+        self.manifest["source_commit"] = HEAD
+        self.manifest["renders"][2]["seconds"] = 30
+        with self.assertRaises(CpuMatrixError):
+            self._check()
+        self.manifest["renders"][2]["seconds"] = 60
+        self.manifest["renders"][0]["benchmark"] = "../another-tenant.json"
+        with self.assertRaises(CpuMatrixError):
+            self._check()
+
+    def test_encoded_source_mutation_cannot_pass_even_with_receipt(self):
+        target = self.root / "clip-15.mp4"
+        target.write_bytes(target.read_bytes() + b"unapproved")
+        with self.assertRaisesRegex(CpuMatrixError, "encoded MP4"):
+            self._check()
+
+    def test_forged_sha_budget_or_bool_as_int_rejected(self):
+        for key, value in (
+            ("source_commit_claim", "0" * 40),
+            ("output_sha256", "f" * 64),
+            ("output_bytes", 4),
+            ("cloud_or_gpu_inference", True),
+            ("measured_on_azure_functions", True),
+            ("commercial_visual_quality_accepted", True),
+            ("azure_runtime_memory_verified", True),
+            ("azure_cost_inr", 100),
+            ("wall_seconds", float("nan")),
+            ("max_sampled_process_tree_rss_bytes", -3),
+            ("max_sampled_cpu_seconds_lower_bound", 0),
+            ("samples", True),
+            ("max_observed_process_count", 0),
+            ("output_hash_type", "not-original"),
+        ):
+            with self.subTest(key=key):
+                path = self.root / "clip-30.json"
+                original = path.read_text()
+                self._edit_receipt(30, key, value)
+                with self.assertRaises(CpuMatrixError):
+                    self._check()
+                path.write_text(original)
+
+    def test_missing_symlinked_or_oversized_json_not_read(self):
+        receipt = self.root / "clip-30.json"
+        receipt.unlink()
+        receipt.symlink_to(self.root / "clip-15.json")
+        with self.assertRaises(CpuMatrixError):
+            self._check()
+        receipt.unlink()
+        receipt.write_bytes(b"x" * 65536)
+        with self.assertRaises(CpuMatrixError):
+            self._check()
+
+
+if __name__ == "__main__":
+    unittest.main()

