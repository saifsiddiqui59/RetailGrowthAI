--- a/tests/media/test_feature4_endcard_receipt.py
+++ b/tests/media/test_feature4_endcard_receipt.py
@@ -0,0 +1,102 @@
+"""SHA-linked source-only encoded endcard receipt; explicitly not commercial QA."""
+import hashlib
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(ROOT/"video-engine"))
+from feature4_minute_quality_receipt import (
+    MinuteProofError, validate_endcard_evidence)
+
+
+class EndcardReceiptTests(unittest.TestCase):
+    def setUp(self):
+        context=tempfile.TemporaryDirectory(prefix="f4-endcard-receipt-")
+        self.addCleanup(context.cleanup)
+        self.root=Path(context.name)
+        self.original=self.root/"real.mp4"
+        self.source=self.root/"provenance.json"
+        self.proof=self.root/"endcard-proof.json"
+        self.original.write_bytes(b"sha-pinned-real-encoded-test-bytes"*100)
+        self.p={"scene_windows":[{"start":i*5.0,"duration":5.0}
+                                 for i in range(12)]}
+        self.e={
+            "schema":"feature4_stock_endcard_pixel_v1",
+            "status":"ENCODED_OUTRO_VISUALLY_CHANGED_NOT_TEXT_APPROVAL",
+            "source_sha256":hashlib.sha256(self.original.read_bytes()).hexdigest(),
+            "duration_seconds":60,"outro_start_seconds":55.0,
+            "pre_outro_sample_seconds":53.0,
+            "outro_sample_seconds":57.5,"outro_tail_sample_seconds":59.3,
+            "scene_delta_mean_luma":60.0,
+            "outro_stability_delta_mean_luma":.01,
+            "commercial_release_eligible":False,
+            "human_visual_approval":False,"retailer_garment_verified":False,
+            "text_legibility_verified":False,
+            "spoken_caption_sync_verified":False}
+        self.persist()
+
+    def persist(self):
+        self.source.write_text(json.dumps(self.p))
+        self.proof.write_text(json.dumps(self.e))
+
+    def verify(self):
+        return validate_endcard_evidence(original=self.original,
+                                         provenance=self.source,
+                                         endcard_proof=self.proof)
+
+    def test_source_linked_noncommercial_report(self):
+        report=self.verify()
+        self.assertEqual(report["status"],"ENCODED_STOCK_OUTRO_CHANGED_NOT_AD_APPROVAL")
+        self.assertEqual(report["scene_delta_mean_luma"],60.0)
+        self.assertFalse(report["commercial_release_eligible"])
+        self.assertFalse(report["text_legibility_verified"])
+
+    def test_tampered_encoded_bytes_or_missing_report_rejected(self):
+        self.original.write_bytes(self.original.read_bytes()+b"changed")
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+        self.original.write_bytes(b"sha-pinned-real-encoded-test-bytes"*100)
+        self.proof.unlink()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+
+    def test_forged_old_short_endcard_or_pixel_measures_rejected(self):
+        self.p["scene_windows"][-1]["start"]=58.0
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+        self.p["scene_windows"][-1]["start"]=55.0
+        for key,value in (
+            ("scene_delta_mean_luma",16.0),
+            ("outro_stability_delta_mean_luma",24.0),
+            ("scene_delta_mean_luma","large"),
+            ("outro_sample_seconds",52.5)):
+            original=self.e[key]
+            self.e[key]=value
+            self.persist()
+            with self.subTest(key=key),self.assertRaises(MinuteProofError):
+                self.verify()
+            self.e[key]=original
+
+    def test_forged_approval_flags_and_symlink_rejected(self):
+        for flag in ("commercial_release_eligible","human_visual_approval",
+                     "retailer_garment_verified","text_legibility_verified",
+                     "spoken_caption_sync_verified"):
+            self.e[flag]=True
+            self.persist()
+            with self.subTest(flag=flag),self.assertRaises(MinuteProofError):
+                self.verify()
+            self.e[flag]=False
+        self.persist()
+        real=self.root/"real-proof.json"
+        self.proof.rename(real)
+        self.proof.symlink_to(real)
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+
+
+if __name__=="__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_export_matrix.py b/tests/media/test_feature4_export_matrix.py
--- a/tests/media/test_feature4_export_matrix.py
+++ b/tests/media/test_feature4_export_matrix.py
@@ -0,0 +1,107 @@
+"""F4-03 local 15/30/60 immutable encoded matrix; source test doubles never claim real render."""
+from __future__ import annotations
+
+import hashlib
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_export_matrix import MatrixEvidenceError, verify_export_matrix
+
+
+HEAD = "a" * 40
+
+
+class OfflineExportMatrixTests(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory(prefix="f4-matrix-")
+        self.addCleanup(temp.cleanup)
+        self.root = Path(temp.name)
+        self.rows = []
+        for duration in (15, 30, 60):
+            name = f"synthetic-{duration}s.mp4"
+            data = bytes([duration]) * 4096
+            (self.root / name).write_bytes(data)
+            self.rows.append({"seconds": duration, "path": name,
+                              "sha256": hashlib.sha256(data).hexdigest()})
+        self.manifest = {"schema": "feature4_export_matrix_inputs_v1",
+                         "source_commit": HEAD, "renders": self.rows}
+
+    def proof(self):
+        def local_probe(path, *, duration, width, height, fps):
+            self.assertEqual((width, height, fps), (1080, 1920, 24))
+            self.assertTrue(path.name.endswith(f"{duration}s.mp4"))
+            return {"bytes": path.stat().st_size, "duration_seconds": duration,
+                    "width": width, "height": height, "fps": fps,
+                    "video_codec": "h264", "audio_codec": "aac"}
+        with patch("feature4_export_matrix.verify_mp4", side_effect=local_probe):
+            return verify_export_matrix(self.manifest, self.root, expected_head=HEAD)
+
+    def test_all_three_actual_filenames_sha_bound_without_release_approval(self):
+        result = self.proof()
+        self.assertEqual(result["status"],
+                         "ALL_THREE_LOCAL_ENCODED_PROFILES_TECHNICALLY_CHECKED")
+        self.assertEqual([x["seconds"] for x in result["renders"]], [15, 30, 60])
+        self.assertTrue(all(len(x["sha256"]) == 64 for x in result["renders"]))
+        self.assertFalse(result["commercial_release_eligible"])
+        self.assertFalse(result["code_commit_attested_by_ci"])
+        self.assertFalse(result["human_visual_approval"])
+
+    def test_incomplete_duplicate_forged_or_stale_head_denied(self):
+        for variant in ("missing", "duplicate", "stale", "tamper", "fake_sha"):
+            with self.subTest(variant=variant):
+                self.setUp_case(variant)
+                with self.assertRaises(MatrixEvidenceError):
+                    self.proof()
+
+    def setUp_case(self, variant):
+        import copy
+        # Restore records from local media, not a previously mutated list.
+        self.rows = [{"seconds": x, "path": f"synthetic-{x}s.mp4",
+                      "sha256": hashlib.sha256(bytes([x]) * 4096).hexdigest()}
+                     for x in (15, 30, 60)]
+        self.manifest = {"schema": "feature4_export_matrix_inputs_v1",
+                         "source_commit": HEAD, "renders": copy.deepcopy(self.rows)}
+        if variant == "missing":
+            self.manifest["renders"].pop()
+        elif variant == "duplicate":
+            self.manifest["renders"][2]["seconds"] = 30
+        elif variant == "stale":
+            self.manifest["source_commit"] = "b" * 40
+        elif variant == "tamper":
+            (self.root / "synthetic-30s.mp4").write_bytes(b"changed" * 700)
+        elif variant == "fake_sha":
+            self.manifest["renders"][1]["sha256"] = "f" * 64
+
+    def test_cross_shop_path_and_symlink_denied_before_probe(self):
+        for invalid in ("../foreign.mp4", "/tmp/foreign.mp4", "dir/other.mp4",
+                        "http://example.invalid/clip.mp4", "other\\foreign.mp4"):
+            with self.subTest(path=invalid):
+                self.manifest["renders"][0]["path"] = invalid
+                with patch("feature4_export_matrix.verify_mp4") as inspect:
+                    with self.assertRaises(MatrixEvidenceError):
+                        self.proof()
+                    inspect.assert_not_called()
+        self.manifest["renders"][0]["path"] = "symlink.mp4"
+        (self.root / "symlink.mp4").symlink_to(self.root / "synthetic-15s.mp4")
+        with self.assertRaisesRegex(MatrixEvidenceError, "unsafe"):
+            self.proof()
+
+    def test_modified_during_ffprobe_denied_by_rehash(self):
+        original = self.root / "synthetic-30s.mp4"
+        def modify(path, *, duration, width, height, fps):
+            if duration == 30:
+                with original.open("ab") as out:
+                    out.write(b"tamper")
+            return {"bytes": (path.stat().st_size - (6 if duration == 30 else 0))}
+        with patch("feature4_export_matrix.verify_mp4", side_effect=modify):
+            with self.assertRaises(MatrixEvidenceError):
+                verify_export_matrix(self.manifest, self.root, expected_head=HEAD)
+
+
+if __name__ == "__main__":
+    unittest.main()

