+            draw.line((pos(-14, 90), pos(-22+swing, 154)), fill=(214, 169, 136), width=max(2,int(11*scale)))
+            draw.line((pos(14, 90), pos(22-swing, 154)), fill=(214, 169, 136), width=max(2,int(11*scale)))
+            draw.ellipse((pos(-21, -102), pos(21, -57)), fill=(210, 166, 136))
