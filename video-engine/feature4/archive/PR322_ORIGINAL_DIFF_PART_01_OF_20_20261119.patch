+
+/* OpenReel PreviewTimecode adapted to the Feature4 design. */
+.f4-frame-timecode{display:flex;align-items:center;gap:5px;position:relative;font-size:11px;font-variant-numeric:tabular-nums;white-space:nowrap;color:#c0d3e6}
