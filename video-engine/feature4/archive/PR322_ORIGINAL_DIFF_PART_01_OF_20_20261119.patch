+async function mount(page, approved=false) {
+ await page.goto('/')
+ await page.evaluate(async ({shop,approved}) => {
+  const fixture = await import('/e2e/fixtures/timeline-studio-harness.jsx')
+  fixture.mountFeature4({shop,approved})
