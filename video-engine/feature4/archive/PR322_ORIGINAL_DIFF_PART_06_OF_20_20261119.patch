+"""Real decoded FFmpeg blank-scene detection, negative fixtures and time fences."""
+import json
+import sys
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT=Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(ROOT/"video-engine"))
+from feature4_scene_visibility import verify_scene_visibility,VisibilityProofError
+import feature4_scene_visibility
+
+SCENES=[{"start":0.0,"duration":5.0},
+        {"start":5.0,"duration":5.0},
+        {"start":10.0,"duration":5.0}]
+
+
+class Feature4SceneVisibilityTests(unittest.TestCase):
+    def setUp(self):
+        temp=tempfile.TemporaryDirectory(prefix="f4-visibility-")
+        self.addCleanup(temp.cleanup)
+        self.root=Path(temp.name)
+        self.path=self.root/"encoded.mp4"
+
+    def source(self, first="red"):
+        subprocess.run([
+            "ffmpeg","-nostdin","-hide_banner","-loglevel","error",
+            "-f","lavfi","-i",f"color=c={first}:s=540x960:r=12:d=5",
+            "-f","lavfi","-i","color=c=blue:s=540x960:r=12:d=5",
+            "-f","lavfi","-i","color=c=green:s=540x960:r=12:d=5",
+            "-f","lavfi","-i","sine=frequency=430:duration=15",
+            "-filter_complex","[0:v][1:v][2:v]concat=n=3:v=1:a=0[v]",
+            "-map","[v]","-map","3:a:0","-c:v","libx264",
+            "-preset","ultrafast","-pix_fmt","yuv420p",
+            "-c:a","aac","-b:a","48k","-threads","2","-shortest",
+            str(self.path),
+        ],check=True,capture_output=True,timeout=120)
+
+    def test_three_actual_nonblank_encoded_scenes_pass_not_commercial_approval(self):
+        self.source()
+        report=verify_scene_visibility(self.path,seconds=15,scenes=SCENES)
+        self.assertEqual(report["checked_scene_count"],3)
+        self.assertEqual(report["sustained_near_black_count"],0)
+        self.assertEqual(report["status"],"SAMPLED_SCENES_NOT_BLANK_NOT_CONTENT_APPROVAL")
+        self.assertFalse(report["commercial_release_eligible"])
+        self.assertFalse(report["unexpected_overlay_absence_verified"])
+        self.assertEqual(len(report["checked_scenes"][0]["samples"]),5)
+        self.assertEqual(report["schema"],"feature4_scene_visibility_v3")
+        self.assertTrue(report["continuous_full_reel_black_scan"])
+        self.assertEqual(report["continuous_black_hold_threshold_seconds"],.65)
+        self.assertEqual(report["continuous_long_black_holds_count"],0)
+        self.assertFalse(report["sub_threshold_blank_frames_certified_absent"])
+        self.assertEqual(report["sample_fractions"],[.15,.30,.50,.70,.85])
+        self.assertFalse(report["short_blank_frames_excluded_by_sampling"])
+        self.assertGreater(report["checked_scenes"][0]["samples"][0]["mean_luma"],14)
+
+    def test_actual_encoded_fully_black_scene_is_rejected(self):
+        self.source(first="black")
+        with self.assertRaisesRegex(VisibilityProofError,"nearly entirely blank"):
+            verify_scene_visibility(self.path,seconds=15,scenes=SCENES)
+
+    def test_actual_middle_black_interval_old_two_samples_missed(self):
+        # First 5s shot: 1.75s red + 1.5s black + 1.75s red.
+        # Old 30%/70% checks at 1.5/3.5s saw red; the new 50%
+        # sample at 2.5s sees the real encoded black image.
+        parts=[("red",1.75),("black",1.5),("red",1.75),
+               ("blue",5),("green",5)]
+        args=["ffmpeg","-nostdin","-hide_banner","-loglevel","error"]
+        for color,duration in parts:
+            args+=["-f","lavfi","-i",
+                   f"color=c={color}:s=540x960:r=12:d={duration}"]
+        args+=["-f","lavfi","-i","sine=frequency=430:duration=15",
+               "-filter_complex","".join(f"[{i}:v]" for i in range(5))
+                                 +"concat=n=5:v=1:a=0[v]",
+               "-map","[v]","-map","5:a:0",
+               "-c:v","libx264","-preset","ultrafast",
+               "-pix_fmt","yuv420p","-c:a","aac","-b:a","48k",
+               "-threads","2","-shortest",str(self.path)]
+        subprocess.run(args,check=True,capture_output=True,timeout=120)
+        with self.assertRaisesRegex(VisibilityProofError,"blank/black"):
+            verify_scene_visibility(self.path,seconds=15,scenes=SCENES)
+
+    def test_blackdetect_log_parses_numeric_events_not_literal_backslashes(self):
+        sample="[blackdetect @ 0x1] black_start:1.6 black_end:2.4 black_duration:0.8"
+        match=feature4_scene_visibility._BLACK_HOLD_RX.search(sample)
+        self.assertIsNotNone(match)
+        self.assertEqual(tuple(map(float,match.groups())),(1.6,2.4,0.8))
+
+    def test_sustained_black_hold_between_all_five_interior_probes_rejected(self):
+        # First five-second scene: red 1.6s, BLACK .8s, red 2.6s.
+        # Interior samples .75/1.5/2.5/3.5/4.25 all see nonblack red.
+        parts=[("red",1.6),("black",.8),("red",2.6),
+               ("blue",5),("green",5)]
+        args=["ffmpeg","-nostdin","-hide_banner","-loglevel","error"]
+        for color,duration in parts:
+            args+=["-f","lavfi","-i",
+                   f"color=c={color}:s=540x960:r=12:d={duration}"]
+        args+=["-f","lavfi","-i","sine=frequency=430:duration=15",
+               "-filter_complex","".join(f"[{i}:v]" for i in range(5))
+                 +"concat=n=5:v=1:a=0[v]",
+               "-map","[v]","-map","5:a:0",
+               "-c:v","libx264","-preset","ultrafast","-pix_fmt","yuv420p",
+               "-c:a","aac","-b:a","48k","-threads","2","-shortest",str(self.path)]
+        subprocess.run(args,check=True,capture_output=True,timeout=120)
+        # The real FFmpeg full-frame scan rejects what five probes miss.
+        with self.assertRaisesRegex(VisibilityProofError,"continuous black hold"):
+            verify_scene_visibility(self.path,seconds=15,scenes=SCENES)
+
+    def test_encoded_media_changed_during_sampling_rejected(self):
+        self.source()
+        original=feature4_scene_visibility._pixel_frame
+        changed=[False]
+        def mutate_after_one_decoded_frame(source,at):
+            sample=original(source,at)
+            if not changed[0]:
+                changed[0]=True
+                with self.path.open("ab") as handle:
+                    handle.write(b"concurrently-mutated-source")
+            return sample
+        with patch.object(feature4_scene_visibility,"_pixel_frame",
+                          side_effect=mutate_after_one_decoded_frame):
+            with self.assertRaisesRegex(VisibilityProofError,"changed"):
+                verify_scene_visibility(self.path,seconds=15,scenes=SCENES)
+        self.assertTrue(changed[0])
+
+    def test_malicious_scene_ranges_and_wrong_run_duration_rejected(self):
+        self.source()
+        for windows in (
+            SCENES[:2],
+            [{**SCENES[0],"duration":6.0},*SCENES[1:]],
+            [{**SCENES[0],"start":-0.1},*SCENES[1:]],
+            [SCENES[0],{**SCENES[1],"duration":float("nan")},SCENES[2]],
+            [{"start":0.0,"duration":15.0,"asset_id":"untrusted"},SCENES[1]],
+        ):
+            with self.subTest(windows=windows),self.assertRaises(VisibilityProofError):
+                verify_scene_visibility(self.path,seconds=15,scenes=windows)
+        with self.assertRaises(VisibilityProofError):
+            verify_scene_visibility(self.path,seconds=60,scenes=SCENES)
+
+    def test_no_fake_decodable_video_from_garbage_or_symlink(self):
+        self.path.write_bytes(b"bad mp4"*2000)
+        with self.assertRaises(VisibilityProofError):
+            verify_scene_visibility(self.path,seconds=15,scenes=SCENES)
+        self.path.unlink()
+        safe=self.root/"safe.mp4"
+        safe.write_bytes(b"fake"*2000)
+        self.path.symlink_to(safe)
+        with self.assertRaises(VisibilityProofError):
+            verify_scene_visibility(self.path,seconds=15,scenes=SCENES)
+
+
+if __name__=="__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_scene_visibility_receipt.py b/tests/media/test_feature4_scene_visibility_receipt.py
--- a/tests/media/test_feature4_scene_visibility_receipt.py
+++ b/tests/media/test_feature4_scene_visibility_receipt.py
@@ -0,0 +1,140 @@
+"""Strict evidence validation for 12 encoded stock Reel scene samples."""
+import hashlib
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT=Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(ROOT/"video-engine"))
+from feature4_minute_quality_receipt import (
+    MinuteProofError, validate_visibility_evidence
+)
+
+
+class VisibilityReceiptTests(unittest.TestCase):
+    def setUp(self):
+        ctx=tempfile.TemporaryDirectory()
+        self.addCleanup(ctx.cleanup)
+        self.root=Path(ctx.name)
+        self.original=self.root/"real-encoded.mp4"
+        self.provenance=self.root/"source.json"
+        self.visibility_proof=self.root/"scene-visibility.json"
+        self.original.write_bytes(b"private-original-encoded-media"*100)
+        self.windows=[{"start":i*5.0,"duration":5.0} for i in range(12)]
+        self.prov={"scene_windows":self.windows}
+        self.report={
+            "schema":"feature4_scene_visibility_v3",
+            "continuous_full_reel_black_scan":True,
+            "continuous_black_hold_threshold_seconds":.65,
+            "continuous_long_black_holds_count":0,
+            "sub_threshold_blank_frames_certified_absent":False,
+            "sample_fractions":[.15,.30,.50,.70,.85],
+            "short_blank_frames_excluded_by_sampling":False,
+            "status":"SAMPLED_SCENES_NOT_BLANK_NOT_CONTENT_APPROVAL",
+            "source_sha256":hashlib.sha256(self.original.read_bytes()).hexdigest(),
+            "seconds":60,"checked_scene_count":12,
+            "sustained_near_black_count":0,
+            "commercial_release_eligible":False,
+            "garment_identity_verified":False,
+            "unexpected_overlay_absence_verified":False,
+            "checked_scenes":[{
+                "scene_start":i*5.0,"duration":5.0,
+                "sustained_near_black":False,
+                "samples":[{"time_seconds":round(i*5.0+fraction*5.0,3),
+                            "mean_luma":87,"near_black_fraction":0.03}
+                           for fraction in (.15,.30,.50,.70,.85)]
+            } for i in range(12)],
+        }
+        self.persist()
+    def persist(self):
+        self.provenance.write_text(json.dumps(self.prov))
+        self.visibility_proof.write_text(json.dumps(self.report))
+    def verify(self):
+        return validate_visibility_evidence(
+            original=self.original,provenance=self.provenance,
+            visibility_proof=self.visibility_proof)
+    def test_sha_linked_sampled_scans_are_not_artistic_approval(self):
+        result=self.verify()
+        self.assertEqual(result["checked_scene_count"],12)
+        self.assertFalse(result["commercial_release_eligible"])
+        self.assertFalse(result["unexpected_overlay_absence_verified"])
+    def test_suspicious_black_sample_or_forged_human_approval_rejected(self):
+        self.report["checked_scenes"][3]["sustained_near_black"]=True
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+        self.report["checked_scenes"][3]["sustained_near_black"]=False
+        for key in ("commercial_release_eligible","garment_identity_verified",
+                    "unexpected_overlay_absence_verified"):
+            self.report[key]=True
+            self.persist()
+            with self.subTest(key=key),self.assertRaises(MinuteProofError):
+                self.verify()
+            self.report[key]=False
+    def test_altered_video_bytes_or_out_of_scene_sample_rejected(self):
+        self.original.write_bytes(self.original.read_bytes()+b"changed")
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+        self.report["source_sha256"]=hashlib.sha256(self.original.read_bytes()).hexdigest()
+        self.report["checked_scenes"][0]["samples"][0]["time_seconds"]=20
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+    def test_missing_center_sample_or_forged_black_flag_rejected(self):
+        # Evidence must cover every reviewed interior time, not just the old
+        # two temporal probes, and cannot claim a black sample is visible.
+        self.report["checked_scenes"][0]["samples"].pop(2)
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+        self.report["checked_scenes"][0]["samples"].insert(
+            2,{"time_seconds":2.5,"mean_luma":0,"near_black_fraction":1})
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+        self.report["checked_scenes"][0]["samples"][2]={
+            "time_seconds":2.8,"mean_luma":87,"near_black_fraction":.03}
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+
+    def test_missing_or_forged_continuous_scan_evidence_rejected(self):
+        for key,bad in (("continuous_full_reel_black_scan",False),
+                        ("continuous_black_hold_threshold_seconds",99),
+                        ("continuous_long_black_holds_count",True),
+                        ("continuous_long_black_holds_count",1),
+                        ("sub_threshold_blank_frames_certified_absent",True)):
+            original=self.report[key]
+            self.report[key]=bad
+            self.persist()
+            with self.subTest(key=key,bad=bad),self.assertRaises(MinuteProofError):
+                self.verify()
+            self.report[key]=original
+
+    def test_legacy_two_frame_proof_is_no_longer_accepted(self):
+        self.report["schema"]="feature4_scene_visibility_v1"
+        self.report["checked_scenes"][0]["samples"]=[
+            self.report["checked_scenes"][0]["samples"][1],
+            self.report["checked_scenes"][0]["samples"][3]]
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+
+    def test_mismatched_scene_claim_and_symlinked_receipt_rejected(self):
+        self.report["checked_scenes"][7]["scene_start"]=1
+        self.persist()
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+        self.report["checked_scenes"][7]["scene_start"]=35
+        self.persist()
+        actual=self.root/"real-report.json"
+        self.visibility_proof.rename(actual)
+        self.visibility_proof.symlink_to(actual)
+        with self.assertRaises(MinuteProofError):
+            self.verify()
+
+
+if __name__=="__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_stock_download_atomic.py b/tests/media/test_feature4_stock_download_atomic.py
--- a/tests/media/test_feature4_stock_download_atomic.py
+++ b/tests/media/test_feature4_stock_download_atomic.py
@@ -0,0 +1,105 @@
+"""F4-13: no network access or real customer media; private stock staging regression."""
+import hashlib
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_stock_showcase import StockShowcaseError, retrieve_stock
+
+URL = "https://videos.pexels.com/video-files/test/test-hd.mp4"
+PAYLOAD = b"synthetic test fixture bytes" * 3000
+
+
+class FakeResponse:
+    url = URL
+    headers = {"Content-Type": "video/mp4"}
+
+    def __init__(self):
+        self.sent = False
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        return False
+
+    def read(self, _):
+        if self.sent:
+            return b""
+        self.sent = True
+        return PAYLOAD
+
+
+class FakeOpener:
+    def open(self, request, timeout):
+        assert timeout == 55
+        assert request.full_url == URL
+        return FakeResponse()
+
+
+class PrivateStockDownloadTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.destination = self.root / "stock.mp4"
+
+    def retrieve(self):
+        with patch("feature4_stock_showcase.urllib.request.build_opener",
+                   return_value=FakeOpener()):
+            return retrieve_stock(self.destination, (URL,))
+
+    def test_success_is_atomic_and_hashes_exact_fixture_bytes(self):
+        receipt = self.retrieve()
+        self.assertEqual(self.destination.read_bytes(), PAYLOAD)
+        self.assertEqual(receipt["sha256"], hashlib.sha256(PAYLOAD).hexdigest())
+        self.assertEqual(receipt["size_bytes"], len(PAYLOAD))
+        self.assertEqual(list(self.root.glob(".feature4-stock-*")), [])
+
+    def test_existing_private_media_cannot_be_overwritten(self):
+        self.destination.write_bytes(b"keep-existing-private-media")
+        with patch("feature4_stock_showcase.urllib.request.build_opener",
+                   side_effect=AssertionError("network must not be attempted")):
+            with self.assertRaisesRegex(StockShowcaseError, "overwrite"):
+                retrieve_stock(self.destination, (URL,))
+        self.assertEqual(self.destination.read_bytes(), b"keep-existing-private-media")
+
+    def test_symlink_destination_cannot_redirect_private_download(self):
+        protected = self.root / "protected.txt"
+        protected.write_bytes(b"do-not-clobber")
+        self.destination.symlink_to(protected)
+        with self.assertRaisesRegex(StockShowcaseError, "overwrite"):
+            self.retrieve()
+        self.assertEqual(protected.read_bytes(), b"do-not-clobber")
+
+    def test_concurrent_destination_creation_fails_closed_and_cleans_temp(self):
+        def competing_writer(source, destination):
+            Path(destination).write_bytes(b"newer-private-media")
+            raise FileExistsError("another writer won")
+        with patch("feature4_stock_showcase.os.link",
+                   side_effect=competing_writer):
+            with self.assertRaisesRegex(StockShowcaseError, "overwrite"):
+                self.retrieve()
+        self.assertEqual(self.destination.read_bytes(), b"newer-private-media")
+        self.assertEqual(list(self.root.glob(".feature4-stock-*")), [])
+
+    def test_invalid_media_type_leaves_no_private_temp_or_output(self):
+        class WrongType(FakeResponse):
+            headers = {"Content-Type": "text/html"}
+        class BadOpener:
+            def open(self, *_args, **_kwargs):
+                return WrongType()
+        with patch("feature4_stock_showcase.urllib.request.build_opener",
+                   return_value=BadOpener()):
+            with self.assertRaises(StockShowcaseError):
+                retrieve_stock(self.destination, (URL,))
+        self.assertFalse(self.destination.exists())
+        self.assertEqual(list(self.root.glob(".feature4-stock-*")), [])
+
+
+if __name__ == "__main__":
+    unittest.main()

