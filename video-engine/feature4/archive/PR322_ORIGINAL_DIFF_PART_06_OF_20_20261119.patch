+"""Stock full-minute standalone CPU acceptance script is safe and well formed."""
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+SCRIPT=Path(__file__).resolve().parents[2]/"video-engine/feature4_stock_minute_acceptance.sh"
+class MinuteRunnerContractTests(unittest.TestCase):
+    def test_bash_syntax_is_valid(self):
+        subprocess.run(["bash","-n",str(SCRIPT)],check=True,timeout=10)
+    def test_full_minute_runner_encodes_private_editorial_caption_review(self):
+        text = SCRIPT.read_text(encoding="utf-8")
+        self.assertIn("export_private_subtitle_pair(cues,duration_seconds=60", text)
+        self.assertIn("burn_reviewed_subtitles(Path(sys.argv[3]),srt", text)
+        self.assertIn("feature4-stock-minute-captioned-review.mp4", text)
+        self.assertIn("EDITORIAL_TEST_TITLES_NOT_SPOKEN_AUDIO", text)
+        self.assertIn("NOT speech alignment", text)
+        self.assertIn("feature4_endcard_qa.py", text)
+        self.assertIn("--endcard-proof", text)
+        self.assertIn("--visibility-proof", text)
+
+    def test_no_arguments_and_existing_directory_fail_before_download(self):
+        for args in ([],["/tmp"]):
+            p=subprocess.run(["bash",str(SCRIPT),*args],capture_output=True,text=True,timeout=10)
+            self.assertEqual(p.returncode,2)
+            self.assertIn("Usage:",p.stderr)
+
+    def test_symlinked_parent_rejected_before_creating_private_output(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            real = root / "real"
+            real.mkdir()
+            (root / "redirect").symlink_to(real, target_is_directory=True)
+            output = root / "redirect" / "minute"
+            result = subprocess.run(
+                ["bash", str(SCRIPT), str(output)],
+                capture_output=True, text=True, timeout=10,
+            )
+            self.assertEqual(result.returncode, 2)
+            self.assertIn("Unsafe private output path", result.stderr)
+            self.assertFalse((real / "minute").exists())
+
+    def test_parent_traversal_and_missing_parent_rejected_before_render(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            (root / "safe").mkdir()
+            for output in (
+                str(root / "safe" / ".." / "escape"),
+                str(root / "missing" / "minute"),
+            ):
+                with self.subTest(output=output):
+                    result = subprocess.run(
+                        ["bash", str(SCRIPT), output],
+                        capture_output=True, text=True, timeout=10,
+                    )
+                    self.assertEqual(result.returncode, 2)
+                    self.assertIn("Unsafe private output path", result.stderr)
+            self.assertFalse((root / "escape").exists())
+            self.assertFalse((root / "missing").exists())
+
+    def test_missing_ffmpeg_does_not_create_orphan_output_directory(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            tools = root / "minimal-bin"
+            tools.mkdir()
+            for name in ("python3", "dirname"):
+                binary = shutil.which(name)
+                self.assertIsNotNone(binary)
+                (tools / name).symlink_to(Path(binary).resolve())
+            output = root / "fresh-private-minute"
+            result = subprocess.run(
+                ["/bin/bash", str(SCRIPT), str(output)],
+                env={**os.environ, "PATH": str(tools)},
+                capture_output=True, text=True, timeout=10,
+            )
+            self.assertNotEqual(result.returncode, 0)
+            self.assertFalse(output.exists(),
+                             "Missing local encoder must fail before mkdir")

diff --git a/tests/media/test_feature4_stock_showcase.py b/tests/media/test_feature4_stock_showcase.py
--- a/tests/media/test_feature4_stock_showcase.py
+++ b/tests/media/test_feature4_stock_showcase.py
@@ -0,0 +1,87 @@
+"""Test-only source-level acceptance for genuine-footage staging, never footage rights itself."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(ROOT/"video-engine"))
+from feature4_stock_showcase import (CLIPS,StockShowcaseError,make_project,original_music,check_input,normalize_for_renderer)
+
+class StockShowcaseTests(unittest.TestCase):
+    def setUp(self):
+        self.ctx=tempfile.TemporaryDirectory()
+        self.addCleanup(self.ctx.cleanup)
+        self.root=Path(self.ctx.name)
+        self.media=self.root/"media"
+        self.media.mkdir()
+    def create_sources(self):
+        # Three honest test-pattern videos are compiler-only, NOT human sample footage.
+        for index,(_,source_id,_,_,_) in enumerate(CLIPS):
+            out=self.media/(source_id+".mp4")
+            subprocess.run(["ffmpeg","-nostdin","-v","error","-y","-f","lavfi",
+              "-i",f"testsrc2=size=128x224:rate=12:duration=6,format=yuv420p",
+              "-c:v","libx264","-preset","ultrafast",str(out)],
+              check=True,capture_output=True,timeout=24)
+            self.assertGreater(out.stat().st_size,50000)
+    def test_compiles_exact_three_source_video_15s_with_immutable_provenance_gate(self):
+        self.create_sources()
+        project,report=make_project(self.media,self.root/"project")
+        html=(project/"index.html").read_text()
+        config=json.loads((project/"render-config.json").read_text())
+        self.assertEqual(html.count('class="footage clip"'),3)
+        self.assertIn('id="scene3"',html)
+        self.assertIn('STOCK FASHION EDIT - NOT A RETAILER AD',html)
+        self.assertNotIn('id="cta"',html)
+        self.assertEqual(config["duration_seconds"],15)
+        self.assertEqual((config["width"],config["height"]),(1080,1920))
+        self.assertFalse(report["showcase_eligible"])
+        self.assertFalse(report["commercial_release_eligible"])
+        self.assertFalse(report["retailer_garment_identity_verified"])
+        self.assertEqual(len(report["source_media"]),3)
+        self.assertNotIn('src="https:',html)
+        with self.assertRaisesRegex(StockShowcaseError,"overwrite"):
+            make_project(self.media,self.root/"project")
+    def test_missing_source_and_symlink_rejected_without_download(self):
+        with self.assertRaises((StockShowcaseError,FileNotFoundError)):
+            make_project(self.media,self.root/"project")
+        self.create_sources()
+        first=self.media/(CLIPS[0][1]+".mp4")
+        first.unlink()
+        first.symlink_to(self.media/(CLIPS[1][1]+".mp4"))
+        with self.assertRaisesRegex(StockShowcaseError,"unsafe"):
+            make_project(self.media,self.root/"project")
+    def test_bad_source_is_never_fashion_footage(self):
+        path=self.media/(CLIPS[0][1]+".mp4")
+        path.write_bytes(b"not a video"*10000)
+        with self.assertRaises(StockShowcaseError):
+            check_input(path)
+    def test_normalizes_sparse_keyframe_footage_into_24fps_portrait_without_source_mutation(self):
+        self.create_sources()
+        original=self.media/(CLIPS[0][1]+".mp4")
+        source_bytes=original.read_bytes()
+        stage=self.media/"stage.mp4"
+        info=normalize_for_renderer(original,stage,width=270,height=480)
+        self.assertEqual((info["width"],info["height"]),(270,480))
+        self.assertTrue(5.15<=info["seconds"]<=5.35)
+        self.assertEqual(original.read_bytes(),source_bytes)
+        d=json.loads(subprocess.check_output(["ffprobe","-v","error","-select_streams","v:0",
+             "-skip_frame","nokey","-show_frames","-show_entries","frame=best_effort_timestamp_time",
+             "-of","json",str(stage)],text=True))
+        timestamps=[float(x["best_effort_timestamp_time"]) for x in d["frames"]
+                    if "best_effort_timestamp_time" in x]
+        self.assertGreaterEqual(len(timestamps),5)
+        self.assertLessEqual(max(b-a for a,b in zip(timestamps,timestamps[1:])),1.1)
+        with self.assertRaisesRegex(StockShowcaseError,"replace"):
+            normalize_for_renderer(original,stage,width=270,height=480)
+
+    def test_original_audio_is_safely_local(self):
+        path=self.media/"original.wav"
+        original_music(path)
+        self.assertGreater(path.stat().st_size,300000)
+        info=subprocess.check_output(["ffprobe","-v","error","-show_entries",
+           "format=duration","-of","default=nw=1:nk=1",str(path)],text=True)
+        self.assertAlmostEqual(float(info.strip()),15,places=2)
+
+if __name__=="__main__":unittest.main()

diff --git a/tests/media/test_feature4_subtitle_burnin.py b/tests/media/test_feature4_subtitle_burnin.py
--- a/tests/media/test_feature4_subtitle_burnin.py
+++ b/tests/media/test_feature4_subtitle_burnin.py
@@ -0,0 +1,133 @@
+"""Actual encoded Feature4 SRT burn-in; fixture is original test footage, not speech."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_subtitles import export_private_subtitle_pair
+from feature4_private_preview import inspect_mp4
+import feature4_subtitle_burnin as burn
+
+
+class Feature4SubtitleBurnTests(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory(prefix="f4-burn-")
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.source = self.root / "source.mp4"
+        self.output = self.root / "captioned.mp4"
+        self.srt = self.root / "approved.srt"
+        self.vtt = self.root / "approved.vtt"
+        self.cues = [{"start": 2.0, "duration": 3.0,
+                      "text": "New arrivals tonight"}]
+
+    def source_fixture(self):
+        subprocess.run([
+            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
+            "-f", "lavfi", "-i", "color=c=black:s=540x960:r=24:d=15",
+            "-f", "lavfi", "-i", "sine=frequency=375:sample_rate=48000:duration=15",
+            "-map", "0:v:0", "-map", "1:a:0",
+            "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p",
+            "-c:a", "aac", "-b:a", "64k", "-shortest", "-threads", "2",
+            str(self.source),
+        ], check=True, capture_output=True, timeout=90)
+        self.source.chmod(0o600)
+
+    def approved_track(self):
+        export_private_subtitle_pair(self.cues, duration_seconds=15,
+                                     srt_path=self.srt, vtt_path=self.vtt)
+
+    def frame_bottom(self, seconds):
+        proc = subprocess.run([
+            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
+            "-ss", str(seconds), "-i", str(self.output),
+            "-frames:v", "1", "-vf",
+            "crop=540:300:0:660,scale=90:50,format=gray",
+            "-f", "rawvideo", "-",
+        ], check=True, capture_output=True, timeout=40)
+        self.assertEqual(len(proc.stdout), 90 * 50)
+        return proc.stdout
+
+    def test_real_caption_pixels_only_in_reviewed_interval(self):
+        self.source_fixture()
+        self.approved_track()
+        src = self.source.read_bytes()
+        proof = burn.burn_reviewed_subtitles(
+            self.source, self.srt, self.output, cues=self.cues,
+            expected_seconds=15)
+        self.assertEqual(self.source.read_bytes(), src)
+        self.assertEqual(proof["status"], "PRIVATE_ENCODED_SUBTITLES_NOT_PUBLISHED")
+        self.assertTrue(proof["actual_encoded_subtitle_filter_executed"])
+        self.assertFalse(proof["spoken_word_alignment_verified"])
+        self.assertFalse(proof["commercial_release_eligible"])
+        self.assertFalse(proof["signed_download_ready"])
+        self.assertEqual(self.output.stat().st_mode & 0o777, 0o600)
+        self.assertEqual((inspect_mp4(self.output, max_size=80*1024*1024)["width"],
+                          inspect_mp4(self.output, max_size=80*1024*1024)["height"]),
+                         (540, 960))
+        during = self.frame_bottom(3)
+        outside = self.frame_bottom(9)
+        # Genuine libass rendered white caption glyphs against black original.
+        self.assertGreater(sum(during) / len(during),
+                           sum(outside) / len(outside) + 2.0)
+        with self.assertRaisesRegex(burn.SubtitleBurnError, "fresh"):
+            burn.burn_reviewed_subtitles(
+                self.source, self.srt, self.output,
+                cues=self.cues, expected_seconds=15)
+
+    def test_unreviewed_caption_bytes_are_rejected(self):
+        self.source_fixture()
+        self.approved_track()
+        self.srt.write_text("1\n00:00:02,000 --> 00:00:05,000\nBUY NOW!!!\n")
+        with self.assertRaisesRegex(burn.SubtitleBurnError, "differ"):
+            burn.burn_reviewed_subtitles(
+                self.source, self.srt, self.output,
+                cues=self.cues, expected_seconds=15)
+        self.assertFalse(self.output.exists())
+
+    def test_escape_filename_nonprivate_directory_and_invalid_duration_rejected(self):
+        self.source_fixture()
+        self.approved_track()
+        unsafe = self.root / "captions:force_style=FontName=bad.srt"
+        unsafe.write_bytes(self.srt.read_bytes())
+        unsafe.chmod(0o600)
+        with self.assertRaisesRegex(burn.SubtitleBurnError, "Unsafe"):
+            burn.burn_reviewed_subtitles(
+                self.source, unsafe, self.output,
+                cues=self.cues, expected_seconds=15)
+        self.root.chmod(0o755)
+        with self.assertRaisesRegex(burn.SubtitleBurnError, "nonprivate"):
+            burn.burn_reviewed_subtitles(
+                self.source, self.srt, self.output,
+                cues=self.cues, expected_seconds=15)
+        self.root.chmod(0o700)
+        with self.assertRaisesRegex(burn.SubtitleBurnError, "15/30/60"):
+            burn.burn_reviewed_subtitles(
+                self.source, self.srt, self.output,
+                cues=self.cues, expected_seconds=12)
+        self.assertFalse(self.output.exists())
+
+    def test_mutation_after_encode_fails_closed_and_cleans_temporary_mp4(self):
+        self.source_fixture()
+        self.approved_track()
+        actual = burn._ffmpeg
+        def mutate_after_render(args, **kwargs):
+            actual(args, **kwargs)
+            with self.source.open("ab") as stream:
+                stream.write(b"changed-on-disk-after-encode")
+        with patch.object(burn, "_ffmpeg", side_effect=mutate_after_render):
+            with self.assertRaisesRegex(burn.SubtitleBurnError, "changed"):
+                burn.burn_reviewed_subtitles(
+                    self.source, self.srt, self.output,
+                    cues=self.cues, expected_seconds=15)
+        self.assertFalse(self.output.exists())
+        self.assertEqual(list(self.root.glob(".subtitle-burn-*.mp4")), [])
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_subtitles.py b/tests/media/test_feature4_subtitles.py
--- a/tests/media/test_feature4_subtitles.py
+++ b/tests/media/test_feature4_subtitles.py
@@ -0,0 +1,85 @@
+"""SRT/VTT accepted sidecars with exact speech timecodes and no silent editing."""
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_subtitles import (
+    SubtitleExportError, compose_approved_subtitles, export_private_subtitle_pair,
+)
+
+class Feature4SubtitleTests(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.srt = self.root / "captions.srt"
+        self.vtt = self.root / "captions.vtt"
+        self.cues = [
+            {"start": 0.505, "duration": 1.245, "text": "The autumn edit"},
+            {"start": 10.125, "duration": 2.375, "text": "See the garment detail"},
+            {"start": 28.500, "duration": 1.500, "text": "Stock example only"},
+        ]
+
+    def test_precise_caption_sidecars_preserve_wording_and_timing(self):
+        report = export_private_subtitle_pair(
+            self.cues, duration_seconds=30, srt_path=self.srt, vtt_path=self.vtt)
+        srt, vtt = self.srt.read_text(), self.vtt.read_text()
+        self.assertIn("00:00:00,505 --> 00:00:01,750", srt)
+        self.assertIn("00:00:10.125 --> 00:00:12.500", vtt)
+        self.assertIn("The autumn edit", srt)
+        self.assertTrue(vtt.startswith("WEBVTT"))
+        self.assertEqual(report["cue_count"], 3)
+        self.assertFalse(report["signed_download_ready"])
+        self.assertFalse(report["speech_text_alignment_verified_here"])
+        self.assertEqual(self.srt.stat().st_mode & 0o777, 0o600)
+        with self.assertRaisesRegex(SubtitleExportError, "fresh"):
+            export_private_subtitle_pair(
+                self.cues, duration_seconds=30, srt_path=self.srt, vtt_path=self.vtt)
+
+    def test_sixty_second_validated_timecodes(self):
+        cues = [{"start": 58.750, "duration": 1.250,
+                 "text": "Example end card"}]
+        srt, vtt = compose_approved_subtitles(cues, duration_seconds=60)
+        self.assertIn("00:00:58,750 --> 00:01:00,000", srt)
+        self.assertIn("00:00:58.750 --> 00:01:00.000", vtt)
+
+    def test_invalid_input_or_unreviewed_control_sequences_fail(self):
+        for cues in (
+            [{"start": 0.505, "duration": 1.245, "text": "Hello --> World"}],
+            [{"start": 0.5, "duration": 1, "text": "\ufeffbad"}],
+            [{"start": 0.5, "duration": 1.2454, "text": "Sub-ms time"}],
+            [{"start": 29.8, "duration": .5, "text": "Out of range"}],
+            [self.cues[0], {"start": 1, "duration": 1, "text": "Overlaps"}],
+        ):
+            with self.assertRaises(SubtitleExportError):
+                export_private_subtitle_pair(
+                    cues, duration_seconds=30, srt_path=self.srt, vtt_path=self.vtt)
+            self.assertFalse(self.srt.exists())
+            self.assertFalse(self.vtt.exists())
+
+    def test_exclusive_create_rollback_on_conflicting_second_file(self):
+        def second_file_collision(path, flags, mode):
+            if str(path) == str(self.vtt):
+                raise FileExistsError("racing writer")
+            return self.actual_open(path, flags, mode)
+        import os
+        self.actual_open = os.open
+        with patch("feature4_subtitles.os.open", side_effect=second_file_collision):
+            with self.assertRaises(SubtitleExportError):
+                export_private_subtitle_pair(self.cues, duration_seconds=30,
+                                              srt_path=self.srt, vtt_path=self.vtt)
+        self.assertFalse(self.srt.exists())
+        self.assertFalse(self.vtt.exists())
+
+    def test_symlink_destination_rejected_without_touching_target(self):
+        target = self.root / "do_not_change.txt"
+        target.write_text("unchanged")
+        self.srt.symlink_to(target)
+        with self.assertRaises(SubtitleExportError):
+            export_private_subtitle_pair(self.cues, duration_seconds=30,
+                                          srt_path=self.srt, vtt_path=self.vtt)
+        self.assertEqual(target.read_text(), "unchanged")

diff --git a/tests/media/test_feature4_visibility_window_integrity.py b/tests/media/test_feature4_visibility_window_integrity.py
--- a/tests/media/test_feature4_visibility_window_integrity.py
+++ b/tests/media/test_feature4_visibility_window_integrity.py
@@ -0,0 +1,102 @@
+"""Feature #4 F4-02: no positive 60s visibility receipt for gapped/overlapping time."""
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_minute_quality_receipt import (
+    MinuteProofError, validate_visibility_evidence,
+)
+
+FRACTIONS = [.15, .30, .50, .70, .85]
+SOURCE_SHA = "a" * 64
+
+
+def fixture():
+    windows = [{"start": 5 * i, "duration": 5} for i in range(12)]
+    scenes = []
+    for window in windows:
+        scenes.append({
+            "scene_start": window["start"],
+            "duration": window["duration"],
+            "sustained_near_black": False,
+            "samples": [
+                {"time_seconds": round(window["start"] + fraction * window["duration"], 3),
+                 "mean_luma": 75.0, "near_black_fraction": 0.0}
+                for fraction in FRACTIONS
+            ],
+        })
+    provenance = {"scene_windows": windows}
+    proof = {
+        "schema": "feature4_scene_visibility_v3",
+        "status": "SAMPLED_SCENES_NOT_BLANK_NOT_CONTENT_APPROVAL",
+        "source_sha256": SOURCE_SHA,
+        "seconds": 60,
+        "checked_scene_count": 12,
+        "sample_fractions": FRACTIONS,
+        "continuous_full_reel_black_scan": True,
+        "continuous_black_hold_threshold_seconds": .65,
+        "continuous_long_black_holds_count": 0,
+        "sub_threshold_blank_frames_certified_absent": False,
+        "short_blank_frames_excluded_by_sampling": False,
+        "sustained_near_black_count": 0,
+        "commercial_release_eligible": False,
+        "garment_identity_verified": False,
+        "unexpected_overlay_absence_verified": False,
+        "checked_scenes": scenes,
+    }
+    return provenance, proof
+
+
+class VisibilityWindowIntegrityTests(unittest.TestCase):
+    def check(self, provenance, proof):
+        with patch("feature4_minute_quality_receipt._record", side_effect=[provenance, proof]), \
+             patch("feature4_minute_quality_receipt._sha", return_value=SOURCE_SHA):
+            return validate_visibility_evidence(
+                original=Path("private-stock-fixture.mp4"),
+                provenance=Path("private-provenance.json"),
+                visibility_proof=Path("private-visibility.json"),
+            )
+
+    def test_valid_contiguous_minute_is_technical_only(self):
+        provenance, proof = fixture()
+        result = self.check(provenance, proof)
+        self.assertEqual(result["checked_scene_count"], 12)
+        self.assertIs(result["commercial_release_eligible"], False)
+
+    def test_both_matching_json_timelines_cannot_skip_or_repeat_time(self):
+        for altered_start in (24.5, 25.5):
+            with self.subTest(altered_start=altered_start):
+                provenance, proof = fixture()
+                provenance["scene_windows"][5]["start"] = altered_start
+                proof["checked_scenes"][5]["scene_start"] = altered_start
+                proof["checked_scenes"][5]["samples"] = [
+                    {"time_seconds": round(altered_start + fraction * 5, 3),
+                     "mean_luma": 75.0, "near_black_fraction": 0.0}
+                    for fraction in FRACTIONS
+                ]
+                with self.assertRaisesRegex(MinuteProofError, "not contiguous"):
+                    self.check(provenance, proof)
+
+    def test_full_minute_and_finite_positive_windows_required(self):
+        for bad_duration in (0, -5, float("nan"), float("inf"), 4):
+            with self.subTest(bad_duration=bad_duration):
+                provenance, proof = fixture()
+                provenance["scene_windows"][-1]["duration"] = bad_duration
+                proof["checked_scenes"][-1]["duration"] = bad_duration
+                with self.assertRaisesRegex(
+                    MinuteProofError, "not contiguous|full minute"
+                ):
+                    self.check(provenance, proof)
+
+    def test_window_shape_must_be_exact(self):
+        provenance, proof = fixture()
+        provenance["scene_windows"][0]["approval"] = True
+        with self.assertRaisesRegex(MinuteProofError, "not contiguous"):
+            self.check(provenance, proof)
+
+
+if __name__ == "__main__":
+    unittest.main()

