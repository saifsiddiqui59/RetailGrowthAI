diff --git a/tests/media/test_feature4_garment_integration.py b/tests/media/test_feature4_garment_integration.py
--- a/tests/media/test_feature4_garment_integration.py
+++ b/tests/media/test_feature4_garment_integration.py
@@ -0,0 +1,139 @@
+"""Feature4 garment reference + motion proxy: offline contracts, never model proof."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine"))
+from feature4_garment_integration import (GARMENTS, MINUTE_GARMENTS, OUTRO, StockShowcaseError,
+    checked_garment, make_garment_project, retrieve_garment)
+from feature4_stock_showcase import CLIPS
+
+class GarmentIntegrationTests(unittest.TestCase):
+    def setUp(self):
+        ctx = tempfile.TemporaryDirectory()
+        self.addCleanup(ctx.cleanup)
+        self.root = Path(ctx.name)
+        self.media = self.root / "media"
+        self.media.mkdir()
+
+    def sources(self):
+        # Deliberate synthetic ONLY for local/CI unit tests.
+        for _, sid, _, _, _ in CLIPS:
+            subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-y",
+                "-f", "lavfi", "-i",
+                "testsrc2=size=128x224:rate=12:duration=6,format=yuv420p",
+                "-c:v", "libx264", "-preset", "ultrafast",
+                str(self.media / (sid + ".mp4"))],
+                check=True, capture_output=True, timeout=30)
+        for _, sid, _, _ in GARMENTS + MINUTE_GARMENTS:
+            subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-y",
+                "-f", "lavfi", "-i", "testsrc2=size=640x960:rate=1",
+                "-frames:v", "1", "-q:v", "2", str(self.media / (sid + ".jpg"))],
+                check=True, capture_output=True, timeout=18)
+
+    def test_real_contract_compiles_30s_with_media_rights_and_beat_grid(self):
+        self.sources()
+        proj, report = make_garment_project(self.media, self.root / "project")
+        html = (proj / "index.html").read_text()
+        config = json.loads((proj / "render-config.json").read_text())
+        self.assertEqual(config["duration_seconds"], 30)
+        self.assertEqual((config["width"], config["height"], config["fps"]), (1080, 1920, 24))
+        self.assertEqual(html.count('class="footage clip"'), 3)
+        self.assertEqual(html.count('class="product-photo"'), 3)
+        self.assertIn(OUTRO, html)
+        self.assertIn('id="soundtrack"', html)
+        self.assertNotIn('id="cta"', html)
+        self.assertNotIn('src="https:', html)
+        self.assertEqual(len(report["source_media"]), 5)
+        self.assertEqual(report["music_beat_source"], "Measured offline PCM onset detector, not invented beat grid")
+        beats=report["measured_beat_timestamps"]
+        self.assertGreater(len(beats),20)
+        self.assertTrue(all(any(abs(cut-beat)<.17 for beat in beats)
+                        for cut in report["synced_scene_starts"][1:]))
+        self.assertNotEqual(report["synced_scene_starts"][1],5)
+        self.assertFalse(report["showcase_eligible"])
+        self.assertFalse(report["commercial_release_eligible"])
+        self.assertFalse(report["model_garment_match_verified"])
+        self.assertEqual(sum(x["source_feature"] == "feature3_garment_proxy"
+            for x in report["source_media"]), 2)
+        self.assertEqual(sum(x["source_feature"] == "feature5_stock_proxy"
+            for x in report["source_media"]), 3)
+        with self.assertRaisesRegex(StockShowcaseError, "overwrite"):
+            make_garment_project(self.media, self.root / "project")
+
+
+    def test_real_contract_compiles_sixty_second_full_hd_storyboard(self):
+        self.sources()
+        proj, report = make_garment_project(
+            self.media, self.root / "minute-project", seconds=60)
+        config = json.loads((proj / "render-config.json").read_text())
+        html = (proj / "index.html").read_text()
+        self.assertEqual(config["duration_seconds"], 60)
+        self.assertEqual((config["width"], config["height"], config["fps"]), (1080,1920,24))
+        self.assertEqual(report["scene_count"], 12)
+        self.assertEqual(report["editorial_subtitle_kind"], "EDITORIAL_TEST_TITLES_NOT_SPOKEN_AUDIO")
+        cues = report["editorial_subtitle_cues"]
+        self.assertEqual(len(cues), 12)
+        from feature4_subtitles import compose_approved_subtitles
+        srt, vtt = compose_approved_subtitles(cues, duration_seconds=60)
+        self.assertEqual(srt.count(" --> "), 12)
+        self.assertEqual(vtt.count(" --> "), 12)
+        self.assertEqual([c["start"] for c in cues], report["synced_scene_starts"])
+        # The 60s stock candidate previously repeated a clothes-rack still
+        # until ~58s. Reserve a real separate text/disclaimer endcard from ~55s.
+        self.assertGreater(report["synced_scene_starts"][-1],54.5)
+        self.assertLess(report["synced_scene_starts"][-1],55.5)
+        self.assertGreaterEqual(report["scene_windows"][-1]["duration"],4.5)
+        self.assertEqual(cues[-1]["text"],OUTRO)
+        self.assertNotEqual(cues[-2]["text"],OUTRO)
+        self.assertFalse(report["actual_spoken_voiceover"])
+        self.assertTrue(report["reused_stock_video_clips"])
+        self.assertEqual(html.count('class="footage clip"'), 5)
+        self.assertEqual(html.count('class="product-photo"'), 6)
+        self.assertEqual(len(report["source_media"]), 7)
+        self.assertEqual(sum(a["source_feature"] == "feature3_garment_proxy"
+                             for a in report["source_media"]), 4)
+        self.assertEqual(len({a["source_id"] for a in report["source_media"]}), 7)
+        self.assertIn('id="scene11"', html)
+        self.assertNotIn('id="cta"', html)
+        self.assertFalse(report["model_garment_match_verified"])
+        self.assertFalse(report["commercial_release_eligible"])
+        self.assertFalse(report["actual_spoken_voiceover"])
+        self.assertGreater(len(report["measured_beat_timestamps"]), 45)
+        for cut in report["synced_scene_starts"][1:]:
+            self.assertTrue(any(abs(cut - beat) < .17
+                                for beat in report["measured_beat_timestamps"]))
+        with self.assertRaises(StockShowcaseError):
+            make_garment_project(self.media, self.root / "minute-project", seconds=60)
+
+    def test_unreviewed_full_minute_duration_fails_closed(self):
+        for seconds in (12, 31, 59, 61, True):
+            with self.assertRaisesRegex(StockShowcaseError, "Only 30s or 60s"):
+                make_garment_project(self.media, self.root / "no-project", seconds=seconds)
+
+    def test_missing_and_symlinked_input_rejected(self):
+        self.sources()
+        image = self.media / (GARMENTS[0][1] + ".jpg")
+        image.unlink()
+        image.symlink_to(self.media / (GARMENTS[1][1] + ".jpg"))
+        with self.assertRaisesRegex(StockShowcaseError, "Unsafe"):
+            checked_garment(image)
+        with self.assertRaisesRegex(StockShowcaseError, "Unsafe"):
+            make_garment_project(self.media, self.root / "project")
+
+    def test_non_image_rejected(self):
+        x = self.media / (GARMENTS[0][1] + ".jpg")
+        x.write_bytes(b"not-really-jpeg" * 3000)
+        with self.assertRaises(Exception):
+            checked_garment(x)
+
+    def test_unlisted_garment_id_rejected_offline(self):
+        with self.assertRaisesRegex(StockShowcaseError, "not allowlisted"):
+            retrieve_garment(self.media / "any.jpg", "bad-id")
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_http_handoff.py b/tests/media/test_feature4_http_handoff.py
--- a/tests/media/test_feature4_http_handoff.py
+++ b/tests/media/test_feature4_http_handoff.py
@@ -0,0 +1,182 @@
+"""Offline Feature4 additive HTTP handoff tests; NOT a deployed Azure endpoint."""
+import copy
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "video-engine"))
+from feature4_http_handoff import Feature4HTTP  # noqa: E402
+
+SHOP = "11111111-1111-4111-8111-111111111111"
+OTHER = "44444444-4444-4444-8444-444444444444"
+CAMPAIGN = "22222222-2222-4222-8222-222222222222"
+JOB = "33333333-3333-4333-8333-333333333333"
+LEASE = "55555555-5555-4555-8555-555555555555"
+ASSET = "66666666-6666-4666-8666-666666666666"
+JWT = "authenticated-user-jwt"
+USER = "verified-user"
+
+
+def intent():
+    return {
+        "shop_id": SHOP, "campaign_id": CAMPAIGN, "approval_id": "feature2-approved-1",
+        "draft": {
+            "version": "rg_video_v2", "shop_id": SHOP,
+            "duration_seconds": 30,
+            "scenes": [
+                {"start": 0, "duration": 15, "headline": "Diwali Sale"},
+                {"start": 15, "duration": 15, "headline": "Visit Our Store"},
+            ],
+        },
+    }
+
+
+class Users:
+    def __init__(self):
+        self.allow_read = True
+        self.allow_write = True
+        self.campaign_data = {"shop_id": SHOP, "id": CAMPAIGN, "status": "DRAFT"}
+        self.job = {"shop_id": SHOP, "id": JOB, "status": "QUEUED",
+                    "output_asset_id": None}
+        self.asset_data = {"shop_id": SHOP, "mime_type": "video/mp4",
+                           "storage_bucket": "retailgrowth-media",
+                           "object_path": SHOP + "/renders/" + JOB + "/" + LEASE + ".mp4"}
+        self.signed = []
+
+    def campaign(self, token, user_id, campaign_id):
+        assert token == JWT and user_id == USER and campaign_id == CAMPAIGN
+        return self.campaign_data
+
+    def member(self, token, user_id, shop_id, write):
+        assert token == JWT and user_id == USER and shop_id in (SHOP, OTHER)
+        return self.allow_write if write else self.allow_read
+
+    def feature4_job(self, token, user_id, job_id):
+        assert token == JWT and user_id == USER and job_id == JOB
+        return self.job
+
+    def asset(self, token, shop_id, asset_id):
+        assert token == JWT and shop_id == SHOP and asset_id == ASSET
+        return self.asset_data
+
+    def sign_download(self, token, shop_id, object_path):
+        assert token == JWT and shop_id == SHOP
+        self.signed.append(object_path)
+        return "https://example.supabase.co/storage/v1/object/sign/retailgrowth-media/" + object_path + "?token=private-example"
+
+
+class Admin:
+    def __init__(self):
+        self.calls = []
+        self.jobs = {}
+
+    def create_feature4_intent(self, item):
+        self.calls.append(item)
+        key = item["idempotency_key"]
+        self.jobs.setdefault(key, {"id": JOB, "shop_id": SHOP, "status": "QUEUED"})
+        return self.jobs[key]
+
+
+class Feature4HTTPHandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.users = Users()
+        self.admin = Admin()
+        self.api = Feature4HTTP(self.users, self.admin)
+
+    def create(self, body=None):
+        return self.api.create(JWT, USER, CAMPAIGN, intent() if body is None else body)
+
+    def test_create_authorized_once_and_stable_idempotency(self):
+        status, result = self.create()
+        self.assertEqual((status, result), (202, {"shop_id": SHOP, "job_id": JOB, "status": "QUEUED"}))
+        self.assertEqual(self.create(), (202, result))
+        self.assertEqual(len(self.admin.calls), 2)
+        self.assertEqual(len(self.admin.jobs), 1)  # atomic backend does one reservation
+        item = self.admin.calls[0]
+        self.assertEqual(item["preset"], "feature4_reel_v1")
+        self.assertEqual(item["shop_id"], SHOP)
+        self.assertEqual(item["requested_by"], USER)
+        self.assertEqual(item["idempotency_key"], self.admin.calls[1]["idempotency_key"])
+        self.assertEqual(len(item["idempotency_key"]), 64)
+
+    def test_invalid_path_tenant_or_body_cannot_reserve(self):
+        for modifier in (
+            lambda b: b.update(shop_id=OTHER),
+            lambda b: b.update(campaign_id=OTHER),
+            lambda b: b.update(approval_id="../../unsafe"),
+            lambda b: b["draft"].update(shop_id=OTHER),
+            lambda b: b["draft"].update(version="creative_reel_v1"),
+            lambda b: b["draft"].update(duration_seconds=1000),
+            lambda b: b["draft"].update(scenes=[]),
+            lambda b: b.update(asset_url="https://external.invalid/untrusted.png"),
+        ):
+            body = intent()
+            modifier(body)
+            with self.subTest(body=body):
+                status, _ = self.create(body)
+                self.assertIn(status, (400, 404))
+        self.assertEqual(self.admin.calls, [])
+
+    def test_missing_campaign_or_write_membership_blocks_paid_job(self):
+        self.users.campaign_data = None
+        self.assertEqual(self.create()[0], 404)
+        self.users.campaign_data = {"shop_id": OTHER}
+        self.assertEqual(self.create()[0], 404)
+        self.users.campaign_data = {"shop_id": SHOP}
+        self.users.allow_write = False
+        self.assertEqual(self.create()[0], 403)
+        self.assertEqual(self.admin.calls, [])
+
+    def test_status_scoped_to_shop_and_verifies_job_receipt(self):
+        self.assertEqual(self.api.get(JWT, USER, JOB),
+                         (200, {"shop_id": SHOP, "job_id": JOB, "status": "QUEUED"}))
+        self.users.allow_read = False
+        self.assertEqual(self.api.get(JWT, USER, JOB)[0], 404)
+        self.users.allow_read = True
+        self.users.job["shop_id"] = OTHER
+        self.users.allow_read = False
+        self.assertEqual(self.api.get(JWT, USER, JOB)[0], 404)
+
+    def test_download_is_only_private_same_shop_and_claim_token(self):
+        self.users.job.update(status="SUCCEEDED", output_asset_id=ASSET)
+        status, result = self.api.download(JWT, USER, JOB)
+        self.assertEqual(status, 200)
+        self.assertEqual(result["job_id"], JOB)
+        self.assertEqual(result["shop_id"], SHOP)
+        self.assertEqual(self.users.signed, [self.users.asset_data["object_path"]])
+
+    def test_no_signature_on_pending_failed_foreign_media(self):
+        self.assertEqual(self.api.download(JWT, USER, JOB)[0], 409)
+        self.users.job.update(status="FAILED", output_asset_id=ASSET)
+        self.assertEqual(self.api.download(JWT, USER, JOB)[0], 409)
+        self.users.job["status"] = "SUCCEEDED"
+        bad_records = [
+            {"shop_id": OTHER}, {"mime_type": "image/png"},
+            {"storage_bucket": "public"},
+            {"object_path": OTHER + "/renders/" + JOB + "/" + LEASE + ".mp4"},
+            {"object_path": SHOP + "/renders/" + OTHER + "/" + LEASE + ".mp4"},
+            {"object_path": SHOP + "/renders/" + JOB + "/../replay.mp4"},
+        ]
+        original = copy.deepcopy(self.users.asset_data)
+        for bad in bad_records:
+            with self.subTest(bad=bad):
+                self.users.asset_data = {**original, **bad}
+                self.assertEqual(self.api.download(JWT, USER, JOB)[0], 404)
+        self.assertEqual(self.users.signed, [])
+
+    def test_wrong_job_id_from_atomic_insert_fails_closed(self):
+        self.admin.create_feature4_intent = lambda item: {
+            "id": "not-a-uuid", "shop_id": SHOP, "status": "QUEUED",
+        }
+        with self.assertRaises(ValueError):
+            self.create()
+
+    def test_excessively_large_draft_is_rejected_pre_insert(self):
+        payload = intent()
+        payload["draft"]["scenes"][0]["headline"] = "x" * 100_000
+        self.assertEqual(self.create(payload)[0], 400)
+        self.assertEqual(self.admin.calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_hyperframes_benchmark.py b/tests/media/test_feature4_hyperframes_benchmark.py
--- a/tests/media/test_feature4_hyperframes_benchmark.py
+++ b/tests/media/test_feature4_hyperframes_benchmark.py
@@ -0,0 +1,83 @@
+"""Cheap, no-render checks for F4-08/12 sample measurement integrity."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "video-engine" / "hyperframes"))
+
+from benchmark_render import parse_proc_stat, sample_process_group, benchmark, verified_output_sha256
+
+
+class HyperFramesBenchTests(unittest.TestCase):
+    def test_stat_parser_handles_nested_process_names(self):
+        fields = ["S"] + ["0"] * 21
+        fields[1], fields[2], fields[11], fields[12], fields[21] = "10", "15", "42", "7", "9"
+        data = "123 (chromium (worker)) " + " ".join(fields)
+        self.assertEqual(parse_proc_stat(data), (123, 10, 15, 49, 9))
+        self.assertIsNone(parse_proc_stat("garbage"))
+        self.assertIsNone(parse_proc_stat("123 (broken)"))
+
+    @unittest.skipUnless(sys.platform.startswith("linux"), "Linux proc filesystem")
+    def test_sampling_current_process_group_has_nonzero_rss(self):
+        rss, ticks, count = sample_process_group(os.getpgrp())
+        self.assertGreater(rss, 0)
+        self.assertGreaterEqual(ticks, 0)
+        self.assertGreaterEqual(count, 1)
+
+    def test_benchmark_receipt_hashes_real_stable_original_bytes(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / "synthetic-render.mp4"
+            data = b"test-only-render" * 200
+            path.write_bytes(data)
+            size, digest = verified_output_sha256(path)
+            self.assertEqual(size, len(data))
+            self.assertEqual(digest, hashlib.sha256(data).hexdigest())
+            self.assertEqual(len(digest), 64)
+
+    def test_rejects_symlink_truncated_and_missing_benchmark_source(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            real = root / "original.mp4"
+            real.write_bytes(b"dummy" * 500)
+            alias = root / "foreign.mp4"
+            alias.symlink_to(real)
+            for candidate in (alias, root / "missing.mp4"):
+                with self.subTest(path=candidate), self.assertRaises(ValueError):
+                    verified_output_sha256(candidate)
+            real.write_bytes(b"short")
+            with self.assertRaisesRegex(ValueError, "nonempty"):
+                verified_output_sha256(real)
+
+    def test_existing_output_or_receipt_rejected_before_any_render(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            project = root / "project"
+            project.mkdir()
+            (project / "render-config.json").write_text(json.dumps({
+                "contract_version": "rg_video_v2",
+                "renderer": "hyperframes", "duration_seconds": 30,
+                "width": 540, "height": 960, "fps": 24,
+            }), encoding="utf-8")
+            output = root / "render.mp4"
+            report = root / "report.json"
+            for occupied in (output, report):
+                occupied.write_bytes(b"already here")
+                with self.subTest(occupied=occupied), self.assertRaisesRegex(
+                        ValueError, "destinations must be new"):
+                    benchmark(project, output, report)
+                occupied.unlink()
+
+    def test_rejects_unbounded_timeout_before_loading_project(self):
+        for value in (0, 781, True, 20.5):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                benchmark("/nonexistent", "/invalid.mp4", "/invalid.json",
+                          timeout_seconds=value)
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/tests/media/test_feature4_intent_compiler.py b/tests/media/test_feature4_intent_compiler.py
