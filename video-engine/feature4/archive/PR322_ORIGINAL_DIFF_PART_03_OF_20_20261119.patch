+  assert.deepEqual(compatibleMedia('image', media).map(a => a.id), ['good_photo'])
+  const plan = makeVideoDraft({ shopId, mode: 'image', mediaAssets: media })
+  plan.scenes[1].asset_id = 'denied_photo'
+  assert.match(validateVideoDraft(plan, media).join(' '), /authorized same-shop media/)
+})
+
+test('scene reordering recalculates non-overlapping time starts', () => {
+  const plan = makeVideoDraft({ shopId, mode: 'text', duration: 30 })
+  const reordered = shiftVideoScene(plan.scenes, 0, 1)
+  assert.equal(reordered[0].headline, plan.scenes[1].headline)
+  assert.equal(reordered[1].headline, plan.scenes[0].headline)
+  assert.deepEqual(reordered.map(x => x.start), [0, 10, 20])
+  assert.deepEqual(shiftVideoScene(reordered, 0, -1), reordered)
+  assert.deepEqual(recalculateScenes(reordered), reordered)
+})
+
+test('cannot silently infer approved prices, beat data or music rights', () => {
+  const plan = makeVideoDraft({ shopId, mode: 'music_sync', mediaAssets: media })
+  assert.match(validateVideoDraft(plan, media, tracks).join(' '), /Beat-sync requires/)
+  plan.music_asset_id = 'licensed1'
+  plan.beats = [0, 5, 10]
+  assert.deepEqual(validateVideoDraft(plan, media, tracks), [])
+  plan.music_asset_id = 'untrusted'
+  assert.match(validateVideoDraft(plan, media, tracks).join(' '), /rights-cleared/)
+  plan.scenes[0].offer = 'x'.repeat(71)
+  assert.match(validateVideoDraft(plan, media, tracks).join(' '), /Offer text/)
+})
+
+test('invalid lengths and unlicensed art reject submit', () => {
+  const plan = makeVideoDraft({ shopId, mode: 'poster', mediaAssets: media })
+  plan.scenes[0].duration = 7
+  assert.match(validateVideoDraft(plan, media, tracks).join(' '), /sequential|fill/)
+  plan.scenes[0].duration = 5
+  plan.scenes[0].headline = ''
+  assert.match(validateVideoDraft(plan, media, tracks).join(' '), /headline/)
+})
+
+test('duration changes preserve the drafted professional story and authorized media', () => {
+  const draft = makeVideoDraft({ shopId, mode: 'media', duration: 30, mediaAssets: media })
+  draft.scenes[1].headline = 'Our actual approved kurti'
+  draft.scenes[1].offer = '20% OFF'
+  const longer = retimeVideoDraft(draft, 60)
+  assert.deepEqual(longer.scenes.map(s => s.start), [0, 20, 40])
+  assert.deepEqual(longer.scenes.map(s => s.duration), [20, 20, 20])
+  assert.equal(longer.scenes[1].headline, 'Our actual approved kurti')
+  assert.equal(longer.scenes[1].offer, '20% OFF')
+  assert.equal(longer.scenes[1].asset_id, draft.scenes[1].asset_id)
+  assert.deepEqual(validateVideoDraft(longer, media, tracks), [])
+  const shorter = retimeVideoDraft(longer, 15)
+  assert.deepEqual(shorter.scenes.map(s => s.start), [0, 5, 10])
+  assert.deepEqual(validateVideoDraft(shorter, media, tracks), [])
+  assert.equal(draft.duration_seconds, 30)
+})
+
+test('retiming never silently drops a short scene', () => {
+  const draft = makeVideoDraft({ shopId, mode: 'text', duration: 60 })
+  draft.scenes = Array.from({ length: 12 }, (_, i) => ({
+    start: i === 0 ? 0 : i < 11 ? i - 1 : 10,
+    duration: i < 11 ? .5 : 54.5,
+    headline: 'Approved',
+  }))
+  assert.throws(() => retimeVideoDraft(draft, 15), /shorter than half a second/)
+})
+
+test('scene motion and separate poster overlays are allowlisted, never custom expressions', () => {
+  const draft = makeVideoDraft({ shopId, mode: 'media', mediaAssets: media })
+  draft.scenes[1].animation_preset = 'pop'
+  draft.scenes[1].transition = 'slide'
+  draft.scenes[1].poster_overlay_asset_id = 'poster1'
+  assert.deepEqual(validateVideoDraft(draft, media, tracks), [])
+  draft.scenes[1].transition = 'url(javascript:alert(1))'
+  assert.match(validateVideoDraft(draft, media, tracks).join(' '), /unapproved transition/)
+  draft.scenes[1].transition = 'cut'
+  draft.scenes[1].poster_overlay_asset_id = 'denied_photo'
+  assert.match(validateVideoDraft(draft, media, tracks).join(' '), /authorized promotional poster/)
+  draft.scenes[1].poster_overlay_asset_id = draft.scenes[1].asset_id
+  assert.match(validateVideoDraft(draft, media, tracks).join(' '), /distinct authorized/)
+})
+
+test('F4-08 timeline frame jog seeks only inside the same authorized original video excerpt', () => {
+  const scene = { start: 10, duration: 5, trim_start: 3.25 }
+  const source = { kind: 'video', authorized: true, duration_seconds: 20, shop_id: shopId }
+  assert.equal(sourceClipTimeForPlayhead(scene, source, 11.5), 4.75)
+  assert.equal(sourceClipTimeForPlayhead(scene, source, 10), 3.25)
+  assert.equal(sourceClipTimeForPlayhead(scene, source, 15), null)
+  assert.equal(sourceClipTimeForPlayhead(scene, source, 9.9), null)
+  assert.equal(sourceClipTimeForPlayhead(scene, source, NaN), null)
+  assert.equal(sourceClipTimeForPlayhead(scene, {...source, authorized: false}, 11), null)
+  assert.equal(sourceClipTimeForPlayhead(scene, {...source, kind: 'image'}, 11), null)
+  assert.throws(() => sourceClipTimeForPlayhead(scene, {...source, duration_seconds: 4}, 11), /verified video length/)
+})

diff --git a/tests/frontend/video-transport.test.mjs b/tests/frontend/video-transport.test.mjs
--- a/tests/frontend/video-transport.test.mjs
+++ b/tests/frontend/video-transport.test.mjs
@@ -0,0 +1,169 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {
+  canonicalVideoId, trustedVideoPath, privateVideoUrl, privateMediaPreviewUrl,
+  parseVideoJob, createVideoTransport,
+} from '../../frontend/src/features/video/video-transport.mjs'
+
+const SHOP = '11111111-1111-4111-8111-111111111111'
+const OTHER = '44444444-4444-4444-8444-444444444444'
+const CAMPAIGN = '22222222-2222-4222-8222-222222222222'
+const JOB = '33333333-3333-4333-8333-333333333333'
+const LEASE = '55555555-5555-4555-8555-555555555555'
+const SU = 'https://example.supabase.co'
+const ORIGIN = 'https://retailgrowth-dev-functions.azurewebsites.net'
+const routes = {
+  create: campaign => '/campaigns/' + campaign + '/creative-renders',
+  status: job => '/creative-render-jobs/' + job,
+  download: job => '/creative-render-jobs/' + job + '/download',
+}
+const signed = SU + '/storage/v1/object/sign/retailgrowth-media/' +
+  SHOP + '/renders/' + JOB + '/' + LEASE + '.mp4?token=private-example'
+const draft = { version: 'rg_video_v2', shop_id: SHOP, duration_seconds: 30, scenes: [] }
+const accepted = { shop_id: SHOP, job_id: JOB, status: 'QUEUED' }
+function response(data, status = 200) {
+  return { ok: status >= 200 && status < 300, status, json: async () => data }
+}
+function fixture(fn, options = {}) {
+  return createVideoTransport({ enabled: true, baseUrl: ORIGIN,
+    tokenProvider: () => 'example-tenant-jwt',
+    fetchImpl: fn, routes, supabaseOrigin: SU, ...options })
+}
+
+test('integration client default off and strict config', () => {
+  assert.equal(createVideoTransport({}), null)
+  assert.throws(() => createVideoTransport({ enabled: true }), /routes and auth/)
+  assert.throws(() => fixture(async () => response(accepted), { baseUrl: 'http://untrusted.invalid' }), /HTTPS/)
+  assert.throws(() => fixture(async () => response(accepted), { baseUrl: ORIGIN + '/api' }), /HTTPS/)
+  assert.throws(() => fixture(async () => response(accepted), { timeoutMs: 60000 }), /timeout/)
+})
+
+test('POST sends one authenticated job intent with no service role, no retries', async () => {
+  const seen = []
+  const api = fixture(async (url, opts) => {
+    seen.push({ url, opts })
+    return response(accepted, 202)
+  })
+  const job = await api.create({ shopId: SHOP, campaignId: CAMPAIGN,
+    draft, approvalId: 'approved-feature2-copy' })
+  assert.deepEqual(job, { ...accepted, error_code: null })
+  assert.equal(seen.length, 1)
+  assert.equal(seen[0].url, ORIGIN + '/api/campaigns/' + CAMPAIGN + '/creative-renders')
+  assert.equal(seen[0].opts.headers.Authorization, 'Bearer example-tenant-jwt')
+  assert.equal(seen[0].opts.cache, 'no-store')
+  assert.equal(seen[0].opts.method, 'POST')
+  assert.equal(seen[0].opts.signal, undefined)
+  assert.deepEqual(JSON.parse(seen[0].opts.body),
+    { shop_id: SHOP, campaign_id: CAMPAIGN, approval_id: 'approved-feature2-copy', draft })
+})
+
+test('POST never retries a lost acknowledgement or transient 503', async () => {
+  let calls = 0
+  const api = fixture(async () => { calls++; throw new TypeError('network dropped after commit') })
+  await assert.rejects(() => api.create({ shopId: SHOP, campaignId: CAMPAIGN,
+    draft, approvalId: 'version1' }), /network dropped/)
+  assert.equal(calls, 1)
+  const unavailable = fixture(async () => { calls++; return response({ error: 'SERVICE_UNAVAILABLE' }, 503) })
+  await assert.rejects(() => unavailable.create({ shopId: SHOP, campaignId: CAMPAIGN,
+    draft, approvalId: 'version1' }), /Check job status before resubmitting/)
+  assert.equal(calls, 2)
+})
+
+test('reject unauthorized, misbound or fabricated job receipt', async () => {
+  for (const bad of [
+    { ...accepted, shop_id: OTHER }, { ...accepted, job_id: 'not-a-uuid' },
+    { ...accepted, status: 'FINISHED' }, { ...accepted, status: 'SUCCEEDED', shop_id: undefined },
+  ]) {
+    const api = fixture(async () => response(bad, 202))
+    await assert.rejects(() => api.create({
+      shopId: SHOP, campaignId: CAMPAIGN, draft, approvalId: 'approved'
+    }), /tenant\/status verification|canonical resource ID/)
+  }
+  await assert.rejects(() => fixture(async () => response(accepted)).create({
+    shopId: OTHER, campaignId: CAMPAIGN, draft, approvalId: 'approved',
+  }), /reviewed video draft/)
+})
+
+test('GET status binds both job and shop; requests freshly scoped JWT', async () => {
+  let count = 0
+  const api = fixture(async (url, opts) => {
+    count++
+    assert.equal(opts.method, 'GET')
+    assert.ok(opts.signal)
+    assert.equal(url, ORIGIN + '/api/creative-render-jobs/' + JOB)
+    return response({ ...accepted, status: 'RUNNING' })
+  })
+  const item = await api.status({ jobId: JOB, shopId: SHOP })
+  assert.equal(item.status, 'RUNNING')
+  assert.equal(count, 1)
+  const wrong = fixture(async () => response({ ...accepted, job_id: OTHER }))
+  await assert.rejects(() => wrong.status({ jobId: JOB, shopId: SHOP }), /requested job/)
+})
+
+test('download requires matching shop+job and signed private tenant path', async () => {
+  const api = fixture(async () => response({ ...accepted, url: signed }))
+  assert.equal(await api.download({ shopId: SHOP, jobId: JOB }), signed)
+  const invalid = fixture(async () => response({ ...accepted, shop_id: OTHER, url: signed }))
+  await assert.rejects(() => invalid.download({ shopId: SHOP, jobId: JOB }), /receipt/)
+  const wrongUrl = fixture(async () => response({
+    ...accepted, url: signed.replace(SHOP, OTHER)
+  }))
+  await assert.rejects(() => wrongUrl.download({ shopId: SHOP, jobId: JOB }), /does not belong/)
+})
+
+test('malicious signed links cannot cross tenant, job, origin or protocol', () => {
+  assert.equal(privateVideoUrl(signed, SU, SHOP, JOB), signed)
+  for (const value of [
+    signed.replace(SHOP, OTHER),
+    signed.replace(JOB, OTHER),
+    signed.replace('example.supabase.co', 'attacker.invalid'),
+    signed.replace('https:', 'http:'),
+    signed.replace('token=', 'not-token='),
+    signed.replace('/sign/', '/public/'),
+    signed + '#token-secret',
+    signed.replace('/renders/', '/renders/%2e%2e/'),
+  ]) {
+    assert.throws(() => privateVideoUrl(value, SU, SHOP, JOB), /Signed|Unsigned|private|belong|Malformed/)
+  }
+})
+
+test('unreviewed route/path and session IDs fail closed', async () => {
+  assert.equal(canonicalVideoId(SHOP), SHOP)
+  for (const id of ['aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'.toUpperCase(), 'not-a-uuid', '']) {
+    assert.throws(() => canonicalVideoId(id), /canonical/)
+  }
+  for (const path of ['//evil.invalid/render', '/api/video', '/../../admin', '/creative-renders?token=a']) {
+    assert.throws(() => trustedVideoPath(path), /Invalid/)
+  }
+  const api = fixture(async () => response(accepted), { routes: {
+    ...routes, create: () => '//attacker.invalid/v2',
+  } })
+  await assert.rejects(() => api.create({
+    shopId: SHOP, campaignId: CAMPAIGN, draft, approvalId: 'approved',
+  }), /Invalid versioned video API path/)
+})
+
+test('parse video job never accepts cross-shop result even if server says succeeded', () => {
+  assert.deepEqual(parseVideoJob({ ...accepted, status: 'SUCCEEDED' }, SHOP),
+    { ...accepted, status: 'SUCCEEDED', error_code: null })
+  assert.throws(() => parseVideoJob({ ...accepted, shop_id: OTHER }, SHOP), /tenant/)
+  assert.throws(() => parseVideoJob({ ...accepted, job_id: OTHER }, SHOP, JOB), /requested job/)
+})
+
+test('Feature4 source previews require a matching signed tenant-private Storage asset', () => {
+  const url = SU + '/storage/v1/object/sign/retailgrowth-media/' +
+    SHOP + '/products/original-kurti.png?token=short-lived'
+  assert.equal(privateMediaPreviewUrl(url, SU, SHOP), url)
+  for (const bad of [
+    url.replace(SHOP, OTHER),
+    url.replace('https://', 'http://'),
+    url.replace('/sign/', '/public/'),
+    url.replace('example.supabase.co', 'untrusted.invalid'),
+    url.replace('token=', 'not-token='),
+    url.replace('/products/', '/products/%2e%2e/'),
+    url + '#leaked',
+    'data:image/svg+xml;base64,PHN2Zz4=',
+  ]) {
+    assert.throws(() => privateMediaPreviewUrl(bad, SU, SHOP), /preview|signed|private|Storage|shop|unsafe|URL/)
+  }
+})

diff --git a/tests/media/feature4_voicestudio_cpu_render.py b/tests/media/feature4_voicestudio_cpu_render.py
--- a/tests/media/feature4_voicestudio_cpu_render.py
+++ b/tests/media/feature4_voicestudio_cpu_render.py
@@ -0,0 +1,210 @@
+#!/usr/bin/env python3
+"""CPU-only F4 narration acceptance: approved synthetic WAV -> HyperFrames -> AAC MP4.
+
+This uses the existing compiler and renderer; it does not synthesize speech or
+claim that synthetic fixture approval represents hosted tenant authorization.
+"""
+import json
+import math
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path[:0] = [str(ROOT / "video-engine"), str(ROOT / "tests" / "media")]
+from creative_contract import compile_creative_reel
+from test_feature4_narration import NarrationMediaTests
+
+def main():
+    fixture = NarrationMediaTests().fixture()
+    try:
+        # The shared narration fixture defaults to the 540x960 preview preset.
+        # Exercise the approved final-export preset before asserting Full HD.
+        fixture.request["output"].update({"width": 1080, "height": 1920, "fps": 24})
+        fixture.request["script"]["transcript"] = [
+            {"start": 0.5, "duration": 2.5, "text": "Approved synthetic caption"},
+            {"start": 14.0, "duration": 2.0, "text": "Original fixture narration"},
+        ]
+        with tempfile.TemporaryDirectory(prefix="f4-voice-cpu-") as temp:
+            project = compile_creative_reel(
+                fixture.request, fixture.manifest, fixture.assets,
+                Path(temp) / "project")
+            page = (Path(project) / "index.html").read_text(encoding="utf-8")
+            assert page.count('id="approved-voiceover"') == 1, "Narration track missing or duplicated"
+            assert page.count('class="clip spoken-caption"') == 2, "Approved caption cues missing"
+            assert 'data-track-index="5" data-volume="0.12"' in page, "Music not ducked"
+            output = Path(temp) / "reel.mp4"
+            subprocess.run(
+                ["node", str(ROOT / "video-engine" / "hyperframes" / "render.mjs"),
+                 str(project), str(output)],
+                check=True, timeout=420)
+            info = json.loads(subprocess.check_output(
+                ["ffprobe", "-v", "error", "-show_streams", "-show_format",
+                 "-of", "json", str(output)], text=True, timeout=30))
+            streams = info["streams"]
+            video = [s for s in streams if s.get("codec_type") == "video"]
+            audio = [s for s in streams if s.get("codec_type") == "audio"]
+            assert len(video) == len(audio) == 1, "Expected one video and one audio track"
+            assert video[0]["codec_name"] == "h264" and audio[0]["codec_name"] == "aac"
+            assert (int(video[0]["width"]), int(video[0]["height"])) == (1080, 1920), "Reel is not vertical Full HD"
+            assert video[0].get("pix_fmt") == "yuv420p", "Reel pixel format is not broadly playable"
+            assert video[0].get("r_frame_rate") == "24/1", "Reel frame rate drifted from approved 24 fps"
+            # Count decoded video frames, not just the advertised frame rate.
+            counted = json.loads(subprocess.check_output(
+                ["ffprobe", "-v", "error", "-select_streams", "v:0",
+                 "-count_frames", "-show_entries", "stream=nb_read_frames",
+                 "-of", "json", str(output)], text=True, timeout=60))
+            actual_frames = int(counted["streams"][0]["nb_read_frames"])
+            assert actual_frames == 30 * 24, (
+                f"Encoded Reel has {actual_frames} frames, expected 720")
+            # Probe decoded timestamps rather than trusting only nb_read_frames:
+            # a malformed concat can advertise 720 frames yet leave a large
+            # frozen/timestamp gap near the end of the narration.
+            frames = json.loads(subprocess.check_output(
+                ["ffprobe", "-v", "error", "-select_streams", "v:0",
+                 "-show_frames", "-show_entries",
+                 "frame=best_effort_timestamp_time", "-of", "json",
+                 str(output)], text=True, timeout=90))["frames"]
+            timestamps = [float(f["best_effort_timestamp_time"]) for f in frames
+                          if "best_effort_timestamp_time" in f]
+            assert len(timestamps) == 720, "Decoded video timestamp count mismatches Reel"
+            assert abs(timestamps[0]) < 0.05, "Reel starts with a video timestamp gap"
+            assert abs(timestamps[-1] - 719 / 24) < 0.05, "Reel video ends prematurely"
+            assert all(0.03 < b - a < 0.06 for a, b in zip(timestamps, timestamps[1:])), (
+                "Video frame timestamps are nonmonotonic or contain gaps")
+            assert int(audio[0]["channels"]) in (1, 2), "Unsupported AAC channel layout"
+            assert int(audio[0]["sample_rate"]) >= 8000, "Invalid AAC sample rate"
+            assert abs(float(audio[0].get("duration", info["format"]["duration"])) - 30) < 0.3, "AAC track duration mismatches Reel"
+            assert abs(float(info["format"]["duration"]) - 30) < 0.3
+            assert output.stat().st_size > 10000
+            # Decode actual AAC, not merely inspect an audio-stream header.
+            # Synthetic 350 Hz narration + 196 Hz music must produce nonzero
+            # PCM. This does not assert transcript/speech alignment.
+            pcm = subprocess.check_output(
+                ["ffmpeg", "-nostdin", "-v", "error", "-i", str(output),
+                 "-map", "0:a:0", "-t", "1", "-ac", "1", "-ar", "8000",
+                 "-f", "s16le", "-acodec", "pcm_s16le", "-"],
+                timeout=45)
+            assert len(pcm) >= 8000 * 2, "Encoded narration is truncated"
+            samples = struct.unpack("<" + "h" * (len(pcm) // 2), pcm)
+            rms = math.sqrt(sum(x * x for x in samples) / len(samples))
+            assert rms > 100, "Encoded narration/music unexpectedly silent"
+            # Reject full-scale PCM clipping in the actual decoded AAC mix.
+            # A successful mux or nonzero RMS alone can conceal a broken gain
+            # stage that saturates the licensed soundtrack and narration.
+            assert max(abs(x) for x in samples) < 32767, (
+                "Decoded VoiceStudio AAC mix clips at full-scale PCM")
+            # A mono downmix can hide opposite-polarity peaks in one AAC
+            # channel. Probe the native channel count, not an upmixed mono
+            # stream, at the beginning, caption cues, late voice and tail.
+            # A one-second opening-only check misses later mixer saturation.
+            native_channels = int(audio[0]["channels"])
+            for second, duration in ((0, 1), (5, 1), (14, 1),
+                                     (20, 1), (29, 0.8)):
+                channel_pcm = subprocess.check_output(
+                    ["ffmpeg", "-nostdin", "-v", "error", "-ss", str(second),
+                     "-i", str(output), "-map", "0:a:0", "-t", str(duration),
+                     "-ac", str(native_channels), "-ar", "8000",
+                     "-f", "s16le", "-acodec", "pcm_s16le", "-"],
+                    timeout=45)
+                expected_samples = int(8000 * duration) * native_channels
+                assert len(channel_pcm) >= expected_samples * 2, (
+                    f"Decoded native-channel AAC truncated at {second}s")
+                channel_samples = struct.unpack(
+                    "<" + "h" * (len(channel_pcm) // 2), channel_pcm)
+                for channel in range(native_channels):
+                    assert max(abs(x) for x in
+                               channel_samples[channel::native_channels]) < 32767, (
+                        f"Decoded AAC channel {channel} clips at {second}s")
+            # Verify the original narration tone is actually present in decoded
+            # AAC, rather than passing because the music bed alone is audible.
+            # The synthetic fixture uses 350 Hz narration and 196 Hz music.
+            # Integer-Hz, one-second windows make this a deterministic DFT bin.
+            def tone_magnitude(samples, frequency):
+                n = len(samples)
+                return abs(sum(
+                    sample * complex(
+                        math.cos(-2 * math.pi * frequency * i / 8000),
+                        math.sin(-2 * math.pi * frequency * i / 8000))
+                    for i, sample in enumerate(samples)
+                )) / n
+
+            narration_level = tone_magnitude(samples, 350)
+            bed_level = tone_magnitude(samples, 196)
+            assert narration_level > 100, "Approved 350 Hz narration missing from AAC"
+            assert bed_level > 5, "Licensed 196 Hz music bed missing from AAC"
+            assert narration_level > bed_level, "Music bed is not ducked below narration"
+            # Probe the approved spoken-caption windows as well as the opening.
+            # The music-only track can satisfy a generic RMS check, so require
+            # the original 350 Hz WAV to remain present in each AAC window.
+            for second in (5, 14):
+                cue_pcm = subprocess.check_output(
+                    ["ffmpeg", "-nostdin", "-v", "error", "-ss", str(second),
+                     "-i", str(output), "-map", "0:a:0", "-t", "1",
+                     "-ac", "1", "-ar", "8000", "-f", "s16le",
+                     "-acodec", "pcm_s16le", "-"], timeout=45)
+                assert len(cue_pcm) >= 8000 * 2, (
+                    f"Approved narration AAC truncated at {second}s")
+                cue_samples = struct.unpack(
+                    "<" + "h" * (len(cue_pcm) // 2), cue_pcm)
+                assert max(abs(x) for x in cue_samples) < 32767, (
+                    f"Decoded AAC clips during approved narration at {second}s")
+                assert tone_magnitude(cue_samples, 350) > 100, (
+                    f"Approved narration missing at {second}s")
+                assert tone_magnitude(cue_samples, 350) > tone_magnitude(cue_samples, 196), (
+                    f"Music masks approved narration at {second}s")
+            # Confirm audio survives into the second half of the Reel; a first-
+            # second-only PCM probe would miss truncated narration or a mixer
+            # that silently drops the approved voiceover after the opening.
+            late_pcm = subprocess.check_output(
+                ["ffmpeg", "-nostdin", "-v", "error", "-ss", "20",
+                 "-i", str(output), "-map", "0:a:0", "-t", "1",
+                 "-ac", "1", "-ar", "8000", "-f", "s16le",
+                 "-acodec", "pcm_s16le", "-"], timeout=45)
+            assert len(late_pcm) >= 8000 * 2, "Late narration audio is truncated"
+            late_samples = struct.unpack("<" + "h" * (len(late_pcm) // 2), late_pcm)
+            late_rms = math.sqrt(sum(x * x for x in late_samples) / len(late_samples))
+            assert late_rms > 100, "Encoded narration/music silent at 20 seconds"
+            assert max(abs(x) for x in late_samples) < 32767, (
+                "Decoded AAC clips during late approved narration")
+            late_narration = tone_magnitude(late_samples, 350)
+            late_bed = tone_magnitude(late_samples, 196)
+            assert late_narration > 100, "Approved narration disappeared before 20 seconds"
+            assert late_bed > 5, "Music bed disappeared before 20 seconds"
+            assert late_narration > late_bed, "Late music masks approved narration"
+            # End-of-reel verification catches an AAC muxer that truncates the
+            # approved track after the mid-reel probe, despite valid duration
+            # metadata. Use the same synthetic frequency separation at 29s.
+            tail_pcm = subprocess.check_output(
+                ["ffmpeg", "-nostdin", "-v", "error", "-ss", "29",
+                 "-i", str(output), "-map", "0:a:0", "-t", "0.8",
+                 "-ac", "1", "-ar", "8000", "-f", "s16le",
+                 "-acodec", "pcm_s16le", "-"], timeout=45)
+            assert len(tail_pcm) >= 6000 * 2, "Final AAC narration is truncated"
+            tail_samples = struct.unpack("<" + "h" * (len(tail_pcm) // 2), tail_pcm)
+            assert max(abs(x) for x in tail_samples) < 32767, (
+                "Decoded AAC clips near final Reel frame")
+            assert tone_magnitude(tail_samples, 350) > 100, "Approved narration missing at Reel end"
+            assert tone_magnitude(tail_samples, 196) > 5, "Music bed missing at Reel end"
+            assert tone_magnitude(tail_samples, 350) > tone_magnitude(tail_samples, 196), "End music masks narration"
+            # Decode the actual encoded portrait frames at the beginning and
+            # near the end. Container metadata alone cannot prove that the
+            # video track is decodable for the full approved narration span.
+            for second in (1, 15, 29):
+                frame = subprocess.check_output(
+                    ["ffmpeg", "-nostdin", "-v", "error", "-ss", str(second),
+                     "-i", str(output), "-map", "0:v:0", "-frames:v", "1",
+                     "-vf", "scale=32:56,format=gray", "-f", "rawvideo", "-"],
+                    timeout=45)
+                assert len(frame) == 32 * 56, (
+                    f"Missing or undecodable portrait video frame at {second}s")
+                assert max(frame) - min(frame) >= 5, (
+                    f"Near-uniform encoded video frame at {second}s")
+            print("PASS: original approved synthetic PCM narration + music/captions encoded by existing HyperFrames CPU renderer")
+    finally:
+        fixture.root_tmp.cleanup()
+
+if __name__ == "__main__":
+    main()

