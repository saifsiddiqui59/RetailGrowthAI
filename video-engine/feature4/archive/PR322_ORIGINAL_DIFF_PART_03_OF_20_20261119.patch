diff --git a/frontend/src/features/video/video-transport.mjs b/frontend/src/features/video/video-transport.mjs
--- a/frontend/src/features/video/video-transport.mjs
+++ b/frontend/src/features/video/video-transport.mjs
@@ -0,0 +1,191 @@
+// Feature #4 authenticated browser-to-backend transport. Additive, DEFAULT OFF.
+// The coordinator supplies versioned v2 route builders only after registering
+// authorized Azure HTTP routes and service-only claim/ledger methods.
+// Never call the existing v1 /campaigns/:id/renders endpoint with a v2 draft.
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+const FINISHED = new Set(['SUCCEEDED', 'FAILED'])
+const STATES = new Set(['QUEUED', 'RUNNING', ...FINISHED])
+const PATH = /^\/(?:[a-zA-Z0-9_-]+\/)*[a-zA-Z0-9_-]+$/
+
+export function canonicalVideoId(value) {
+  if (typeof value !== 'string' || !UUID.test(value) || value.toLowerCase() !== value) {
+    throw Error('Expected a canonical resource ID')
+  }
+  return value
+}
+
+export function trustedVideoPath(path) {
+  if (typeof path !== 'string' || !PATH.test(path) || path.includes('..') ||
+      path.startsWith('//') || path.startsWith('/api/')) {
+    throw Error('Invalid versioned video API path')
+  }
+  return '/api' + path
+}
+
+export function privateVideoUrl(value, supabaseOrigin, shopId, jobId) {
+  const shop = canonicalVideoId(shopId)
+  const job = canonicalVideoId(jobId)
+  if (typeof value !== 'string' || !value || !supabaseOrigin) {
+    throw Error('Private video download was not returned')
+  }
+  let url, trusted
+  try {
+    url = new URL(value)
+    trusted = new URL(supabaseOrigin)
+  } catch { throw Error('Invalid private video URL') }
+  if (url.origin !== trusted.origin || url.protocol !== 'https:' || url.username ||
+      url.password || url.hash || !url.searchParams.get('token') ||
+      trusted.protocol !== 'https:' || trusted.username || trusted.password) {
+    throw Error('Unsigned or untrusted video URL')
+  }
+  // The v2 private worker stores tenant/job/lease.mp4 in the existing bucket.
+  // Ignore neither the shop nor job ID: a valid token for some other tenant
+  // is not a valid result for the active editor.
+  const prefix = '/storage/v1/object/sign/retailgrowth-media/'
+  if (!url.pathname.startsWith(prefix)) throw Error('Not a signed private media object')
+  let objectKey
+  try { objectKey = decodeURIComponent(url.pathname.slice(prefix.length)) }
+  catch { throw Error('Malformed signed media path') }
+  if (!new RegExp('^' + shop + '/renders/' + job + '/[0-9a-f-]{36}\\.mp4$').test(objectKey) ||
+      objectKey.includes('//') || objectKey.includes('..')) {
+    throw Error('Signed video does not belong to the selected render job')
+  }
+  return url.toString()
+}
+
+export function privateMediaPreviewUrl(value, supabaseOrigin, shopId) {
+  const shop = canonicalVideoId(shopId)
+  if (typeof value !== 'string' || typeof supabaseOrigin !== 'string') {
+    throw Error('Private source preview is unavailable')
+  }
+  let url, trusted
+  try {
+    url = new URL(value)
+    trusted = new URL(supabaseOrigin)
+  } catch { throw Error('Private source preview URL invalid') }
+  if (url.protocol !== 'https:' || trusted.protocol !== 'https:' ||
+      url.origin !== trusted.origin || url.username || url.password ||
+      url.hash || !url.searchParams.get('token')) {
+    throw Error('Source preview must have a tenant-private signed URL')
+  }
+  const prefix = '/storage/v1/object/sign/retailgrowth-media/'
+  if (!url.pathname.startsWith(prefix)) throw Error('Source preview is not private Storage media')
+  let path
+  try { path = decodeURIComponent(url.pathname.slice(prefix.length)) }
+  catch { throw Error('Malformed private preview path') }
+  const parts = path.split('/')
+  if (parts[0] !== shop || parts.length < 3 ||
+      parts.some(part => !part || part === '.' || part === '..') ||
+      path.includes('\\') || path.includes('%') ||
+      !/^[a-zA-Z0-9._/-]+$/.test(path)) {
+    throw Error('Source preview belongs to another shop or unsafe path')
+  }
+  return url.toString()
+}
+
+export function parseVideoJob(data, shopId, expectedId = null) {
+  const shop = canonicalVideoId(shopId)
+  if (data === null || typeof data !== 'object' || Array.isArray(data) ||
+      data.shop_id !== shop || !STATES.has(data.status)) {
+    throw Error('Video job response failed tenant/status verification')
+  }
+  const id = canonicalVideoId(data.job_id)
+  if (expectedId && id !== canonicalVideoId(expectedId)) {
+    throw Error('Video job response did not match the requested job')
+  }
+  return { job_id: id, shop_id: shop, status: data.status,
+    error_code: typeof data.error_code === 'string' ? data.error_code.slice(0, 70) : null }
+}
+
+export function createVideoTransport({ enabled = false, baseUrl, tokenProvider, fetchImpl = fetch,
+  routes, supabaseOrigin, timeoutMs = 12000 }) {
+  if (enabled !== true) return null
+  if (typeof tokenProvider !== 'function' || typeof fetchImpl !== 'function' ||
+      !routes || typeof routes.create !== 'function' ||
+      typeof routes.status !== 'function' || typeof routes.download !== 'function') {
+    throw Error('Versioned, coordinator-approved video routes and auth are required')
+  }
+  if (!Number.isInteger(timeoutMs) || timeoutMs < 500 || timeoutMs > 30000) {
+    throw Error('Invalid video GET timeout')
+  }
+  let origin
+  try {
+    const u = new URL(baseUrl)
+    if (u.protocol !== 'https:' || u.username || u.password || u.pathname !== '/' ||
+        u.search || u.hash) throw Error()
+    origin = u.origin
+  } catch { throw Error('Video backend must be a bare HTTPS origin') }
+
+  async function request(method, path, payload, signal) {
+    const token = await tokenProvider()
+    if (typeof token !== 'string' || token.length < 10 || /[\s\r\n]/.test(token)) {
+      throw Error('Sign in to your business before using Video Studio')
+    }
+    const endpoint = origin + trustedVideoPath(path)
+    // Mutating POST is intentionally NEVER timed out and NEVER retried here:
+    // Azure may have committed it without returning the acknowledgement.
+    // GET can be retried manually by polling; no automatic cross-tenant fallback.
+    const controller = method === 'GET' ? new AbortController() : null
+    const timer = controller ? setTimeout(() => controller.abort(), timeoutMs) : null
+    function abortParent() { controller?.abort() }
+    if (signal?.aborted) throw Error('Video request cancelled')
+    if (signal && controller) signal.addEventListener('abort', abortParent, { once: true })
+    try {
+      const response = await fetchImpl(endpoint, {
+        method, redirect: 'error', cache: 'no-store',
+        headers: { Authorization: 'Bearer ' + token,
+          ...(payload === undefined ? {} : { 'Content-Type': 'application/json' }) },
+        ...(payload === undefined ? {} : { body: JSON.stringify(payload) }),
+        ...(controller ? { signal: controller.signal } : {}),
+      })
+      if (!response || typeof response.ok !== 'boolean') throw Error('Invalid video service response')
+      const data = await response.json().catch(() => null)
+      if (!response.ok) {
+        const err = new Error(response.status === 401 ? 'Your session expired. Sign in again.' :
+          response.status === 403 || response.status === 404 ? 'This video is not available to your business.' :
+          response.status === 402 || response.status === 429 ? 'Video plan or usage quota does not allow this job.' :
+          response.status === 503 ? 'Video service unavailable. Check job status before resubmitting.' :
+          'Video request failed. Check job status before resubmitting.')
+        err.status = response.status
+        throw err
+      }
+      return { data, status: response.status }
+    } finally {
+      if (timer !== null) clearTimeout(timer)
+      if (signal && controller) signal.removeEventListener('abort', abortParent)
+    }
+  }
+
+  return Object.freeze({
+    async create({ shopId, campaignId, draft, approvalId }) {
+      const shop = canonicalVideoId(shopId)
+      const campaign = canonicalVideoId(campaignId)
+      if (!draft || typeof draft !== 'object' || draft.shop_id !== shop ||
+          draft.version !== 'rg_video_v2' || typeof approvalId !== 'string' ||
+          !/^[a-zA-Z0-9_-]{1,100}$/.test(approvalId)) {
+        throw Error('Authenticated, reviewed video draft is required')
+      }
+      // This is an intent to create. The backend MUST reconstruct the
+      // approved creative_reel_v1 request from saved DB media/script/revision.
+      const out = await request('POST', routes.create(campaign),
+        { shop_id: shop, campaign_id: campaign, approval_id: approvalId, draft })
+      if (out.status !== 202 && out.status !== 200) {
+        throw Error('Render job was not acknowledged')
+      }
+      return parseVideoJob(out.data, shop)
+    },
+    async status({ jobId, shopId, signal }) {
+      const job = canonicalVideoId(jobId)
+      const out = await request('GET', routes.status(job), undefined, signal)
+      return parseVideoJob(out.data, shopId, job)
+    },
+    async download({ jobId, shopId, signal }) {
+      const job = canonicalVideoId(jobId)
+      const out = await request('GET', routes.download(job), undefined, signal)
+      if (out.data?.job_id !== job || out.data?.shop_id !== canonicalVideoId(shopId)) {
+        throw Error('Download receipt did not match active business and job')
+      }
+      return privateVideoUrl(out.data?.url, supabaseOrigin, shopId, job)
+    },
+  })
+}

diff --git a/tests/frontend/feature4-audio-mix-display.test.mjs b/tests/frontend/feature4-audio-mix-display.test.mjs
--- a/tests/frontend/feature4-audio-mix-display.test.mjs
+++ b/tests/frontend/feature4-audio-mix-display.test.mjs
@@ -0,0 +1,72 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { fixedAudioMixDisplay } from '../../frontend/src/features/video/audio-mix-display.mjs'
+
+const SHOP = '11111111-1111-4111-8111-111111111111'
+const OTHER = '22222222-2222-4222-8222-222222222222'
+const music = [{id:'song',shop_id:SHOP,kind:'audio',authorized:true},
+  {id:'voice',shop_id:SHOP,kind:'audio',authorized:true}]
+const media = [{id:'photo',shop_id:SHOP,kind:'image',authorized:true},
+  {id:'clip',shop_id:SHOP,kind:'video',authorized:true},
+  {id:'foreign',shop_id:OTHER,kind:'video',authorized:true}]
+const draft = (scene = {asset_id:'photo'}) => ({
+  shop_id:SHOP,music_asset_id:'song',voiceover_asset_id:null,
+  scenes:[scene],duration_seconds:30,
+})
+
+test('silent/still-only mix is fixed at renderer 55%, never editable', () => {
+  const result = fixedAudioMixDisplay(draft(),media,music)
+  assert.equal(result.music,true)
+  assert.equal(result.musicGain,0.55)
+  assert.equal(result.musicGainVerifiedByBrowser,false)
+  assert.equal(result.musicGainUnknownUntilServerProbe,false)
+  assert.equal(result.sceneSfxGain,0.25)
+  assert.equal(result.sceneSfxMaximumSeconds,2)
+})
+
+test('narration forces renderer 12% bed, independent of video source sound', () => {
+  for(const scene of [{asset_id:'photo'},{asset_id:'clip'}]){
+    const result = fixedAudioMixDisplay({...draft(scene),voiceover_asset_id:'voice'},media,music)
+    assert.equal(result.narration,true)
+    assert.equal(result.narrationGain,1)
+    assert.equal(result.musicGain,0.12)
+  }
+})
+
+test('unmuted video makes browser music gain unknown until trusted ffprobe', () => {
+  const result = fixedAudioMixDisplay(draft({asset_id:'clip'}),media,music)
+  assert.equal(result.musicGain,null)
+  assert.equal(result.musicGainUnknownUntilServerProbe,true)
+  assert.equal(result.musicGainVerifiedByBrowser,false)
+})
+
+test('muted approved video is known, but foreign/revoked visuals deny gain claims', () => {
+  assert.equal(fixedAudioMixDisplay(draft({asset_id:'clip',mute_source:true}),media,music).musicGain,0.55)
+  for(const result of [
+    fixedAudioMixDisplay(draft({asset_id:'foreign'}),media,music),
+    fixedAudioMixDisplay(draft({asset_id:'clip'}),media.map(a=>a.id==='clip'?{...a,authorized:false}:a),music),
+    fixedAudioMixDisplay(draft({asset_id:'missing'}),media,music),
+  ]){
+    assert.equal(result.musicGain,null)
+    assert.equal(result.musicGainBlockedByMedia,true)
+    assert.equal(result.musicGainUnknownUntilServerProbe,false)
+  }
+})
+
+test('foreign or revoked audio never yields an apparent licensed gain', () => {
+  for(const row of [{...music[0],shop_id:OTHER},{...music[0],authorized:false}]){
+    const result = fixedAudioMixDisplay(draft(),media,[row,music[1]])
+    assert.equal(result.music,false)
+    assert.equal(result.musicGain,null)
+    assert.equal(result.musicGainUnknownUntilServerProbe,false)
+  }
+  assert.equal(fixedAudioMixDisplay({...draft(),voiceover_asset_id:'voice'},media,
+    [{...music[0]},{...music[1],shop_id:OTHER}]).narration,false)
+})
+
+test('absence of a soundtrack is distinct from unknown soundtrack gain', () => {
+  const result = fixedAudioMixDisplay({...draft({asset_id:'clip'}),music_asset_id:null},media,music)
+  assert.equal(result.music,false)
+  assert.equal(result.musicGain,null)
+  assert.equal(result.musicGainUnknownUntilServerProbe,false)
+})

diff --git a/tests/frontend/feature4-beat-preview.test.mjs b/tests/frontend/feature4-beat-preview.test.mjs
--- a/tests/frontend/feature4-beat-preview.test.mjs
+++ b/tests/frontend/feature4-beat-preview.test.mjs
@@ -0,0 +1,27 @@
+// Display-only beat markers are bounded, millisecond-precise and tenant-scoped.
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import {proposedBeatMarkers} from '../../frontend/src/features/video/beat-preview.mjs'
+const SHOP='11111111-1111-4111-8111-111111111111'
+const plan={shop_id:SHOP,mode:'music_sync',duration_seconds:30,
+            music_asset_id:'music01',beats:[1,2.125,5.01,10.01,15.01]}
+const music=[{id:'music01',shop_id:SHOP,kind:'audio',authorized:true}]
+test('valid same-shop measured beat proposals retain source millisecond precision',()=>{
+  assert.deepEqual(proposedBeatMarkers(plan,music),plan.beats)
+})
+test('forged, foreign, unlicensed or out of range beat proposals are hidden',()=>{
+  for(const wrong of [
+    [], [{...music[0],shop_id:'foreign'}],
+    [{...music[0],authorized:false}], [{...music[0],kind:'image'}],
+  ]) assert.deepEqual(proposedBeatMarkers(plan,wrong),[])
+  for(const beats of [[5,5],[5,4],[5,31],[NaN,5],[1.0001,5],[]])
+    assert.deepEqual(proposedBeatMarkers({...plan,beats},music),[])
+  assert.deepEqual(proposedBeatMarkers({...plan,mode:'media'},music),[])
+})
+test('a 60-second track never renders more than 120 preview markers',()=>{
+  const beats=Array.from({length:240},(_,i)=>i*.25)
+  const markers=proposedBeatMarkers({...plan,duration_seconds:60,beats},music)
+  assert.equal(markers.length,120)
+  assert.equal(markers[0],0)
+  assert.equal(markers[1],.5)
+})

diff --git a/tests/frontend/feature4-frame-seek.test.mjs b/tests/frontend/feature4-frame-seek.test.mjs
--- a/tests/frontend/feature4-frame-seek.test.mjs
+++ b/tests/frontend/feature4-frame-seek.test.mjs
@@ -0,0 +1,35 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { boundedFrameSeek, boundedSceneMidpointSeek } from '../../frontend/src/features/video/frame-seek.mjs'
+
+test('F4-08 seek clamps to approved duration and whole frames', () => {
+  assert.equal(boundedFrameSeek(-10, 30, 24), 0)
+  assert.equal(boundedFrameSeek(99, 30, 24), 30)
+  assert.equal(boundedFrameSeek(1 / 24, 30, 24), 1 / 24)
+  assert.equal(boundedFrameSeek(0.08, 30, 30), 2 / 30)
+  assert.equal(boundedFrameSeek(10.05, 10.05, 24), 10.041666666666666)
+})
+test('F4-08 rejects nonfinite and malformed seeks instead of poisoning playhead', () => {
+  for (const value of [NaN, Infinity, -Infinity, undefined, null, '12', {}]) {
+    assert.equal(boundedFrameSeek(value, 30, 24), null)
+  }
+  for (const duration of [0, -1, NaN, Infinity, '30']) {
+    assert.equal(boundedFrameSeek(1, duration, 24), null)
+  }
+  assert.equal(boundedFrameSeek(1, 30, 0), null)
+  assert.equal(boundedFrameSeek(1, 30, 60), null)
+})
+
+test('F4-08 scene and caption clicks resolve to finite bounded frames', () => {
+  assert.equal(boundedSceneMidpointSeek(0, 5, 30, 24), 2.5)
+  assert.equal(boundedSceneMidpointSeek(4, 3, 30, 30), 5.5)
+  assert.equal(boundedSceneMidpointSeek(29, 1, 30, 24), 29.5)
+  assert.equal(boundedFrameSeek(1.08, 30, 24), 26 / 24)
+})
+test('F4-08 rejects malformed or crossing scene spans', () => {
+  for (const [start, length, duration] of [
+    [NaN, 3, 30], [0, Infinity, 30], [-1, 2, 30],
+    [0, 0, 30], [30, 1, 30], [29, 2, 30],
+    [0, 3, Infinity], [0, 3, 0], ['1', 2, 30],
+  ]) assert.equal(boundedSceneMidpointSeek(start, length, duration, 24), null)
+})

diff --git a/tests/frontend/feature4-history-bounds.test.mjs b/tests/frontend/feature4-history-bounds.test.mjs
--- a/tests/frontend/feature4-history-bounds.test.mjs
+++ b/tests/frontend/feature4-history-bounds.test.mjs
@@ -0,0 +1,54 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {
+  createEditorHistory, pushEditorHistory, undoEditorHistory, redoEditorHistory,
+} from '../../frontend/src/features/video/vendor/editorHistoryCore.mjs'
+
+test('F4-09: adapted timeline undo retains only the last 50 snapshots', () => {
+  let history = createEditorHistory({ frame: 0 })
+  for (let frame = 1; frame <= 150; frame++)
+    history = pushEditorHistory(history, { frame })
+  assert.equal(history.past.length, 50)
+  assert.equal(history.past[0].frame, 100)
+  assert.equal(history.current.frame, 150)
+  for (let i = 0; i < 50; i++) {
+    const result = undoEditorHistory(history)
+    assert.equal(result.changed, true)
+    history = result.history
+  }
+  assert.equal(history.current.frame, 100)
+  assert.equal(undoEditorHistory(history).changed, false)
+  for (let i = 0; i < 50; i++) history = redoEditorHistory(history).history
+  assert.equal(history.current.frame, 150)
+  assert.equal(redoEditorHistory(history).changed, false)
+})
+
+test('F4-09: invalid/unbounded custom history limits fail to bounded defaults', () => {
+  for (const limit of [NaN, Infinity, -Infinity, 'not-a-number']) {
+    let history = createEditorHistory({ frame: 0 })
+    for (let frame = 1; frame <= 80; frame++)
+      history = pushEditorHistory(history, { frame }, limit)
+    assert.equal(history.past.length, 50, String(limit))
+  }
+  let limited = createEditorHistory({ frame: 0 })
+  for (let frame = 1; frame <= 10; frame++)
+    limited = pushEditorHistory(limited, { frame }, 0)
+  assert.equal(limited.past.length, 1)
+  limited = createEditorHistory({ frame: 0 })
+  for (let frame = 1; frame <= 10; frame++)
+    limited = pushEditorHistory(limited, { frame }, 2.9)
+  assert.equal(limited.past.length, 2)
+})
+
+test('F4-09: upstream history branching clears redo even for a same-reference edit', () => {
+  const first = { frame: 0 }
+  const second = { frame: 1 }
+  const history = pushEditorHistory(createEditorHistory(first), second)
+  const undone = undoEditorHistory(history).history
+  assert.equal(redoEditorHistory(undone).value, second)
+  const branch = pushEditorHistory(undone, first)
+  assert.equal(branch.current, first)
+  assert.equal(branch.future.length, 0)
+  assert.equal(redoEditorHistory(branch).changed, false)
+  assert.equal(history.current, second)
+})

diff --git a/tests/frontend/timeline-studio-adoption.test.mjs b/tests/frontend/timeline-studio-adoption.test.mjs
--- a/tests/frontend/timeline-studio-adoption.test.mjs
+++ b/tests/frontend/timeline-studio-adoption.test.mjs
@@ -0,0 +1,422 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { studioRanges, studioSplit, studioDuplicate, studioReorder, studioTrimPair, studioSourceTrim, studioValidatedDraft } from '../../frontend/src/features/video/timeline-studio-bridge.mjs'
+import { inspectCreativeDirection, checkedPreviewCaptionCues } from '../../frontend/src/features/video/creative-direction-adapter.mjs'
+import { createEditorHistory, pushEditorHistory, undoEditorHistory, redoEditorHistory } from '../../frontend/src/features/video/vendor/editorHistoryCore.mjs'
+import { packTimedSegmentsIntoLanes, materializeCaptionTimings, getVisualSegmentTimeline } from '../../frontend/src/features/video/vendor/timeline.js'
+import { getTimelineRulerTicks, getTimelineAutoFitZoom } from '../../frontend/src/features/video/vendor/timelineScale.js'
+import { makeVideoDraft, compatibleMedia, validateVideoDraft, sourceClipPlaybackWindow } from '../../frontend/src/features/video/video-model.mjs'
+
+const SHOP='11111111-1111-4111-8111-111111111111'
+const OTHER='22222222-2222-4222-8222-222222222222'
+const assets=[
+ {id:'photo1',kind:'image',shop_id:SHOP,authorized:true,name:'Reviewed kurti'},
+ {id:'motion1',kind:'video',shop_id:SHOP,authorized:true,name:'Mocked Feature5 motion'},
+ {id:'poster1',kind:'poster',shop_id:SHOP,authorized:true,name:'Reviewed poster'},
+ {id:'forbidden',kind:'video',shop_id:OTHER,authorized:true},
+ {id:'revoked',kind:'video',shop_id:SHOP,authorized:false},
+]
+const music=[{id:'licensed_music',kind:'audio',authorized:true,shop_id:SHOP}]
+function draft(){
+ const d=makeVideoDraft({shopId:SHOP,mode:'media',duration:30,mediaAssets:assets})
+ d.scenes[0].asset_id='photo1'
+ d.scenes[1].asset_id='motion1'
+ d.scenes[2].asset_id='poster1'
+ d.scenes[1].headline='Approved model movement'
+ d.scenes[1].offer='20% OFF'
+ d.music_asset_id='licensed_music'
+ return d
+}
+
+test('real upstream timeline geometry, caption lanes and zoom work on approved ad',()=>{
+ const d=draft()
+ assert.deepEqual(studioRanges(d).map(s=>[s.start,s.end]),[[0,10],[10,20],[20,30]])
+ assert.equal(getVisualSegmentTimeline(d.scenes).at(-1).end,30)
+ const zoom=getTimelineAutoFitZoom(30)
+ const ticks=getTimelineRulerTicks(30,zoom,0,30)
+ assert.ok(ticks.some(t=>t.isMajor))
+ const captions=materializeCaptionTimings(d.scenes.map(s=>({text:s.headline,start:s.start,end:s.start+s.duration})),30)
+ assert.deepEqual(captions.map(s=>s.start),[0,10,20])
+ assert.equal(packTimedSegmentsIntoLanes(captions.map((s,i)=>({...s,id:'caption'+i,duration:s.end-s.start}))).length,1)
+})
+
+test('Timeline Studio real upstream splitter preserves exact retailer offer and sound source',()=>{
+ const d=draft()
+ const out=studioSplit(d,1,4,assets)
+ assert.equal(out.scenes.length,4)
+ assert.deepEqual(out.scenes.map(s=>s.start),[0,10,14,20])
+ assert.deepEqual(out.scenes.map(s=>s.duration),[10,4,6,10])
+ assert.equal(out.scenes[1].offer,'20% OFF')
+ assert.equal(out.scenes[2].offer,'20% OFF')
+ assert.equal(out.scenes[1].asset_id,'motion1')
+ assert.equal(out.scenes[2].asset_id,'motion1')
+ assert.equal(out.scenes[2].trim_start,4)
+ assert.equal(out.scenes[2].headline,'Approved model movement')
+ assert.deepEqual(validateVideoDraft(out,assets,music),[])
+ assert.deepEqual(d.scenes.map(s=>s.duration),[10,10,10],'original draft stays immutable')
+})
+
+test('split after a source trim keeps playback offsets, not fake footage generation',()=>{
