+            Path(output).write_bytes(b"ours-before-replacement"*4)
+            return {"status":"PRIVATE_AUDIO_MASTERED_NOT_PUBLISHED",
+                    "source_audio_mean_db":-28.0,"mastered_audio_mean_db":-16.0}
