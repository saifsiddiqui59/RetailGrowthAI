--- a/video-engine/hyperframes/benchmark_render.py
+++ b/video-engine/hyperframes/benchmark_render.py
@@ -0,0 +1,222 @@
+#!/usr/bin/env python3
+"""Low-cost, source-only HyperFrames CPU benchmark for synthetic CI assets.
+
+Measures the actual render.mjs invocation on a Linux runner. Sampled RSS/CPU
+are lower-bound observations, not guaranteed peaks, Azure prices or capacity
+claims. Never accepts arbitrary commands or tenant HTML.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import signal
+import stat
+import subprocess
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parent
+NODE_SCRIPT = ROOT / "render.mjs"
+
+
+def parse_proc_stat(raw):
+    """Parse Linux /proc/PID/stat including process names with parentheses."""
+    try:
+        cut = raw.rfind(") ")
+        if cut < 0:
+            return None
+        pid = int(raw[:raw.find(" (")])
+        fields = raw[cut + 2:].split()
+        if len(fields) < 22:
+            return None
+        return (pid, int(fields[1]), int(fields[2]),
+                int(fields[11]) + int(fields[12]), max(0, int(fields[21])))
+    except (ValueError, IndexError):
+        return None
+
+
+def sample_process_group(pgid, *, proc_root=Path("/proc")):
+    """Sum sampled RSS/CPU for a new private session and descendants."""
+    if not proc_root.is_dir():
+        return (0, 0, 0)
+    records = {}
+    for child in proc_root.iterdir():
+        if not child.name.isdecimal():
+            continue
+        try:
+            stat = parse_proc_stat((child / "stat").read_text())
+            if stat is not None:
+                records[stat[0]] = stat
+        except (OSError, UnicodeError):
+            continue
+    active = {pid for pid, stat in records.items() if stat[2] == pgid}
+    active.add(pgid)
+    for _ in range(len(records)):
+        extra = {pid for pid, stat in records.items() if stat[1] in active}
+        if extra <= active:
+            break
+        active.update(extra)
+    page = os.sysconf("SC_PAGE_SIZE")
+    rss = sum(stat[4] * page for pid, stat in records.items() if pid in active)
+    ticks = sum(stat[3] for pid, stat in records.items() if pid in active)
+    return rss, ticks, len(active & records.keys())
+
+
+def verified_output_sha256(path):
+    """Hash exactly one stable regular render file, rejecting symlink swaps.
+
+    The hash binds a *local synthetic benchmark receipt* to the encoded bytes
+    actually left on disk; not cloud artifact custody or a rights approval.
+    """
+    try:
+        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+        with os.fdopen(fd, "rb") as source:
+            before = os.fstat(source.fileno())
+            if not stat.S_ISREG(before.st_mode) or before.st_size < 1024:
+                raise ValueError("Expected nonempty regular encoded benchmark output")
+            digest = hashlib.sha256()
+            for block in iter(lambda: source.read(1024 * 1024), b""):
+                digest.update(block)
+            after = os.fstat(source.fileno())
+            if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
+                    after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
+                raise ValueError("Benchmark output changed while hashing")
+            # The path itself must still refer to that file, not a late swap.
+            current = os.lstat(path)
+            if (not stat.S_ISREG(current.st_mode) or
+                    current.st_dev != after.st_dev or
+                    current.st_ino != after.st_ino or
+                    current.st_size != after.st_size):
+                raise ValueError("Benchmark output path changed")
+            return after.st_size, digest.hexdigest()
+    except OSError as exc:
+        raise ValueError("Benchmark output could not be safely hashed") from exc
+
+
+def benchmark(project, output, report, *, timeout_seconds=420, use_npm_node22=False,
+              sampling_interval=0.2):
+    if type(timeout_seconds) is not int or not 20 <= timeout_seconds <= 780:
+        raise ValueError("Bounded render timeout must be 20..780 seconds")
+    project, output, report = Path(project), Path(output), Path(report)
+    config = json.loads((project / "render-config.json").read_text())
+    if (config.get("contract_version") != "rg_video_v2" or
+            config.get("renderer") != "hyperframes" or
+            config.get("duration_seconds") not in (15, 30, 60) or
+            (config.get("width"), config.get("height")) not in ((540, 960), (1080, 1920)) or
+            config.get("fps") not in (24, 30) or output.suffix != ".mp4"):
+        raise ValueError("Expected an existing approved local HyperFrames composition")
+    if report.suffix != ".json" or report == output:
+        raise ValueError("Expected separate JSON performance evidence file")
+    if output.exists() or output.is_symlink() or report.exists() or report.is_symlink():
+        raise ValueError("Benchmark output and report destinations must be new")
+    command = (["npm", "exec", "--yes", "--package=node@22", "--", "node"] if use_npm_node22
+               else ["node"]) + [str(NODE_SCRIPT), str(project), str(output)]
+    started = time.monotonic()
+    samples = 0
+    max_rss, max_ticks, max_processes = 0, 0, 0
+    timed_out = False
+    with tempfile.TemporaryFile() as stdout, tempfile.TemporaryFile() as stderr:
+        process = subprocess.Popen(
+            command, stdout=stdout, stderr=stderr, start_new_session=True,
+            cwd=ROOT,
+        )
+        try:
+            while process.poll() is None:
+                rss, ticks, count = sample_process_group(process.pid)
+                samples += 1
+                max_rss = max(max_rss, rss)
+                max_ticks = max(max_ticks, ticks)
+                max_processes = max(max_processes, count)
+                if time.monotonic() - started > timeout_seconds:
+                    timed_out = True
+                    try:
+                        os.killpg(process.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    break
+                time.sleep(sampling_interval)
+            process.wait(timeout=15)
+        finally:
+            if process.poll() is None:
+                try:
+                    os.killpg(process.pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+                process.wait(timeout=15)
+    if timed_out:
+        raise RuntimeError("Bounded local HyperFrames render exceeded timeout")
+    if process.returncode != 0 or not output.is_file():
+        raise RuntimeError("Local HyperFrames render failed; inspect restricted CI job output")
+    output_bytes, output_sha256 = verified_output_sha256(output)
+    ticks_per_second = os.sysconf("SC_CLK_TCK")
+    report_data = {
+        "kind": "OFFLINE_SYNTHETIC_HYPERFRAMES_CPU_BENCHMARK_NOT_AZURE",
+        "cloud_or_gpu_inference": False,
+        "measured_on_azure_functions": False,
+        "commercial_visual_quality_accepted": False,
+        "duration_seconds": config["duration_seconds"],
+        "width": config["width"],
+        "height": config["height"],
+        "fps": config["fps"],
+        "output_bytes": output_bytes,
+        "output_sha256": output_sha256,
+        # Declared current Git checkout, not a signed CI provenance attestation.
+        "source_commit_claim": subprocess.check_output(
+            ["git", "-C", str(ROOT.parents[1]), "rev-parse", "--verify", "HEAD"],
+            text=True, timeout=5).strip(),
+        "output_hash_type": "SHA256_STABLE_LOCAL_REGULAR_FILE_ONLY",
+        "runtime_platform": platform.platform(),
+        "cpu_count_visible": os.cpu_count(),
+        "wall_seconds": round(time.monotonic() - started, 3),
+        "max_sampled_process_tree_rss_bytes": max_rss,
+        "max_sampled_cpu_seconds_lower_bound": round(max_ticks / ticks_per_second, 3),
+        "max_observed_process_count": max_processes,
+        "samples": samples,
+        "sampling_interval_seconds": sampling_interval,
+        "sampling_limitations": (
+            "Linux /proc periodic samples: short peaks, exited processes and "
+            "detached Chromium/FFmpeg helpers may be missed. CPU is a sampled lower bound."
+        ),
+        "host_timeout_seconds_reference_only": 1200,
+        "render_cap_seconds_reference_only": 780,
+        "azure_cost_inr": None,
+        "azure_runtime_memory_verified": False,
+        "package_lock_present_in_workspace": (ROOT / "package-lock.json").is_file(),
+        "package_lock_tracked_in_git": subprocess.run(
+            ["git", "-C", str(ROOT.parents[1]), "ls-files", "--error-unmatch",
+             "video-engine/hyperframes/package-lock.json"],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
+            check=False,
+        ).returncode == 0,
+    }
+    report.parent.mkdir(parents=True, exist_ok=True)
+    # Keep the benchmark receipt from overwriting another job's proof.
+    with report.open("x", encoding="utf-8") as handle:
+        handle.write(json.dumps(report_data, indent=2, sort_keys=True) + "\n")
+    print("PASS: source-only HyperFrames sampled benchmark", json.dumps({
+        k: report_data[k] for k in (
+            "duration_seconds", "width", "height", "wall_seconds",
+            "max_sampled_process_tree_rss_bytes", "samples", "output_bytes",
+        )
+    }), flush=True)
+    return report_data
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Feature4 CPU benchmark; no cloud actions")
+    parser.add_argument("project")
+    parser.add_argument("output")
+    parser.add_argument("report")
+    parser.add_argument("--timeout", type=int, default=420)
+    parser.add_argument("--use-npm-node22", action="store_true")
+    args = parser.parse_args()
+    benchmark(args.project, args.output, args.report,
+              timeout_seconds=args.timeout, use_npm_node22=args.use_npm_node22)
+
+
+if __name__ == "__main__":
+    main()

diff --git a/video-engine/hyperframes/check_feature4_output.py b/video-engine/hyperframes/check_feature4_output.py
--- a/video-engine/hyperframes/check_feature4_output.py
+++ b/video-engine/hyperframes/check_feature4_output.py
@@ -0,0 +1,167 @@
+#!/usr/bin/env python3
+"""Offline visual diversity and synthetic source-audio preservation gates.
+
+These low-level checks supplement, not replace, human visual and speech QA.
+The deterministic 480Hz source-clip tone comes from our own test fixture.
+"""
+import array
+import math
+import subprocess
+import sys
+from pathlib import Path
+
+from PIL import Image, ImageChops, ImageStat
+
+FRAME_TIMES = (1, 6, 13, 18, 24, 28)
+
+
+def tone_amplitude(mp4, t, hz=480, sample_rate=8000, window_seconds=1.0):
+    # Windowed PCM checks use actual AAC-decoded bytes, never HTML declarations.
+    if not 0.10 <= window_seconds <= 1.0:
+        raise ValueError("Unsupported bounded AAC inspection window")
+    data = subprocess.check_output(
+        ["ffmpeg", "-nostdin", "-v", "error", "-ss", str(t), "-i", str(mp4),
+         "-t", str(window_seconds), "-ac", "1", "-ar", str(sample_rate), "-f", "s16le", "-"],
+        timeout=25,
+    )
+    samples = array.array("h")
+    samples.frombytes(data)
+    if sys.byteorder != "little":
+        samples.byteswap()
+    if len(samples) < int(sample_rate * window_seconds * .5):
+        raise AssertionError("No usable decoded audio segment")
+    re_part = im_part = 0.0
+    for i, val in enumerate(samples):
+        angle = 2*math.pi*hz*i/sample_rate
+        re_part += val * math.cos(angle)
+        im_part -= val * math.sin(angle)
+    return math.hypot(re_part, im_part) / len(samples)
+
+
+
+def soundtrack_bed_magnitude(mp4, t):
+    """Synthetic soundtrack plays 293.66Hz at both 5s and 12s in this test."""
+    return tone_amplitude(mp4,t,hz=293.66)
+
+
+def check_artifact(media_dir):
+    root = Path(media_dir)
+    clip = root/"feature4-30s-hyperframes-synthetic.mp4"
+    if not clip.is_file():
+        raise AssertionError("Missing REAL HyperFrames MP4")
+    frames=[]
+    for t in FRAME_TIMES:
+        p=root/f"feature4-frame-{t}.jpg"
+        im=Image.open(p).convert("RGB")
+        if im.size != (540,960):
+            raise AssertionError("Wrong preview frame size")
+        if ImageStat.Stat(im.convert("L")).stddev[0] < 15:
+            raise AssertionError(f"Frame {t}s is blank or visually near-uniform")
+        frames.append(im)
+    # Catch invisible hero logo in the real six-scene synthetic video.
+    intro_region = frames[0].crop((155, 170, 385, 540)).convert("L")
+    hero_luma = ImageStat.Stat(intro_region).stddev[0]
+    if hero_luma < 14:
+        raise AssertionError(
+            f"Opening brand hero is invisible or near-uniform ({hero_luma:.1f})"
+        )
+    changes=[
+        ImageStat.Stat(ImageChops.difference(a,b).convert("L")).mean[0]
+        for a,b in zip(frames,frames[1:])
+    ]
+    if sum(d > 9 for d in changes) < 4:
+        raise AssertionError("Scene changes missing or near-identical")
+    with_motion=tone_amplitude(clip,5)
+    without_motion=tone_amplitude(clip,12)
+    # Audibly duck the APPROVED bed only during source-audio scenes.
+    music_during_source=soundtrack_bed_magnitude(clip,5)
+    music_after_source=soundtrack_bed_magnitude(clip,12)
+    if not (music_after_source > 45 and
+            music_after_source > 2.2 * max(1, music_during_source)):
+        raise AssertionError("Approved soundtrack was not ducked during source clip")
+    if not (with_motion >= 30 and with_motion > 8 * max(1,without_motion)):
+        raise AssertionError("Feature #5 fixture source audio lost in the composition mix")
+    return {"intro_logo_luma_stddev": round(hero_luma, 2),
+            "scene_delta": [round(n,2) for n in changes],
+            "source_tone_amplitude": round(with_motion,2),
+            "nonclip_tone_amplitude": round(without_motion,2),
+            "bed_ducked_source_amplitude": round(music_during_source, 2),
+            "bed_nonvoice_amplitude": round(music_after_source, 2)}
+
+
+def check_fullres_artifact(media_dir):
+    """Gate actual 1080p scene diversity; never equate synthetic visuals with fashion realism."""
+    root = Path(media_dir)
+    expected = (1, 6, 13, 18, 28)
+    pictures = []
+    for time in expected:
+        p = root / f"feature4-fullres-frame-{time}.jpg"
+        with Image.open(p) as image:
+            picture = image.convert("RGB")
+        if picture.size != (1080, 1920):
+            raise AssertionError(f"Incorrect full-resolution screenshot at {time}s")
+        variation = ImageStat.Stat(picture.convert("L")).stddev[0]
+        if variation < 12:
+            raise AssertionError(f"1080p scene at {time}s visually blank ({variation:.1f})")
+        pictures.append(picture.resize((270, 480)))
+    scene_changes = [
+        ImageStat.Stat(ImageChops.difference(a, b).convert("L")).mean[0]
+        for a, b in zip(pictures, pictures[1:])
+    ]
+    if sum(d > 8 for d in scene_changes) < 3:
+        raise AssertionError(f"1080p scenes not distinguishable: {scene_changes}")
+    # Distinct fixed 863Hz fixture tone must survive the actual HyperFrames
+    # mix → AAC encode → MP4 demux → PCM decode. This does NOT test speech.
+    encoded_mp4 = root / "feature4-30s-1080p-hyperframes-synthetic.mp4"
+    narr_mid = tone_amplitude(encoded_mp4, 13, hz=863)
+    narr_end = tone_amplitude(encoded_mp4, 27, hz=863)
+    if not (narr_mid > 55 and narr_end > 55):
+        raise AssertionError("Approved synthetic narration track missing in final AAC")
+    # F4-07: inspect actual encoded AAC near the start and end of the Reel,
+    # not merely the renderer's data-fade-* attributes. The fixture's own
+    # deterministic 0.2s envelope contributes to these measurements, so this
+    # checks the combined exported envelope, NOT renderer-only automation.
+    narr_fade_in = tone_amplitude(encoded_mp4, 0, hz=863, window_seconds=.12)
+    narr_fade_out = tone_amplitude(encoded_mp4, 29.88, hz=863, window_seconds=.12)
+    if not (narr_mid > 1.7 * max(1, narr_fade_in, narr_fade_out)):
+        raise AssertionError("Encoded synthetic narration did not preserve audible start/end fades")
+    # Synthetic subtitle is visible at t=1.2s and absent at t=0.6/2.2s.
+    # Compare the same first-scene, fixed region to detect true time-gated
+    # pixels in the FINAL decoded MP4, without OCR or claiming spoken QA.
+    before = Image.open(root / "feature4-caption-frame-0.6.png").convert("RGB")
+    during = Image.open(root / "feature4-caption-frame-1.2.png").convert("RGB")
+    after = Image.open(root / "feature4-caption-frame-2.2.png").convert("RGB")
+    if any(frame.size != (1080, 1920) for frame in (before, during, after)):
+        raise AssertionError("Incorrect decoded caption proof frame size")
+    caption_region = (180, 1060, 900, 1360)
+    def frame_delta(a, b):
+        return ImageStat.Stat(ImageChops.difference(
+            a.crop(caption_region), b.crop(caption_region)).convert("L")).mean[0]
+    visible_delta = frame_delta(before, during)
+    baseline_delta = frame_delta(before, after)
+    if not (visible_delta > 4.0 and visible_delta > 2.5 * max(1.0, baseline_delta)):
+        raise AssertionError(
+            f"Timed subtitle not visible in encoded 1080p MP4: "
+            f"caption_delta={visible_delta:.2f}, same_scene_baseline={baseline_delta:.2f}"
+        )
+    return {"synthetic_caption_encoded_pixel_delta": round(visible_delta, 2),
+            "same_scene_caption_off_delta": round(baseline_delta, 2),
+            "caption_semantic_alignment_accepted": False,
+            "synthetic_narration_mid_amplitude": round(narr_mid, 2),
+            "synthetic_narration_end_amplitude": round(narr_end, 2),
+            "synthetic_narration_fade_in_amplitude": round(narr_fade_in, 2),
+            "synthetic_narration_fade_out_amplitude": round(narr_fade_out, 2),
+            "encoded_aac_envelope_checked_not_spoken_quality": True,
+            "spoken_word_qa_accepted": False,
+            "resolution": "1080x1920", "frames_sampled": len(pictures),
+            "scene_deltas": [round(x, 2) for x in scene_changes],
+            "commercial_fashion_realism_accepted": False}
+
+
+if __name__=="__main__":
+    if len(sys.argv) not in (2, 3) or (len(sys.argv) == 3 and sys.argv[2] != "--fullres"):
+        raise SystemExit("usage: python check_feature4_output.py <ci-artifacts-folder> [--fullres]")
+    if len(sys.argv) == 3:
+        print("PASS: actual 1080p visual diversity only", check_fullres_artifact(sys.argv[1]))
+    else:
+        print("PASS: real HyperFrames frame diversity + synthetic source audio", check_artifact(sys.argv[1]))

diff --git a/video-engine/hyperframes/ci-smoke.sh b/video-engine/hyperframes/ci-smoke.sh
--- a/video-engine/hyperframes/ci-smoke.sh
+++ b/video-engine/hyperframes/ci-smoke.sh
@@ -0,0 +1,159 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+TEMP="$(mktemp -d)"
+trap 'rm -rf "$TEMP"' EXIT
+PROJECT="$TEMP/diwali-composition"
+OUTPUT="$ROOT/ci-artifacts/feature4-30s-hyperframes-synthetic.mp4"
+mkdir -p "$ROOT/ci-artifacts"
+python3 "$ROOT/video-engine/demo_feature4_diwali.py" "$PROJECT"
+# Validate the exact committed v3 dependency lock BEFORE npm executes any
+# installation scripts. No network-driven package resolution or lock rewrites.
+python3 "$ROOT/video-engine/hyperframes/lock_guard.py" --lock "$ROOT/video-engine/hyperframes/package-lock.json" --report "$ROOT/ci-artifacts/feature4-npm-dependency-audit.json"
+timeout --signal=TERM --kill-after=10s 180s npm ci --prefix "$ROOT/video-engine/hyperframes" --no-audit --no-fund
+if [ -x "$ROOT/video-engine/hyperframes/node_modules/.bin/puppeteer" ]; then
+  timeout --signal=TERM --kill-after=10s 140s "$ROOT/video-engine/hyperframes/node_modules/.bin/puppeteer" browsers install chrome-headless-shell
+fi
+# Run offline package/browser readiness checks before the full CPU render.
+# The older-node npm-exec fallback is unqualified and remains a DEV blocker.
+NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
+if (( NODE_MAJOR >= 22 )); then
+  python3 "$ROOT/video-engine/hyperframes/qualify_runtime.py" --report "$ROOT/ci-artifacts/feature4-runtime-preflight.json"
+else
+  echo "Feature4 source runtime preflight deferred: runner Node <22, fallback npm exec used" >&2
+fi
+if (( NODE_MAJOR >= 22 )); then
+  timeout --signal=TERM --kill-after=10s 480s node "$ROOT/video-engine/hyperframes/render.mjs" "$PROJECT" "$OUTPUT"
+else
+  timeout --signal=TERM --kill-after=10s 480s npm exec --yes --package=node@22 -- node "$ROOT/video-engine/hyperframes/render.mjs" "$PROJECT" "$OUTPUT"
+fi
+python3 - "$OUTPUT" <<'PY'
+import json,subprocess,sys
+info=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_streams','-show_format','-of','json',sys.argv[1]],text=True))
+v=[s for s in info['streams'] if s.get('codec_type')=='video']
+a=[s for s in info['streams'] if s.get('codec_type')=='audio']
+assert len(v)==1 and v[0]['codec_name']=='h264'
+assert (v[0]['width'],v[0]['height'])==(540,960)
+assert len(a)==1 and a[0]['codec_name']=='aac'
+assert abs(float(info['format']['duration'])-30)<.25
+print('PASS: actual HyperFrames 30s synthetic Diwali MP4 H264/AAC')
+PY
+for sec in 1 6 13 18 24 28; do
+ ffmpeg -nostdin -hide_banner -loglevel error -y -ss "$sec" -i "$OUTPUT" -frames:v 1 "$ROOT/ci-artifacts/feature4-frame-$sec.jpg"
+done
+
+# Quantify scene diversity and prove original 480Hz fixture-track remains in AAC mix.
+python3 "$ROOT/video-engine/hyperframes/check_feature4_output.py" "$ROOT/ci-artifacts"
+# Preserve the exact committed SHA-pinned lock in the CI evidence artifact.
+cp "$ROOT/video-engine/hyperframes/package-lock.json" "$ROOT/ci-artifacts/feature4-review-package-lock.json"
+
+# Acceptance-stage output contract: exercise real 1080x1920 frames, not just
+# 540p upscaling or an HTML plan. The main 30-second mode is required.
+# All materials are original synthetic fixtures, NEVER customer media.
+PROJECT_HD="$TEMP/diwali-1080p"
+OUTPUT_HD="$ROOT/ci-artifacts/feature4-30s-1080p-hyperframes-synthetic.mp4"
+# Exercise actual AAC narration track in the high-resolution render instead
+# of merely verifying the source HTML (synthetic 863Hz tone, NOT a human voice).
+python3 "$ROOT/video-engine/demo_feature4_diwali.py" "$PROJECT_HD" --seconds 30 --width 1080 --with-narration
+if (( NODE_MAJOR >= 22 )); then
+  timeout --signal=TERM --kill-after=10s 440s python3 "$ROOT/video-engine/hyperframes/benchmark_render.py" "$PROJECT_HD" "$OUTPUT_HD" "$ROOT/ci-artifacts/feature4-1080p-cpu-benchmark.json" --timeout 420
+else
+  timeout --signal=TERM --kill-after=10s 440s python3 "$ROOT/video-engine/hyperframes/benchmark_render.py" "$PROJECT_HD" "$OUTPUT_HD" "$ROOT/ci-artifacts/feature4-1080p-cpu-benchmark.json" --timeout 420 --use-npm-node22
+fi
+python3 - "$OUTPUT_HD" <<'PY'
+import json,subprocess,sys
+from pathlib import Path
+sys.path.insert(0,str(Path("video-engine").resolve()))
+from render_adapter import verify_mp4
+proof=verify_mp4(sys.argv[1],duration=30,width=1080,height=1920,fps=24)
+info=json.loads(subprocess.check_output(
+    ["ffprobe","-v","error","-show_streams","-of","json",sys.argv[1]],text=True))
+v=next(s for s in info["streams"] if s.get("codec_type")=="video")
+assert v.get("pix_fmt")=="yuv420p", v.get("pix_fmt")
+assert int(v.get("nb_frames",720)) in range(718,723),v.get("nb_frames")
+print("PASS: actual 1080x1920/24fps/30s HyperFrames encode",proof)
+PY
+for sec in 1 6 13 18 28; do
+ ffmpeg -nostdin -hide_banner -loglevel error -y -ss "$sec" -i "$OUTPUT_HD" -frames:v 1 "$ROOT/ci-artifacts/feature4-fullres-frame-$sec.jpg"
+done
+# Check a synthetic caption is VISIBLY burned into the encoded 1080p MP4.
+# All three frames are within the same 0..3s intro shot to avoid a fake pass
+# from unrelated scene cuts. No speech/text semantic quality is claimed.
+for t in 0.6 1.2 2.2; do
+  ffmpeg -nostdin -hide_banner -loglevel error -y -ss "$t" -i "$OUTPUT_HD" -frames:v 1 "$ROOT/ci-artifacts/feature4-caption-frame-$t.png"
+done
+python3 "$ROOT/video-engine/hyperframes/check_feature4_output.py" "$ROOT/ci-artifacts" --fullres
+
+# Explicit full-minute qualification (full 1080p, CPU, no GPU/provider charges).
+# TRUE editable-timeline export parity: run upstream Timeline Studio JS commands,
+# authorize the resulting 30s draft in trusted Python, stage only original
+# mock media, then render an actual second MP4 with the same HyperFrames engine.
+# Lower-res 540x960 avoids a second costly Full-HD encoding. No GPU/AI call.
