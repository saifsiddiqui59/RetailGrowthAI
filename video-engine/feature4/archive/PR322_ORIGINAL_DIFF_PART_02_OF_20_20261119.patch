diff --git a/frontend/src/features/video/beat-preview.mjs b/frontend/src/features/video/beat-preview.mjs
--- a/frontend/src/features/video/beat-preview.mjs
+++ b/frontend/src/features/video/beat-preview.mjs
@@ -0,0 +1,20 @@
+// Pure UI-only beat-coordinate preview; server must verify beat grid, music rights,
+// shop membership and approved snapshot independently before rendering.
+export function proposedBeatMarkers(draft, musicAssets = []) {
+  if (!draft || draft.mode !== 'music_sync' ||
+      ![15,30,60].includes(draft.duration_seconds) ||
+      !Array.isArray(draft.beats) || draft.beats.length < 2 ||
+      draft.beats.length > 300 || !Array.isArray(musicAssets) ||
+      typeof draft.music_asset_id !== 'string' ||
+      !musicAssets.some(a => a?.authorized === true && a.kind === 'audio' &&
+        a.id === draft.music_asset_id && a.shop_id === draft.shop_id)) return []
+  let previous = -1
+  for (const b of draft.beats) {
+    if (typeof b !== 'number' || !Number.isFinite(b) ||
+        b <= previous || b < 0 || b >= draft.duration_seconds ||
+        b !== Math.round(b * 1000) / 1000) return []
+    previous = b
+  }
+  const stride = Math.ceil(draft.beats.length / 120)
+  return draft.beats.filter((_, i) => i % stride === 0)
+}

diff --git a/frontend/src/features/video/creative-direction-adapter.mjs b/frontend/src/features/video/creative-direction-adapter.mjs
--- a/frontend/src/features/video/creative-direction-adapter.mjs
+++ b/frontend/src/features/video/creative-direction-adapter.mjs
@@ -0,0 +1,112 @@
+// Feature #2 controls all creative direction, voice lines, offers and motion briefs.
+// Proposed read-only F2 handoff adapter. No trust is conferred by browser approval.
+import { compatibleMedia, validateVideoDraft } from './video-model.mjs'
+const id = value => typeof value === 'string' && /^[A-Za-z0-9_-]{1,100}$/.test(value)
+// Read-only preview of the Feature2-reviewed timed transcript. Server approval
+// and audio provenance MUST be independently verified before a render.
+export function checkedPreviewCaptionCues(cues,duration) {
+  if(cues == null) return []
+  if(!Array.isArray(cues) || cues.length<1 || cues.length>60 ||
+     ![15,30,60].includes(duration)) throw Error('Unsupported approved spoken subtitles')
+  let priorMs=0
+  return cues.map(c=>{
+    if(!c || typeof c!=='object' || Array.isArray(c) ||
+       Object.keys(c).sort().join(',')!=='duration,start,text' ||
+       typeof c.start!=='number' || !Number.isFinite(c.start) ||
+       typeof c.duration!=='number' || !Number.isFinite(c.duration) ||
+       c.start<0 || c.duration<.2 || c.duration>6 ||
+       c.start!==Math.round(c.start*1000)/1000 ||
+       c.duration!==Math.round(c.duration*1000)/1000 ||
+       Math.round(c.start*1000)<priorMs ||
+       Math.round(c.start*1000)+Math.round(c.duration*1000)>duration*1000 ||
+       typeof c.text!=='string' || c.text!==c.text.trim() ||
+       !c.text.length || c.text.length>90 || /[<>\x00-\x1F\x7F]/.test(c.text)) {
+      throw Error('Feature2 spoken subtitle has unsafe or overlapping timecodes')
+    }
+    priorMs=Math.round(c.start*1000)+Math.round(c.duration*1000)
+    return {start:c.start,duration:c.duration,text:c.text}
+  })
+}
+
+export function inspectCreativeDirection(packageData, { shopId, mediaAssets = [], musicAssets = [] } = {}) {
+  if (!packageData || typeof packageData !== 'object' || Array.isArray(packageData) ||
+      packageData.version !== 'creative_direction_v1' ||
+      packageData.source_feature !== 'feature2' || packageData.approved !== true ||
+      packageData.shop_id !== shopId || !id(packageData.approval_id) ||
+      !id(packageData.campaign_id) || ![15, 30, 60].includes(packageData.duration_seconds) ||
+      !Array.isArray(packageData.scenes) || packageData.scenes.length < 1 ||
+      packageData.scenes.length > 12 || !id(packageData.review_hash)) {
+    throw Error('Trusted, versioned Feature #2 creative direction is required')
+  }
+  const creative = packageData.scenes
+  const assets = compatibleMedia('media', mediaAssets, shopId)
+  let position = 0
+  const scenes = creative.map((shot, index) => {
+    const source = assets.find(a => a.id === shot?.asset_id)
+    const overlay = shot?.poster_overlay_asset_id
+    const legalPoster = overlay == null || mediaAssets.some(a =>
+      a.id === overlay && a.shop_id === shopId && a.authorized === true &&
+      a.kind === 'poster' && overlay !== shot.asset_id)
+    const videoSource = source?.kind === 'video'
+    if (!shot || !Number.isFinite(shot.duration) || shot.duration < 0.5 ||
+        typeof shot.headline !== 'string' || !shot.headline.trim() ||
+        shot.headline.length > 110 || typeof shot.asset_id !== 'string' ||
+        !assets.some(a => a.id === shot.asset_id) ||
+        !['fade', 'slide', 'cut'].includes(shot.transition) ||
+        !['subtle_zoom', 'fade', 'slide', 'pop', 'glow'].includes(shot.animation_preset) ||
+        !legalPoster ||
+        (shot.trim_start != null && (!videoSource ||
+          typeof shot.trim_start !== 'number' || !Number.isFinite(shot.trim_start) ||
+          shot.trim_start < 0 || shot.trim_start > 180 ||
+          (typeof source.duration_seconds === 'number' &&
+           source.duration_seconds > 0 && shot.trim_start + shot.duration > source.duration_seconds + .02))) ||
+        (shot.mute_source != null && (!videoSource || typeof shot.mute_source !== 'boolean')) ||
+        (shot.offer != null && (typeof shot.offer !== 'string' || shot.offer.length > 70)) ||
+        (shot.sfx_asset_id != null && !musicAssets.some(track =>
+          track.id === shot.sfx_asset_id && track.shop_id === shopId &&
+          track.authorized === true && track.kind === 'audio'))) {
+      throw Error('Feature #2 scene '+(index + 1)+' needs approved assets and renderable effects')
+    }
+    const s = { start: position, duration: shot.duration, asset_id: shot.asset_id,
+      headline: shot.headline, transition: shot.transition, animation_preset: shot.animation_preset,
+      ...(shot.offer ? { offer: shot.offer } : {}),
+      ...(shot.sfx_asset_id ? { sfx_asset_id: shot.sfx_asset_id } : {}),
+      ...(overlay != null ? { poster_overlay_asset_id: overlay } : {}),
+      ...(shot.trim_start != null ? { trim_start: shot.trim_start } : {}),
+      ...(shot.mute_source != null ? { mute_source: shot.mute_source } : {}) }
+    position = Math.round((position + s.duration) * 1000) / 1000
+    return s
+  })
+  if (Math.abs(position - packageData.duration_seconds) > 0.001 ||
+      typeof packageData.cta !== 'string' || !packageData.cta.trim() ||
+      packageData.cta.length > 110 || !['cinematic','streetwear','festival'].includes(packageData.template) ||
+      (packageData.music_asset_id && !musicAssets.some(a => a.id === packageData.music_asset_id &&
+        a.authorized === true && a.shop_id === shopId && a.kind === 'audio'))) {
+    throw Error('Feature #2 direction has unsupported timeline, CTA or licensed soundtrack')
+  }
+  if (packageData.voiceover_asset_id != null &&
+      !musicAssets.some(a => a.id === packageData.voiceover_asset_id &&
+        a.shop_id === shopId && a.authorized === true && a.kind === 'audio')) {
+    throw Error('Feature #2 narration is not rights-authorized for this shop')
+  }
+  const sourceScript=packageData.script
+  if(sourceScript != null && (sourceScript.source_feature!=='feature2' ||
+      sourceScript.approved!==true || sourceScript.approval_id!==packageData.approval_id)) {
+    throw Error('Feature2 spoken transcript revision is not approved')
+  }
+  const captionCues=checkedPreviewCaptionCues(sourceScript?.transcript,packageData.duration_seconds)
+  if(captionCues.length && !packageData.voiceover_asset_id) {
+    throw Error('Spoken subtitles require reviewed narration media')
+  }
+  const draft = { version: 'rg_video_v2', shop_id: shopId, mode: 'media',
+    template: packageData.template, duration_seconds: packageData.duration_seconds,
+    output: { width: 1080, height: 1920, fps: 30 }, scenes,
+    cta: packageData.cta, music_asset_id: packageData.music_asset_id || null,
+    voiceover_asset_id: packageData.voiceover_asset_id || null }
+  const issues = validateVideoDraft(draft, mediaAssets, musicAssets)
+  if (issues.length) throw Error(issues.join('; '))
+  // Full original package (including camera details and motion prompts) stays
+  // independently persisted by Feature2/coordinator, NEVER in an editable browser draft.
+  return { draft, approvalId: packageData.approval_id, campaignId: packageData.campaign_id,
+    reviewHash: packageData.review_hash, captionCues, readOnly: true }
+}

diff --git a/frontend/src/features/video/frame-seek.mjs b/frontend/src/features/video/frame-seek.mjs
--- a/frontend/src/features/video/frame-seek.mjs
+++ b/frontend/src/features/video/frame-seek.mjs
@@ -0,0 +1,20 @@
+// Feature4 timeline-only seek normalization. No draft/media authorization changes.
+// Do not allow malformed UI, beat markers or pointer geometry to poison the
+// React playhead with NaN/Infinity or an out-of-range position.
+export function boundedFrameSeek(requestedSeconds, durationSeconds, fps) {
+  if (!Number.isFinite(requestedSeconds) || !Number.isFinite(durationSeconds) ||
+      durationSeconds <= 0 || (fps !== 24 && fps !== 30)) return null
+  const bounded = Math.min(durationSeconds, Math.max(0, requestedSeconds))
+  return Math.min(durationSeconds, Math.max(0, Math.round(bounded * fps) / fps))
+}
+
+// Scene click navigation must share the same frame boundary as timecode/keyboard.
+// Invalid or out-of-bounds spans are not usable preview positions.
+export function boundedSceneMidpointSeek(startSeconds, sceneDurationSeconds, durationSeconds, fps) {
+  if (!Number.isFinite(startSeconds) || !Number.isFinite(sceneDurationSeconds) ||
+      !Number.isFinite(durationSeconds) || startSeconds < 0 ||
+      sceneDurationSeconds <= 0 || durationSeconds <= 0 ||
+      startSeconds >= durationSeconds ||
+      sceneDurationSeconds > durationSeconds - startSeconds + 1e-6) return null
+  return boundedFrameSeek(startSeconds + sceneDurationSeconds / 2, durationSeconds, fps)
+}

diff --git a/frontend/src/features/video/timeline-studio-bridge.mjs b/frontend/src/features/video/timeline-studio-bridge.mjs
--- a/frontend/src/features/video/timeline-studio-bridge.mjs
+++ b/frontend/src/features/video/timeline-studio-bridge.mjs
@@ -0,0 +1,186 @@
+// Tenant-safe bridge: Timeline Studio's real editing primitives -> existing rg_video_v2.
+// Upstream editing engine copyright (c) 2026 MartinDelophy (MIT).
+// This module does not authorize assets, rewrite approved scripts or export media.
+import { getVisualSegmentTimeline, reorderTimelineItems } from './vendor/timeline.js'
+import { splitVisualSegmentState } from './vendor/timelineCut.js'
+import { recalculateScenes, validateVideoDraft } from './video-model.mjs'
+
+function recalc(scenes, duration) {
+  const next = recalculateScenes(scenes)
+  const sum = next.reduce((n, s) => n + s.duration, 0)
+  if (next.length > 12 || next.some(s => !Number.isFinite(s.duration) || s.duration < 0.5) ||
+      Math.abs(sum - duration) > 0.001) throw Error('Timeline edits must preserve the approved 15/30/60 second duration')
+  return next
+}
+export function studioRanges(draft) {
+  return getVisualSegmentTimeline(draft.scenes.map((scene, index) =>
+    ({ id: String(index), duration: scene.duration })))
+}
+export function studioReorder(draft, from, to) {
+  if (!Number.isInteger(from) || !Number.isInteger(to) || from < 0 ||
+      to < 0 || from >= draft.scenes.length || to >= draft.scenes.length) throw Error('Invalid clip reorder')
+  return { ...draft, scenes: recalc(reorderTimelineItems(draft.scenes, from, to), draft.duration_seconds) }
+}
+export function studioSplit(draft, index, offset, mediaAssets) {
+  const scene = draft.scenes[index]
+  if (!scene || !Number.isFinite(offset) || offset < 0.5 || scene.duration - offset < 0.5 ||
+      draft.scenes.length >= 12) throw Error('Split requires at least 0.5s per clip and at most 12 clips')
+  const media = (mediaAssets || []).find(a => a.id === scene.asset_id &&
+    a.shop_id === draft.shop_id && a.authorized === true)
+  if (draft.mode !== 'text' && !media) throw Error('Cannot split an unapproved media source')
+  const isVideo = media?.kind === 'video'
+  // HyperFrames places approved scene SFX at the scene's first 0-2 seconds.
+  // Splitting inside that window would change its true export duration, and
+  // copying the SFX to both new clips would cause an unauthorized replay.
+  const fxSeconds = Math.min(2, scene.duration)
+  if (scene.sfx_asset_id != null && offset < fxSeconds - 0.001) {
+    throw Error('Split would cut through the approved 2-second sound effect')
+  }
+  const parts = splitVisualSegmentState({
+    type: isVideo ? 'video' : 'image',
+    sourceStart: isVideo ? (scene.trim_start || 0) : 0,
+    playbackRate: 1, duration: scene.duration,
+  }, offset, scene.duration - offset)
+  // Preserve EXACT approved claim, caption and asset identity in both pieces.
+  const scenes = [ ...draft.scenes.slice(0, index),
+    ...parts.map((part, partIndex) => {
+      const { sfx_asset_id, ...rest } = scene
+      return {
+        ...rest, duration: part.duration,
+        ...(partIndex === 0 && sfx_asset_id != null ? { sfx_asset_id } : {}),
+        ...(isVideo ? { trim_start: part.sourceStart } : {}),
+      }
+    }),
+    ...draft.scenes.slice(index + 1),
+  ]
+  return { ...draft, scenes: recalc(scenes, draft.duration_seconds) }
+}
+// Duplicate the VISUAL content in place by replaying the first half twice.
+// Preserve the fixed 15/30/60s output contract and review-locked offer/copy.
+// A source video intentionally restarts from its approved in-point, rather than
+// pretending source footage exists beyond the authorized media duration.
+export function studioDuplicate(draft, index, mediaAssets = []) {
+  const scene = draft.scenes?.[index]
+  if (!Number.isInteger(index) || !scene || draft.scenes.length >= 12 ||
+      !Number.isFinite(scene.duration) || scene.duration < 1) {
+    throw Error('Duplication needs a clip of at least 1 second and fewer than 12 scenes')
+  }
+  const media = mediaAssets.find(a => a.id === scene.asset_id &&
+    a.shop_id === draft.shop_id && a.authorized === true &&
+    ['image','poster','video'].includes(a.kind))
+  if (draft.mode !== 'text' && !media) throw Error('Cannot duplicate a foreign or unapproved clip')
+  const first = Math.round(scene.duration * 500) / 1000
+  const second = Math.round((scene.duration - first) * 1000) / 1000
+  if (first < .5 || second < .5) throw Error('Duplicate clips must remain at least 0.5 seconds')
+  if (scene.sfx_asset_id != null && first < Math.min(2, scene.duration)) {
+    throw Error('Duplication would truncate an approved 2-second scene sound effect')
+  }
+  const {sfx_asset_id, ...withoutEffect} = scene
+  const copy = { ...withoutEffect, duration: second,
+    ...(media?.kind === 'video' ? {trim_start: scene.trim_start || 0} : {}) }
+  const original = {...scene, duration: first}
+  return { ...draft, scenes: recalc([
+    ...draft.scenes.slice(0,index), original, copy,
+    ...draft.scenes.slice(index+1)
+  ],draft.duration_seconds) }
+}
+
+export function studioTrimPair(draft, index, delta, mediaAssets = []) {
+  if (!Number.isInteger(index) || !Number.isFinite(delta) || index < 0 ||
+      index >= draft.scenes.length - 1) throw Error('Select an internal clip boundary')
+  const a = draft.scenes[index], b = draft.scenes[index + 1]
+  const durationA = Math.round((a.duration + delta) * 1000) / 1000
+  const durationB = Math.round((b.duration - delta) * 1000) / 1000
+  if (durationA < 0.5 || durationB < 0.5) throw Error('Each clip must remain at least 0.5 seconds')
+  // Fixed-gain HyperFrames scene SFX plays for min(2s, scene duration).
+  // Shortening an approved 2s effect to 1s (or extending a shorter effect)
+  // silently changes the sound. Reject the boundary edit, never retime audio.
+  if ((a.sfx_asset_id != null && Math.min(2, a.duration) !== Math.min(2, durationA)) ||
+      (b.sfx_asset_id != null && Math.min(2, b.duration) !== Math.min(2, durationB))) {
+    throw Error('Boundary trim would change an approved scene sound-effect duration')
+  }
+  // Left-hand VIDEO can gain duration: verify the newly exposed frames exist
+  // whenever a trusted/probed source duration is available.
+  const leftMedia = mediaAssets.find(asset => asset.id === a.asset_id &&
+    asset.shop_id === draft.shop_id && asset.authorized === true)
+  if (leftMedia?.kind === 'video' && typeof leftMedia.duration_seconds === 'number' &&
+      Number.isFinite(leftMedia.duration_seconds) && leftMedia.duration_seconds > 0 &&
+      (a.trim_start || 0) + durationA > leftMedia.duration_seconds + 0.02) {
+    throw Error('Boundary trim exceeds verified source video duration')
+  }
+  // A right-hand VIDEO clip must start later in its source if its timeline
+  // start is pushed right. Otherwise moving the boundary silently replays the
+  // original frames and the editor's timing is not reproduced by FFmpeg.
+  const rightMedia = mediaAssets.find(a => a.id === b.asset_id &&
+    a.shop_id === draft.shop_id && a.authorized === true)
+  const isVideo = rightMedia?.kind === 'video' || b.trim_start != null
+  const rightStart = b.trim_start || 0
+  const nextRightStart = Math.round((rightStart + delta) * 1000) / 1000
+  if (isVideo && nextRightStart < 0) {
+    throw Error('Cannot extend video before its source begins')
+  }
+  return { ...draft, scenes: recalc(draft.scenes.map((scene, i) => i === index ?
+    { ...scene, duration: durationA } : i === index + 1 ?
+      { ...scene, duration: durationB,
+        ...(isVideo ? {trim_start:nextRightStart} : {}) } : scene), draft.duration_seconds) }
+}
+export function studioSourceTrim(draft, index, seconds, mediaAssets) {
+  const scene = draft.scenes[index]
+  const source = (mediaAssets || []).find(m => m.id === scene?.asset_id &&
+    m.kind === 'video' && m.shop_id === draft.shop_id && m.authorized === true)
+  if (!source || !Number.isFinite(seconds) || seconds < 0 || seconds > 180) {
+    throw Error('Source trim is only allowed on the current tenant’s approved video')
+  }
+  if (typeof source.duration_seconds === 'number' && Number.isFinite(source.duration_seconds) &&
+      seconds + scene.duration > source.duration_seconds + 0.02) {
+    throw Error('Video trim exceeds verified source length')
+  }
+  return { ...draft, scenes: draft.scenes.map((item, i) =>
+    i === index ? { ...item, trim_start: seconds } : item) }
+}
+// The UI is never the authorizing store. This catches accidental cross-shop
+// preview/edits early; the trusted compiler revalidates all grants at render time.
+export function studioValidatedDraft(draft, mediaAssets, musicAssets) {
+  if (!draft || typeof draft.shop_id !== 'string' || !Array.isArray(draft.scenes)) {
+    throw Error('Missing or invalid tenant timeline')
+  }
+  const media = Array.isArray(mediaAssets) ? mediaAssets : []
+  const music = Array.isArray(musicAssets) ? musicAssets : []
+  const sameShop = (id, records, allowedKinds) => {
+    if (!records.some(a => a.id === id && a.shop_id === draft.shop_id &&
+        a.authorized === true && allowedKinds.includes(a.kind))) {
+      throw Error('Foreign, unlicensed or revoked media cannot enter this timeline')
+    }
+  }
+  for (const scene of draft.scenes) {
+    if (draft.mode !== 'text') {
+      sameShop(scene.asset_id, media, ['image', 'poster', 'video'])
+    }
+    if (scene.poster_overlay_asset_id != null) {
+      sameShop(scene.poster_overlay_asset_id, media, ['poster'])
+    }
+    if (scene.sfx_asset_id != null) {
+      sameShop(scene.sfx_asset_id, music, ['audio'])
+    }
+    if (scene.trim_start != null) {
+      const asset = media.find(a => a.id === scene.asset_id && a.shop_id === draft.shop_id)
+      if (!asset || asset.kind !== 'video' || typeof scene.trim_start !== 'number' ||
+          !Number.isFinite(scene.trim_start) || scene.trim_start < 0 ||
+          scene.trim_start > 180) throw Error('Invalid approved video trim')
+    }
+    const asset = media.find(a => a.id === scene.asset_id && a.shop_id === draft.shop_id)
+    const duration = asset?.duration_seconds
+    // Duration is server-probed media metadata, when available. A missing value
+    // is NOT interpreted as unlimited footage: final worker probes the source.
+    if (asset?.kind === 'video' && typeof duration === 'number' &&
+        Number.isFinite(duration) && duration > 0 &&
+        (scene.trim_start || 0) + scene.duration > duration + 0.02) {
+      throw Error('Video trim exceeds verified source length')
+    }
+  }
+  if (draft.music_asset_id != null) sameShop(draft.music_asset_id, music, ['audio'])
+  if (draft.voiceover_asset_id != null) sameShop(draft.voiceover_asset_id, music, ['audio'])
+  const issues = validateVideoDraft(draft, mediaAssets, musicAssets)
+  if (issues.length) throw Error(issues.join('; '))
+  return draft
+}

