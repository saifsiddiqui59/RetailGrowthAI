diff --git a/frontend/src/features/video/vendor/openreel/clip-snap.mjs b/frontend/src/features/video/vendor/openreel/clip-snap.mjs
--- a/frontend/src/features/video/vendor/openreel/clip-snap.mjs
+++ b/frontend/src/features/video/vendor/openreel/clip-snap.mjs
@@ -0,0 +1,61 @@
+// Extracted from augani/openreel-video/packages/core/src/timeline/clip-manager.ts
+// Pinned 367d7e90b61b5181f9861b852bb8b9d7a7d2954a; MIT © 2024-2026 Augustus Otu and Contributors.
+// Original ClipManager.snapToGrid, with TS syntax removed. No action executor.
+export class OpenReelClipSnapper {
+  constructor({ snapToGridEnabled = true, gridSize = 1, snapThreshold = 8 } = {}) {
+    this.snapToGridEnabled = snapToGridEnabled
+    this.gridSize = gridSize
+    this.snapThreshold = snapThreshold
+  }
+  snapToGrid(time, timeline, trackId, pixelsPerSecond, excludeClipId) {
+    if (!this.snapToGridEnabled) {
+      return { snappedTime: time, didSnap: false };
+    }
+    const timeThreshold = this.snapThreshold / pixelsPerSecond;
+
+    let closestSnap = time;
+    let closestDistance = Infinity;
+    let snapTarget = undefined;
+
+    // Snap to grid lines
+    const gridSnap = Math.round(time / this.gridSize) * this.gridSize;
+    const gridDistance = Math.abs(time - gridSnap);
+    if (gridDistance < timeThreshold && gridDistance < closestDistance) {
+      closestSnap = gridSnap;
+      closestDistance = gridDistance;
+      snapTarget = "grid";
+    }
+
+    // Snap to clip boundaries on the same track
+    const track = timeline.tracks.find((t) => t.id === trackId);
+    if (track) {
+      for (const clip of track.clips) {
+        if (clip.id === excludeClipId) continue;
+
+        // Snap to clip start
+        const startDistance = Math.abs(time - clip.startTime);
+        if (startDistance < timeThreshold && startDistance < closestDistance) {
+          closestSnap = clip.startTime;
+          closestDistance = startDistance;
+          snapTarget = "clip-start";
+        }
+
+        // Snap to clip end
+        const clipEnd = clip.startTime + clip.duration;
+        const endDistance = Math.abs(time - clipEnd);
+        if (endDistance < timeThreshold && endDistance < closestDistance) {
+          closestSnap = clipEnd;
+          closestDistance = endDistance;
+          snapTarget = "clip-end";
+        }
+      }
+    }
+
+    return {
+      snappedTime: closestSnap,
+      didSnap: closestDistance < timeThreshold,
+      snapTarget,
+    };
+  }
+
+}

diff --git a/frontend/src/features/video/vendor/openreel/editing-frame-rate.mjs b/frontend/src/features/video/vendor/openreel/editing-frame-rate.mjs
--- a/frontend/src/features/video/vendor/openreel/editing-frame-rate.mjs
+++ b/frontend/src/features/video/vendor/openreel/editing-frame-rate.mjs
@@ -0,0 +1,44 @@
+// Port of augani/openreel-video@367d7e90b61b5181f9861b852bb8b9d7a7d2954a
+// MIT © 2024–2026 Augustus Otu and Contributors; vendor/openreel/LICENSE.
+export const DEFAULT_EDITING_FRAME_RATE = 30;
+
+export const EDITING_FRAME_RATE_OPTIONS = [
+  { value: 23.976, label: "23.976 fps" },
+  { value: 24, label: "24 fps" },
+  { value: 25, label: "25 fps" },
+  { value: 29.97, label: "29.97 fps" },
+  { value: 30, label: "30 fps" },
+  { value: 50, label: "50 fps" },
+  { value: 59.94, label: "59.94 fps" },
+  { value: 60, label: "60 fps" },
+];
+
+export function normalizeEditingFrameRate(frameRate) {
+  if (!Number.isFinite(frameRate) || frameRate <= 0) {
+    return DEFAULT_EDITING_FRAME_RATE;
+  }
+  return Math.min(240, frameRate);
+}
+
+export function editingFrameDurationMs(frameRate) {
+  return 1000 / normalizeEditingFrameRate(frameRate);
+}
+
+export function editingFrameStepSeconds(frameRate) {
+  return 1 / normalizeEditingFrameRate(frameRate);
+}
+
+/** Move to an adjacent frame boundary, including after a fractional-time seek. */
+export function stepEditingFrame(
+  position,
+  direction,
+  frameRate,
+) {
+  const rate = normalizeEditingFrameRate(frameRate);
+  const frame = Math.max(0, Number.isFinite(position) ? position : 0) * rate;
+  // Tolerate floating point error when an existing seek is exactly on a frame.
+  const next = direction === 1
+    ? Math.floor(frame + 1e-7) + 1
+    : Math.ceil(frame - 1e-7) - 1;
+  return Math.max(0, next / rate);
+}

diff --git a/frontend/src/features/video/vendor/openreel/frame-timecode.mjs b/frontend/src/features/video/vendor/openreel/frame-timecode.mjs
--- a/frontend/src/features/video/vendor/openreel/frame-timecode.mjs
+++ b/frontend/src/features/video/vendor/openreel/frame-timecode.mjs
@@ -0,0 +1,32 @@
+// Port of augani/openreel-video@367d7e90b61b5181f9861b852bb8b9d7a7d2954a
+// MIT © 2024–2026 Augustus Otu and Contributors; vendor/openreel/LICENSE.
+import { normalizeEditingFrameRate } from "./editing-frame-rate.mjs";
+
+/** Non-drop-frame labels count frames, including at fractional project rates. */
+export function formatFrameTimecode(seconds, frameRate) {
+  const rate = normalizeEditingFrameRate(frameRate);
+  const nominal = Math.max(1, Math.round(rate));
+  const total = Math.max(0, Math.round((Number.isFinite(seconds) ? seconds : 0) * rate));
+  const frames = total % nominal;
+  const whole = Math.floor(total / nominal);
+  return [Math.floor(whole / 3600), Math.floor(whole / 60) % 60, whole % 60, frames]
+    .map((value, index) => String(value).padStart(index === 3 && nominal > 100 ? 3 : 2, "0")).join(":");
+}
+
+/** Accept HH:MM:SS:FF, MM:SS:FF, MM:SS, or a number of seconds. */
+export function parseFrameTimecode(value, frameRate) {
+  const rate = normalizeEditingFrameRate(frameRate);
+  const parts = value.trim().split(":");
+  let frames;
+  if (parts.length === 1 && /^\d+(?:\.\d+)?$/.test(parts[0])) {
+    frames = Math.round(Number(parts[0]) * rate);
+  } else if (parts.length === 2 && /^\d+$/.test(parts[0]) && /^\d{1,2}(?:\.\d+)?$/.test(parts[1]) && Number(parts[1]) < 60) {
+    frames = Math.round((Number(parts[0]) * 60 + Number(parts[1])) * rate);
+  } else if ((parts.length === 3 || parts.length === 4) && parts.every((part) => /^\d+$/.test(part))) {
+    const nominal = Math.max(1, Math.round(rate));
+    const [hours, minutes, seconds, frame] = parts.length === 4 ? parts.map(Number) : [0, ...parts.map(Number)];
+    if (seconds >= 60 || frame >= nominal || (parts.length === 4 && minutes >= 60)) return null;
+    frames = ((hours * 60 + minutes) * 60 + seconds) * nominal + frame;
+  } else return null;
+  return Number.isSafeInteger(frames) && frames >= 0 ? frames / rate : null;
+}

diff --git a/frontend/src/features/video/vendor/openreel/timeline-item-actions.mjs b/frontend/src/features/video/vendor/openreel/timeline-item-actions.mjs
--- a/frontend/src/features/video/vendor/openreel/timeline-item-actions.mjs
+++ b/frontend/src/features/video/vendor/openreel/timeline-item-actions.mjs
@@ -0,0 +1,70 @@
+// Copied functional subset from augani/openreel-video/apps/web/src/utils/timeline-item-actions.ts
+// Pinned 367d7e90b61b5181f9861b852bb8b9d7a7d2954a; MIT © 2024-2026 Augustus Otu and Contributors.
+// Removed TypeScript types and store-mutating handlers. Pure track/clip selection only.
+export function getTimelineItemRanges(project) {
+  const items = [];
+
+  for (const track of project.timeline.tracks) {
+    for (const clip of track.clips) {
+      items.push({
+        id: clip.id,
+        trackId: track.id,
+        startTime: clip.startTime,
+        duration: clip.duration,
+        kind: "media",
+      });
+    }
+  }
+
+  const append = (clips, kind) => {
+    for (const clip of clips ?? []) {
+      items.push({ ...clip, kind });
+    }
+  };
+
+  append(project.textClips, "text");
+  append(project.shapeClips, "shape");
+  append(project.svgClips, "svg");
+  append(project.stickerClips, "sticker");
+
+  return items;
+}
+
+export function getSplittableTimelineItemIds(
+  project, selectedIds, time) {
+  const selected = new Set(selectedIds);
+  return getTimelineItemRanges(project)
+    .filter(
+      (item) =>
+        selected.has(item.id) &&
+        time > item.startTime &&
+        time < item.startTime + item.duration,
+    )
+    .map((item) => item.id);
+}
+
+export function getTimelineSelectionItems(project) {
+  return getTimelineItemRanges(project).map(toSelectionItem);
+}
+
+/** Select every media or overlay clip assigned to one timeline track. */
+export function getTimelineTrackSelection(
+  project, trackId) {
+  return getTimelineItemRanges(project)
+    .filter((item) => item.trackId === trackId)
+    .sort((left, right) =>
+      left.startTime === right.startTime
+        ? left.id.localeCompare(right.id)
+        : left.startTime - right.startTime,
+    )
+    .map(toSelectionItem);
+}
+
+function toSelectionItem(item) {
+  return {
+    id: item.id,
+    trackId: item.trackId,
+    type: item.kind === "media" ? "clip" : item.kind === "text" ? "text-clip" : "shape-clip",
+  };
+}
+

