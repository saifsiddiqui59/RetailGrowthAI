diff --git a/video-engine/feature4_quality_receipt.py b/video-engine/feature4_quality_receipt.py
--- a/video-engine/feature4_quality_receipt.py
+++ b/video-engine/feature4_quality_receipt.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Feature4 cross-feature QA evidence receipt for the ACTUAL encoded stock Reel.
+
+Hashes real privately staged files and checks media/QA evidence agree; does not
+authorize tenant assets, certify AI try-on, license viral songs, inspect spoken
+accuracy, grant downloads, or promote stock edits to marketing approval.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from urllib.parse import urlsplit
+from feature4_private_preview import inspect_mp4, PreviewExportError
+
+MAX_JSON_BYTES=2_000_000
+
+class QualityReceiptError(ValueError):
+    pass
+
+def _json(path):
+    p=Path(path)
+    if p.is_symlink() or not p.is_file() or not 16<=p.stat().st_size<=MAX_JSON_BYTES:
+        raise QualityReceiptError("Missing, unsafe or oversized QA JSON")
+    try:
+        return json.loads(p.read_text(encoding="utf-8"))
+    except (OSError,ValueError,UnicodeDecodeError) as exc:
+        raise QualityReceiptError("QA JSON failed strict decoding") from exc
+
+def _hash(path):
+    p=Path(path)
+    if p.is_symlink() or not p.is_file() or p.stat().st_size>80_000_000:
+        raise QualityReceiptError("Invalid or oversized local evidence file")
+    digest=hashlib.sha256()
+    with p.open("rb") as stream:
+        while block:=stream.read(1024*1024):
+            digest.update(block)
+    return digest.hexdigest()
+
+def validate_stock_receipt(*, original, master, preview,
+                           provenance, motion_proof, master_proof,
+                           preview_proof, editorial_proof):
+    inputs=[Path(x) for x in (original,master,preview)]
+    p,m,a,v,e=map(_json,(provenance,motion_proof,master_proof,preview_proof,editorial_proof))
+    h0,h1,h2=map(_hash,inputs)
+    try:
+        raw=inspect_mp4(inputs[0],max_size=80*1024*1024)
+        mastered=inspect_mp4(inputs[1],max_size=80*1024*1024)
+        small=inspect_mp4(inputs[2],max_size=8*1024*1024)
+    except PreviewExportError as exc:
+        raise QualityReceiptError("QA MP4 codec or source identity failed") from exc
+    if any(abs(record["seconds"]-30)>.4 for record in (raw,mastered,small)):
+        raise QualityReceiptError("QA sample did not encode full 30 seconds")
+    if any((rec["width"],rec["height"])!=(1080,1920) for rec in (raw,mastered)):
+        raise QualityReceiptError("Original or audio-mastered video not Full-HD")
+    if (small["width"],small["height"])!=(540,960):
+        raise QualityReceiptError("Reviewer preview not bounded 540p")
+    if not (v.get("source_sha256")==h1 and v.get("preview_sha256")==h2
+            and a.get("source_sha256")==h0 and a.get("master_sha256")==h1
+            and m.get("source_sha256")==h0):
+        raise QualityReceiptError("Source, master, preview, and motion hashes do not chain")
+    if not (p.get("duration_seconds")==30 and p.get("scene_count")==7
+            and p.get("status")=="OFFLINE_CROSS_FEATURE_STOCK_TEST_ONLY"
+            and p.get("commercial_release_eligible") is False
+            and p.get("model_garment_match_verified") is False
+            and p.get("actual_spoken_voiceover") is False
+            and p.get("showcase_eligible") is False):
+        raise QualityReceiptError("Stock provenance is missing explicit safety flags")
+    media=p.get("source_media")
+    if (not isinstance(media,list) or len(media)!=5 or
+            len({x.get("source_id") for x in media})!=5 or
+            sum(x.get("source_feature")=="feature3_garment_proxy" for x in media)!=2 or
+            sum(x.get("source_feature")=="feature5_stock_proxy" for x in media)!=3 or
+            any(urlsplit(x.get("page","")).hostname!="www.pexels.com" for x in media)):
+        raise QualityReceiptError("Pexels stock inputs or source rights lineage incomplete")
+    if (m.get("status")!="MOVING_PIXELS_VERIFIED_NOT_CONTENT_APPROVAL"
+            or m.get("commercial_release_eligible") is not False
+            or len(m.get("checked_moving_scenes",[]))!=3
+            or any(x.get("luma_difference",0)<=m.get("threshold_luma_difference",0)
+                   for x in m["checked_moving_scenes"])):
+        raise QualityReceiptError("Decoded moving actor shot verification missing")
+    if (a.get("status")!="PRIVATE_AUDIO_MASTERED_NOT_PUBLISHED"
+            or a.get("signed_download_ready") is not False
+            or a.get("commercial_release_eligible") is not False
+            or a.get("mastered_audio_mean_db",-100)<-32):
+        raise QualityReceiptError("Soundtrack mastering record missing or unsafe")
+    if (v.get("status")!="PRIVATE_PREVIEW_ENCODED_NOT_PUBLISHED"
+            or v.get("signed_download_ready") is not False or
+            v.get("commercial_release_eligible") is not False):
+        raise QualityReceiptError("Mobile preview marked published or missing")
+    if (e.get("caption_kind")!="EDITORIAL_TEST_TITLES_NOT_SPOKEN_AUDIO"
+            or e.get("speech_text_alignment_verified_here") is not False
+            or e.get("signed_download_ready") is not False
+            or e.get("cue_count")!=7):
+        raise QualityReceiptError("Editorial captions incorrectly claimed spoken alignment")
+    features={
+        "feature2":{"status":"TEST_PROXY_ONLY","evidence":"Original synthesized music; editorial titles; no real spoken voice/licensed trends"},
+        "feature3":{"status":"TEST_PROXY_ONLY","evidence":"Two independent Pexels garment-reference PHOTOS; not approved shop garments or on-model match"},
+        "feature4":{"status":"OFFLINE_MEDIA_TECHNICAL_PASS","evidence":"Actual H264/AAC 30s Full-HD MP4; decoded motion; SHA-linked audio master, 540p preview and captions"},
+        "feature5":{"status":"STOCK_MOTION_PROXY_ONLY","evidence":"Three Pexels human-motion clips; no AI video inference or garment identity"},
+        "feature7":{"status":"LIMITED_TIMELINE_ONLY","evidence":"Seven measured-beat cuts; advanced semantic editor not accepted"},
+    }
+    return {
+        "schema":"feature4_stock_qa_receipt_v1",
+        "render_duration_seconds":30,
+        "files":{"original_sha256":h0,"master_sha256":h1,"preview_sha256":h2},
+        "features":features,
+        "quality_metrics":{"moving_scene_luma":m["checked_moving_scenes"],
+                           "source_mean_db":a["source_audio_mean_db"],
+                           "mastered_mean_db":a["mastered_audio_mean_db"],
+                           "editorial_caption_cues":e["cue_count"]},
+        "blockers":["Feature3 actual shop product/model fidelity",
+                    "Feature5 real AI-generated motion lineage",
+                    "Feature2 actual voice and music commercial rights",
+                    "Feature7 advanced timeline/effects visual parity",
+                    "Azure issue249 and authenticated private signed-download release",
+                    "Explicit owner visual and commercial acceptance"],
+        "commercial_release_eligible":False,
+        "human_approved":False,"signed_download_ready":False,
+    }
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    for name in ("original","master","preview","provenance","motion-proof",
+                 "master-proof","preview-proof","editorial-proof","output"):
+        ap.add_argument("--"+name,required=True)
+    args=ap.parse_args()
+    kw={key.replace("-","_"):getattr(args,key.replace("-","_")) for key in
+        ("original","master","preview","provenance","motion-proof",
+         "master-proof","preview-proof","editorial-proof")}
+    result=validate_stock_receipt(**kw)
+    output=Path(args.output)
+    if output.exists() or output.is_symlink() or not output.parent.is_dir():
+        raise QualityReceiptError("Receipt destination must be a new local file")
+    output.write_text(json.dumps(result,indent=2)+"\n",encoding="utf-8")
+    print(json.dumps({"status":"QUALITY_EVIDENCE_LINKED_NO_RELEASE",
+                      "features":list(result["features"]),
+                      "release_ready":result["commercial_release_eligible"]}))
+if __name__=="__main__":
+    main()

diff --git a/video-engine/feature4_release_gate.py b/video-engine/feature4_release_gate.py
--- a/video-engine/feature4_release_gate.py
+++ b/video-engine/feature4_release_gate.py
@@ -0,0 +1,157 @@
+"""Feature4 visual/business acceptance gate, NEVER inferred from a successful encode.
+
+This checks that a trusted coordinator-backed human-review record covers the
+same immutable renderer job and actual uploaded product/motion asset IDs. It
+does NOT computer-vision verify garment fidelity or produce a DB approval;
+human review is mandatory, and browser assertions are never authoritative.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+from uuid import UUID
+
+from creative_contract import CreativeContractError
+
+CHECKS = frozenset({
+    "human_model_realism", "garment_design_match", "natural_walking",
+    "readable_shop_logo", "verified_sale_offer", "licensed_soundtrack",
+    "speech_intelligibility", "mobile_legibility",
+})
+MAX_REVIEW_AGE_DAYS = 90
+MAX_PROOF_BYTES = 80 * 1024 * 1024
+
+
+class ReleaseNotApproved(CreativeContractError):
+    """An ordinary engineering render is not a paying-customer approval."""
+
+
+@dataclass(frozen=True)
+class ReviewedVideo:
+    shop_id: str
+    video_job_id: str
+    approved_product_id: str
+    approved_motion_id: str
+    review_id: str
+    reviewer_id: str
+    reviewed_at: str
+    evidence_refs: tuple[str, ...]
+
+
+def _identifier(value, name):
+    if type(value) is not str:
+        raise ReleaseNotApproved(name + ": canonical UUID required")
+    try:
+        result = str(UUID(value))
+    except (TypeError, ValueError, AttributeError) as exc:
+        raise ReleaseNotApproved(name + ": canonical UUID required") from exc
+    if result != value:
+        raise ReleaseNotApproved(name + ": canonical UUID required")
+    return value
+
+
+def _parse_time(value):
+    if type(value) is not str or not value.endswith("Z"):
+        raise ReleaseNotApproved("Recorded UTC human review time required")
+    try:
+        when = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as exc:
+        raise ReleaseNotApproved("Invalid reviewed-at timestamp") from exc
+    if when.utcoffset() != timedelta(0):
+        raise ReleaseNotApproved("Review timestamp must be UTC")
+    return when
+
+
+def validate_feature4_release(*, job, lineage, reviewed, media, now=None):
+    """Validate trusted service-fetched review; return lineage-only acceptance.
+
+    In coordinator integration, job, lineage, reviewed and media MUST be loaded
+    afresh from a server-owned DB under trusted service identity, NOT HTTP body.
+    The review may only be stored after a real human views the actual MP4.
+    """
+    if not all(type(x) is dict for x in (job, lineage, reviewed, media)):
+        raise ReleaseNotApproved("Server-owned job, lineage, media and review required")
+    shop = _identifier(job.get("shop_id"), "shop_id")
+    jid = _identifier(job.get("id"), "job_id")
+    if job.get("status") != "SUCCEEDED" or job.get("output_asset_id") is None:
+        raise ReleaseNotApproved("Only verified, completed private renders are eligible")
+    # A present-but-foreign/empty output reference is not an immutable asset ID.
+    _identifier(job["output_asset_id"], "output_asset_id")
+    if (lineage.get("video_job_id") != jid or
+            lineage.get("rendered_as") != "AUTHORIZED_ASSEMBLY" or
+            lineage.get("fallback_events") != []):
+        raise ReleaseNotApproved("Synthetic fallback or mismatched render lineage")
+    if reviewed.get("shop_id") != shop or reviewed.get("video_job_id") != jid:
+        raise ReleaseNotApproved("Review must match the same tenant and immutable video job")
+    product = _identifier(reviewed.get("approved_product_id"), "product media")
+    motion = _identifier(reviewed.get("approved_motion_id"), "motion media")
+    expected = lineage.get("media_asset_ids")
+    if (type(expected) is not list or not 2 <= len(expected) <= 36 or
+            product not in expected or motion not in expected or product == motion):
+        raise ReleaseNotApproved("Review must cover actually assembled product and motion media")
+    # Product/motion approval alone is insufficient: an otherwise approved Reel
+    # could still embed revoked, foreign-shop or synthetic audio/stock/logo.
+    # All rows must be fresh trusted DB reads, not browser-provided grants.
+    for asset_id in expected:
+        _identifier(asset_id, "lineage media asset")
+    if len(set(expected)) != len(expected):
+        raise ReleaseNotApproved("Duplicate media asset IDs in render lineage")
+    for asset_id in expected:
+        row = media.get(asset_id)
+        if type(row) is dict and row.get("synthetic_fixture") is not False:
+            raise ReleaseNotApproved("Synthetic or unknown fixture provenance cannot be published")
+        if (type(row) is not dict or row.get("shop_id") != shop or
+                row.get("approved") is not True or
+                row.get("commercial_use") is not True or
+                row.get("synthetic_fixture") is not False or
+                type(row.get("kind")) is not str or
+                row["kind"] not in {"image", "poster", "logo", "video", "audio"} or
+                type(row.get("source_feature")) is not str or
+                not row["source_feature"].strip() or
+                type(row.get("rights_evidence")) is not str or
+                not row["rights_evidence"].strip()):
+            raise ReleaseNotApproved("Every rendered media asset requires current same-shop rights")
+    p, m = media.get(product), media.get(motion)
+    for row, kind, origin in ((p, "image", "feature3"), (m, "video", "feature5")):
+        if (type(row) is not dict or row.get("shop_id") != shop
+                or row.get("kind") != kind or row.get("source_feature") != origin
+                or row.get("approved") is not True or
+                row.get("commercial_use") is not True or
+                not row.get("rights_evidence")):
+            raise ReleaseNotApproved("Real source media rights and provenance unverified")
+        # Explicitly never treat a source provider's SYNTHETIC_TEST_ONLY flag
+        # as a real user-approved human or retailer product.
+        if row.get("synthetic_fixture") is not False:
+            raise ReleaseNotApproved("Synthetic or unknown fixture provenance cannot be published")
+    if (type(reviewed.get("approved")) is not bool or reviewed["approved"] is not True
+            or type(reviewed.get("review_id")) is not str
+            or not reviewed["review_id"].strip()
+            or type(reviewed.get("reviewer_id")) is not str
+            or not reviewed["reviewer_id"].strip()):
+        raise ReleaseNotApproved("Independently saved reviewer approval required")
+    checklist = reviewed.get("checks")
+    if (type(checklist) is not dict or set(checklist) != CHECKS or
+            any(value is not True for value in checklist.values())):
+        raise ReleaseNotApproved("All professional video quality checks must be human-approved")
+    refs = reviewed.get("evidence_refs")
+    if (type(refs) is not list or not 2 <= len(refs) <= 20 or
+            any(type(ref) is not str or not ref or len(ref) > 180 for ref in refs)):
+        raise ReleaseNotApproved("Recorded verified product/motion comparison evidence required")
+    checked = _parse_time(reviewed.get("reviewed_at"))
+    current = now if now is not None else datetime.now(timezone.utc)
+    if current.tzinfo is None or checked > current + timedelta(minutes=5) or (
+            current - checked > timedelta(days=MAX_REVIEW_AGE_DAYS)):
+        raise ReleaseNotApproved("Human review too old or future-dated")
+    proof = job.get("output_probe")
+    if (type(proof) is not dict or proof.get("video_codec") != "h264" or
+            proof.get("audio_codec") != "aac" or
+            proof.get("width") != 1080 or proof.get("height") != 1920 or
+            proof.get("duration_seconds") not in (15.0, 30.0, 60.0) or
+            type(proof.get("bytes")) is not int or not 1024 < proof["bytes"] <= MAX_PROOF_BYTES):
+        raise ReleaseNotApproved("Actual production Full-HD MP4 output proof required")
+    return ReviewedVideo(
+        shop_id=shop, video_job_id=jid, approved_product_id=product,
+        approved_motion_id=motion, review_id=reviewed["review_id"],
+        reviewer_id=reviewed["reviewer_id"], reviewed_at=reviewed["reviewed_at"],
+        evidence_refs=tuple(refs),
+    )

diff --git a/video-engine/feature4_review_contact_sheet.py b/video-engine/feature4_review_contact_sheet.py
--- a/video-engine/feature4_review_contact_sheet.py
+++ b/video-engine/feature4_review_contact_sheet.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Private stock-video reviewer contact sheet: actual encoded frames, not a mock.
+
+This source-only helper is not a media grant, object-storage publisher, human
+quality judgment, garment identifier or commercial-use authorization.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+from PIL import Image, ImageDraw
+from feature4_private_preview import inspect_mp4, PreviewExportError
+
+class ContactSheetError(ValueError):
+    pass
+
+WIDTH,HEIGHT=180,320
+COLUMNS=3
+FRAME_COUNT=12
+
+def _sha(path):
+    digest=hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda:stream.read(1024*1024),b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+TOP=64
+CELL_H=346
+
+def _frame(source, at):
+    try:
+        data=subprocess.run([
+            "ffmpeg","-nostdin","-v","error","-protocol_whitelist","file",
+            "-ss",f"{at:.3f}","-i",str(source),"-map","0:v:0",
+            "-vf",f"scale={WIDTH}:{HEIGHT}:flags=bicubic,setsar=1",
+            "-frames:v","1","-pix_fmt","rgb24","-f","rawvideo","pipe:1",
+        ],check=True,capture_output=True,timeout=35).stdout
+    except (OSError,subprocess.SubprocessError) as exc:
+        raise ContactSheetError("Could not extract verified encoded video frame") from exc
+    if len(data)!=WIDTH*HEIGHT*3:
+        raise ContactSheetError("FFmpeg frame data truncated or invalid")
+    return Image.frombytes("RGB",(WIDTH,HEIGHT),data)
+
+def render_contact_sheet(source: Path, output: Path, *, seconds: int):
+    if type(seconds) is not int or seconds not in (15,30,60):
+        raise ContactSheetError("Expected bounded verified 15/30/60-second video")
+    source,output=Path(source),Path(output)
+    if output.suffix.lower() not in (".jpg",".jpeg") or output.is_symlink() or output.exists():
+        raise ContactSheetError("Contact sheet must have a fresh local JPEG destination")
+    if not output.parent.is_dir() or output.parent.is_symlink():
+        raise ContactSheetError("Contact sheet must remain in a pre-existing private directory")
+    try:
+        media=inspect_mp4(source,max_size=80*1024*1024)
+    except PreviewExportError as exc:
+        raise ContactSheetError("Source not validated H264/AAC portrait MP4") from exc
+    if abs(media["seconds"]-seconds)>.45:
+        raise ContactSheetError("Source duration mismatch")
+    source_sha=_sha(source)
+    canvas=Image.new("RGB",(WIDTH*COLUMNS,TOP+CELL_H*4),(16,21,28))
+    draw=ImageDraw.Draw(canvas)
+    draw.text((10,12),"F4 STOCK QA / NOT A RETAILER AD",fill=(250,211,145))
+    draw.text((10,35),f"ENCODED FRAMES  |  {seconds}s  |  NO PRODUCT MATCH CLAIM",fill=(200,205,210))
+    frames=[]
+    fingerprints=[]
+    possible_repeats=[]
+    for i in range(FRAME_COUNT):
+        at=round((i+.5)*seconds/FRAME_COUNT,3)
+        image=_frame(source,at)
+        x=(i%COLUMNS)*WIDTH
+        y=TOP+(i//COLUMNS)*CELL_H
+        canvas.paste(image,(x,y))
+        draw.text((x+6,y+323),f"{at:05.2f}s / STOCK",fill=(236,236,236))
+        # Compare source picture content, not the overlaid timestamp/banner.
+        # Wide separation avoids false positives within an intended shot.
+        signature=image.crop((0,0,WIDTH,250)).convert("L").resize((24,32)).tobytes()
+        for old_time,old_signature in fingerprints:
+            if at-old_time < seconds/3:
+                continue
+            difference=sum(abs(a-b) for a,b in zip(signature,old_signature))/len(signature)
+            if difference < 4.0:
+                possible_repeats.append({"earlier_seconds":old_time,
+                                         "later_seconds":at,
+                                         "mean_luma_delta":round(difference,2)})
+        fingerprints.append((at,signature))
+        frames.append(at)
+    if _sha(source)!=source_sha:
+        raise ContactSheetError("Encoded Reel changed while contact-sheet frames were decoded")
+    temp=None
+    try:
+        with tempfile.NamedTemporaryFile(prefix=".f4-review-",suffix=".jpg",
+                                         dir=str(output.parent),delete=False) as tmp:
+            temp=Path(tmp.name)
+        canvas.save(temp,format="JPEG",quality=85,optimize=True)
+        # No overwrite, even if another reviewer writer won a race.
+        os.link(temp,output)
+        temp.unlink()
+        temp=None
+    except (OSError,ValueError) as exc:
+        raise ContactSheetError("Could not securely write private reviewer JPEG") from exc
+    finally:
+        if temp is not None:
+            temp.unlink(missing_ok=True)
+    if _sha(source)!=source_sha:
+        output.unlink(missing_ok=True)  # This invocation created the fresh hard-link.
+        raise ContactSheetError("Encoded Reel changed during private contact-sheet export")
+    sha=_sha(output)
+    return {"status":"ENCODED_REVIEW_CONTACT_SHEET_NOT_APPROVAL",
+            "source_sha256":source_sha,
+            "contact_sheet_sha256":sha,"duration_seconds":seconds,
+            "frames_seconds":frames,"frame_count":FRAME_COUNT,
+            "possible_repeated_shot_pairs":possible_repeats[:20],
+            "repetition_warning":bool(possible_repeats),
+            "visual_diversity_accepted":False,
+            "commercial_release_eligible":False,
+            "owner_visual_approval":False,"garment_identity_verified":False}
+
+if __name__=="__main__":
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--source",required=True)
+    ap.add_argument("--duration",required=True,type=int,choices=(15,30,60))
+    ap.add_argument("--output",required=True)
+    args=ap.parse_args()
+    proof=render_contact_sheet(Path(args.source),Path(args.output),seconds=args.duration)
+    print(proof)

diff --git a/video-engine/feature4_scene_visibility.py b/video-engine/feature4_scene_visibility.py
--- a/video-engine/feature4_scene_visibility.py
+++ b/video-engine/feature4_scene_visibility.py
@@ -0,0 +1,176 @@
+#!/usr/bin/env python3
+"""Sample actual encoded scene pixels for sustained empty/black scene defects.
+
+Technical Full-HD / mobile H264-AAC QA only. Cannot determine editorial taste,
+product identity, copyright, human anatomy, consent, or unexpected overlays.
+Media paths/timecodes come from trusted immutable render provenance, never HTTP.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import math
+import re
+from pathlib import Path
+import subprocess
+
+from feature4_private_preview import inspect_mp4, PreviewExportError
+
+
+class VisibilityProofError(ValueError):
+    pass
+
+
+def _pixel_frame(path, at):
+    try:
+        result=subprocess.run(
+            ["ffmpeg","-nostdin","-hide_banner","-loglevel","error",
+             "-protocol_whitelist","file","-ss",f"{at:.3f}","-i",str(path),
+             "-map","0:v:0","-frames:v","1",
+             "-vf","scale=60:100,format=gray","-f","rawvideo","-"],
+            check=True,capture_output=True,timeout=35)
+    except (OSError,subprocess.SubprocessError) as exc:
+        raise VisibilityProofError("Actual video scene sample cannot be decoded") from exc
+    if len(result.stdout)!=6000:
+        raise VisibilityProofError("Decoded scene grayscale pixels incomplete")
+    values=result.stdout
+    return {"time_seconds":round(at,3),
+            "mean_luma":round(sum(values)/len(values),2),
+            "near_black_fraction":round(sum(v<=12 for v in values)/len(values),4)}
+
+
+def _sha(path:Path):
+    digest=hashlib.sha256()
+    with Path(path).open("rb") as media:
+        for chunk in iter(lambda:media.read(1024*1024),b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+# Independent full-file decoder detects sustained black holds between sample
+# probes without claiming that every sub-second blank frame is impossible.
+INTERIOR_SAMPLE_FRACTIONS=(.15,.30,.50,.70,.85)
+BLACK_HOLD_MIN_SECONDS=.65
+_BLACK_HOLD_RX=re.compile(
+    r"black_start:(\d+(?:\.\d+)?)\s+black_end:(\d+(?:\.\d+)?)"
+    r"\s+black_duration:(\d+(?:\.\d+)?)"
+)
+
+
+def _continuous_black_holds(source, *, seconds):
+    """Scan all decoded video frames for >=.65s near-uniform black holds."""
+    try:
+        run=subprocess.run([
+            "ffmpeg","-nostdin","-hide_banner","-loglevel","info",
+            "-protocol_whitelist","file","-i",str(source),
+            "-map","0:v:0",
+            "-vf","blackdetect=d=0.65:pix_th=0.05:pic_th=0.98",
+            "-an","-f","null","-",
+        ],capture_output=True,text=True,check=True,timeout=160)
+    except (OSError,subprocess.SubprocessError) as exc:
+        raise VisibilityProofError("Continuous actual encoded black-frame scan failed") from exc
+    matches=list(_BLACK_HOLD_RX.finditer(run.stderr))
+    if run.stderr.count("black_start:")!=len(matches):
+        raise VisibilityProofError("Incomplete black-frame scan evidence")
+    holds=[]
+    for match in matches:
+        start,end,span=map(float,match.groups())
+        if (not all(math.isfinite(x) for x in (start,end,span))
+                or start<0 or end<=start or end>seconds+.5
+                or abs(end-start-span)>.08 or span<BLACK_HOLD_MIN_SECONDS-.09):
+            raise VisibilityProofError("Inconsistent continuous black-frame event")
+        holds.append((round(start,3),round(end,3),round(span,3)))
+    return holds
+
+
+def verify_scene_visibility(source:Path,*,seconds:int,scenes):
+    """Reject sampled near-black frames *inside* every trusted scene window.
+
+    Two 30/70-percent samples could miss a fully black center interval. Five
+    interior samples catch that regression; intentional full-black interludes
+    must be explicitly edited out before this stock quality acceptance. A
+    sampled pass never certifies all frames or human/editorial acceptance.
+    """
+    if type(seconds) is not int or seconds not in (15,30,60):
+        raise VisibilityProofError("Unsupported fixed Reel duration")
+    if type(scenes) is not list or not 2<=len(scenes)<=12:
+        raise VisibilityProofError("Trusted fixed scene segments required")
+    elapsed=0.0
+    for scene in scenes:
+        if type(scene) is not dict or set(scene)!={"start","duration"}:
+            raise VisibilityProofError("Unreviewed scene timing fields")
+        start=scene["start"]
+        span=scene["duration"]
+        if (type(start) not in (int,float) or type(span) not in (int,float)
+                or not math.isfinite(start) or not math.isfinite(span)
+                or span<.5 or abs(start-elapsed)>.002
+                or start<0 or span>seconds):
+            raise VisibilityProofError("Noncontiguous or unsupported trusted scene")
+        elapsed=round(start+span,3)
+    if abs(elapsed-seconds)>.003:
+        raise VisibilityProofError("Visual QA requires the complete expected Reel timeline")
+    try:
+        record=inspect_mp4(Path(source),max_size=80*1024*1024)
+    except PreviewExportError as exc:
+        raise VisibilityProofError("Visual QA requires valid encoded H264/AAC media") from exc
+    if (abs(record["seconds"]-seconds)>.45
+            or (record["width"],record["height"]) not in ((540,960),(1080,1920))):
+        raise VisibilityProofError("Visual QA source profile differs from approved Reel")
+    source_sha=_sha(source)
+    checked=[]
+    for scene in scenes:
+        start,span=scene["start"],scene["duration"]
+        # Exact interior fractions are checked again by the final receipt.
+        samples=[_pixel_frame(source,start+fraction*span)
+                 for fraction in INTERIOR_SAMPLE_FRACTIONS]
+        blank=any(x["near_black_fraction"]>=.985 and x["mean_luma"]<=14
+                  for x in samples)
+        checked.append({"scene_start":start,"duration":span,
+                        "samples":samples,"sustained_near_black":blank})
+        if blank:
+            raise VisibilityProofError(f"Encoded scene at {start}s has a nearly entirely blank/black sample")
+    holds=_continuous_black_holds(source,seconds=seconds)
+    if _sha(source)!=source_sha:
+        raise VisibilityProofError("Encoded Reel bytes changed while scene frames were decoded")
+    if holds:
+        raise VisibilityProofError("Encoded Reel contains a sustained continuous black hold")
+    return {"schema":"feature4_scene_visibility_v3",
+            "status":"SAMPLED_SCENES_NOT_BLANK_NOT_CONTENT_APPROVAL",
+            "source_sha256":source_sha,
+            "sample_fractions":list(INTERIOR_SAMPLE_FRACTIONS),
+            "seconds":seconds,"checked_scene_count":len(scenes),
+            "checked_scenes":checked,"sustained_near_black_count":0,
+            "continuous_full_reel_black_scan":True,
+            "continuous_black_hold_threshold_seconds":BLACK_HOLD_MIN_SECONDS,
+            "continuous_long_black_holds_count":0,
+            "sub_threshold_blank_frames_certified_absent":False,
+            "short_blank_frames_excluded_by_sampling":False,
+            "unexpected_overlay_absence_verified":False,
+            "commercial_release_eligible":False,
+            "garment_identity_verified":False}
+
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--source",required=True)
+    ap.add_argument("--duration",required=True,type=int,choices=(15,30,60))
+    ap.add_argument("--provenance",required=True)
+    ap.add_argument("--report",required=True)
+    args=ap.parse_args()
+    source,prov,report=Path(args.source),Path(args.provenance),Path(args.report)
+    if (prov.is_symlink() or not prov.is_file() or prov.stat().st_size>250000
+            or report.is_symlink() or report.exists() or not report.parent.is_dir()):
+        raise VisibilityProofError("Source provenance/report must be a private fresh file")
+    p=json.loads(prov.read_text(encoding="utf-8"))
+    if (not isinstance(p,dict) or p.get("duration_seconds")!=args.duration
+            or p.get("status")!="OFFLINE_CROSS_FEATURE_STOCK_TEST_ONLY"
+            or p.get("commercial_release_eligible") is not False
+            or not isinstance(p.get("scene_windows"),list)):
+        raise VisibilityProofError("Expected immutable technical-only scene provenance")
+    result=verify_scene_visibility(source,seconds=args.duration,scenes=p["scene_windows"])
+    report.write_text(json.dumps(result,indent=2)+"\n",encoding="utf-8")
+    print(json.dumps({"status":result["status"],"count":result["checked_scene_count"]}))
+
+
+if __name__=="__main__":
+    main()

