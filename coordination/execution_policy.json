{
  "schema_version": 1,
  "scope": {
    "active_features": [
      "2",
      "3",
      "4",
      "5",
      "7"
    ],
    "development_closed_features": [
      "1"
    ],
    "feature_task_inventory": "coordination/feature_tasks.json",
    "dependency_registry": "coordination/dependencies.json"
  },
  "concurrency": {
    "max_running_independent_coding_tasks": 10,
    "distinct_branch_and_worktree_required": true,
    "atomic_issue_claim_required": true,
    "availability": "Not enforceable until approved coding agent executor is connected. The issue coordinator does not launch workers."
  },
  "batching": {
    "coherent_related_tasks_before_commit": true,
    "run_targeted_tests_during_batch": true,
    "full_four_job_ci_at_batch_boundaries": true,
    "exact_head_pr_ci_required": true,
    "postmerge_main_ci_required": true,
    "avoid_repeated_full_ci_after_trivial_microcommits": true
  },
  "completion": {
    "status_labels": [
      "DONE",
      "IN PROGRESS",
      "FAILED",
      "BLOCKED"
    ],
    "source_implemented_is_not_integrated_done": true,
    "task_done_requires": [
      "agreed_task_acceptance",
      "verified_evidence",
      "approved_integration_into_main",
      "fresh_main_four_job_ci"
    ],
    "separately_record_source_status_and_live_release_gate": true,
    "never_reopen_verified_implemented_work": true,
    "never_claim_fixture_is_production": true
  },
  "retry": {
    "additional_attempts_on_recoverable_failure": 2,
    "hide_intermediate_retries_from_chat": true,
    "record_all_attempts_in_ci_logs": true,
    "fail_closed_on": [
      "approval_missing",
      "billing_unknown",
      "uncertain_write_ack",
      "permission_denied",
      "security_test_failure",
      "schema_incompatible",
      "external_production_dependency"
    ],
    "retries_never_disable_tests": true
  },
  "dependencies": {
    "independent_tasks_never_wait_for_unrelated_features": true,
    "verify_main_draft_prs_and_handoff_artifacts": true,
    "blocked_record_fields": [
      "exact_dependency_id",
      "owner",
      "required_output",
      "acceptance"
    ],
    "after_verified_main_ci_recheck": true,
    "schedule_backup_minutes": 60
  },
  "reporting": {
    "only_statuses": [
      "DONE",
      "IN PROGRESS",
      "FAILED",
      "BLOCKED"
    ],
    "max_short_lines_per_feature": 4,
    "include_verified_done_over_total": true,
    "no_intermediate_retry_messages": true,
    "only_explain_when_failed_blocked_or_user_requests_more": true
  },
  "safety": {
    "automatically_enable_paid_gpu": false,
    "automatically_deploy_prod": false,
    "modify_WineShopPOS": false,
    "bypass_protected_approval": false,
    "launch_paid_AI_coding_agent_without_explicit_approval": false
  },
  "coordination": {
    "shared_ci_issue_650": "coordinator",
    "azure_http_issue_249": "coordinator",
    "finish_independent_source_despite_external_ci_blocker": true,
    "never_merge_failing_required_ci": true,
    "do_not_promote_ledger_snapshot_to_verified_task_state_without_evidence": true
  },
  "scheduler": {
    "mode": "advisory_until_authorized_executor_connected",
    "cron": "17 * * * *",
    "maximum_parallel_candidate_slots": 10,
    "worktree_per_claim": true,
    "require_atomic_claim_before_execution": true,
    "retry_rounds": 2,
    "initial_attempts_per_task": 3,
    "deferred_attempts_per_task": 2,
    "max_total_attempts_per_task": 5,
    "first_round_retries_before_other_new_work": true,
    "second_round_begins_after_first_round_eligible_queue_exhausted": true,
    "after_second_round_failure": "terminal_failed_for_human_triage",
    "failure_repair": "coding agent must diagnose cause, propose actual safe code fix, run targeted tests, then retry; never re-run identical known-broken code endlessly",
    "allowed_retry_classes": [
      "transient_network",
      "runner_infrastructure",
      "fixable_build_or_test"
    ],
    "forbidden_retry_classes": [
      "unknown_billing_ack",
      "paid_provider_submission",
      "non_idempotent_write",
      "approval_missing",
      "tenant_security_denial",
      "license_denied",
      "unknown_classification"
    ],
    "event_receipts": "coordination/scheduler_events.json",
    "source_task_ids": "coordination/feature_tasks.json",
    "source_snapshot_not_authority_for_integrated_completion": true
  },
  "feature_owned_integration": {
    "effective_date": "2026-10-31",
    "scheduler_slots": [
      "2",
      "3",
      "4",
      "5",
      "7"
    ],
    "dedicated_chat_coordinator": false,
    "feature_leads_may_self_merge_eligible_main_targeted_prs": true,
    "gate_checklist": [
      "reverify_latest_main_and_exact_pr_head",
      "pr_targets_main_and_is_non_draft",
      "no_conflicts_or_unknown_write_path",
      "all_four_required_exact_head_pr_ci_pass",
      "required_independent_review_for_sensitive_or_shared_paths",
      "satisfy_existing_github_branch_protection",
      "merge_with_expected_head_sha",
      "verify_fresh_main_four_job_ci_on_merge_sha",
      "reviewed_append_only_progress_receipt"
    ],
    "shared_contract_change_requires_independent_review": true,
    "immutable_159_task_snapshot": true,
    "only_append_reviewed_progress_events": true,
    "paid_gpu_off": true,
    "do_not_bypass_existing_reviews": true,
    "github_ruleset_protection_not_confirmed": true
  }
}
